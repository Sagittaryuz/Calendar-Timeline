function drawSunBurst(
  ctx,
  centerX,
  centerY,
  radius,
  coreColor = "#FFDE00",
  rayColor = "#FF8A00"
) {
  // Coroa laranja contínua, com 12 pontas largas, seguindo a referência.
  const rays = 12;
  const step = (Math.PI * 2) / rays;
  const outerRadius = radius * 1.72;
  const shoulderRadius = radius * 1.42;
  const valleyRadius = radius * 1.06;
  const points = [];

  for (let index = 0; index < rays; index++) {
    const angle = -Math.PI / 2 + index * step;
    points.push(
      new Point(
        centerX + Math.cos(angle - step * 0.50) * valleyRadius,
        centerY + Math.sin(angle - step * 0.50) * valleyRadius
      ),
      new Point(
        centerX + Math.cos(angle - step * 0.28) * shoulderRadius,
        centerY + Math.sin(angle - step * 0.28) * shoulderRadius
      ),
      new Point(
        centerX + Math.cos(angle) * outerRadius,
        centerY + Math.sin(angle) * outerRadius
      ),
      new Point(
        centerX + Math.cos(angle + step * 0.28) * shoulderRadius,
        centerY + Math.sin(angle + step * 0.28) * shoulderRadius
      ),
      new Point(
        centerX + Math.cos(angle + step * 0.50) * valleyRadius,
        centerY + Math.sin(angle + step * 0.50) * valleyRadius
      )
    );
  }

  const path = new Path();
  path.move(points[0]);
  for (const point of points.slice(1)) {
    path.addLine(point);
  }
  path.addLine(points[0]);

  ctx.setFillColor(new Color(rayColor, weatherElementOpacity(1.0)));
  ctx.addPath(path);
  ctx.fillPath();

  ctx.setFillColor(new Color(coreColor, weatherElementOpacity(1.0)));
  ctx.fillEllipse(
    new Rect(
      centerX - radius,
      centerY - radius,
      radius * 2,
      radius * 2
    )
  );
}

