function roundedRectContainsPoint(rect, radius, x, y) {
  const left = rect.x;
  const right = rect.x + rect.width;
  const top = rect.y;
  const bottom = rect.y + rect.height;
  if (
    x < left ||
    x > right ||
    y < top ||
    y > bottom
  ) {
    return false;
  }

  const boundedRadius = Math.max(
    0,
    Math.min(
      Number(radius) || 0,
      rect.width / 2,
      rect.height / 2
    )
  );
  if (boundedRadius <= 0) return true;

  if (
    x >= left + boundedRadius &&
    x <= right - boundedRadius
  ) {
    return true;
  }
  if (
    y >= top + boundedRadius &&
    y <= bottom - boundedRadius
  ) {
    return true;
  }

  const cornerCenterX =
    x < left + boundedRadius
      ? left + boundedRadius
      : right - boundedRadius;
  const cornerCenterY =
    y < top + boundedRadius
      ? top + boundedRadius
      : bottom - boundedRadius;
  return (
    Math.hypot(
      x - cornerCenterX,
      y - cornerCenterY
    ) <= boundedRadius
  );
}

function timelineMoonPointIsVisible(x, y) {
  const inset = widgetContourInsetAtY(y, WIDGET_CONTOUR.strokeInset);
  return y >= 0 && y <= CANVAS.height &&
    x >= inset && x <= CANVAS.width - inset;
}

function drawClippedDayBoundaryMoonBorder(
  ctx,
  centerX,
  centerY,
  size,
  borderDate
) {
  const isDayBoundary =
    borderDate instanceof Date &&
    borderDate.getHours() === 0 &&
    borderDate.getMinutes() === 0;
  if (!isDayBoundary) return;

  const lineWidth = dayBoundaryLineWidth();
  const ringRadius = size / 2 + lineWidth / 2;
  const sampleCount = 720;
  const path = new Path();
  let previousVisible = false;
  let hasVisibleSegment = false;

  for (let index = 0; index <= sampleCount; index++) {
    const angle =
      -Math.PI / 2 +
      (index * Math.PI * 2) / sampleCount;
    const point = new Point(
      centerX + Math.cos(angle) * ringRadius,
      centerY + Math.sin(angle) * ringRadius
    );
    const visible = timelineMoonPointIsVisible(
      point.x,
      point.y
    );

    if (visible) {
      if (previousVisible) path.addLine(point);
      else path.move(point);
      hasVisibleSegment = true;
    }
    previousVisible = visible;
  }

  if (!hasVisibleSegment) return;

  ctx.setStrokeColor(
    dayBoundaryLineColor(
      borderDate,
      loadResult.holidayDates
    )
  );
  ctx.setLineWidth(lineWidth);
  ctx.addPath(path);
  ctx.strokePath();
}

