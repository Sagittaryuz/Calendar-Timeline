function drawFivePointStar(ctx, centerX, centerY, outerRadius, color) {
  const path = new Path();
  const innerRadius = outerRadius * 0.42;

  for (let index = 0; index < 10; index++) {
    const radius = index % 2 === 0 ? outerRadius : innerRadius;
    const angle = -Math.PI / 2 + (index * Math.PI) / 5;
    const point = new Point(
      centerX + Math.cos(angle) * radius,
      centerY + Math.sin(angle) * radius
    );
    if (index === 0) path.move(point);
    else path.addLine(point);
  }

  path.closeSubpath();
  ctx.addPath(path);
  ctx.setFillColor(color);
  ctx.fillPath();
}

function moonPhaseForDate(date) {
  const synodicMonth = 29.530588853;
  const knownNewMoon = Date.UTC(2000, 0, 6, 18, 14, 0);
  const elapsedDays =
    (date.getTime() - knownNewMoon) / 86400000;
  const fraction =
    ((elapsedDays / synodicMonth) % 1 + 1) % 1;

  if (fraction < 0.0625 || fraction >= 0.9375) {
    return {
      phase: "new",
      name: "LUA NOVA",
      illumination: 0,
    };
  }
  if (fraction < 0.1875) {
    return {
      phase: "waxing-crescent",
      name: "LUA CRESCENTE",
      illumination: 0.25,
    };
  }
  if (fraction < 0.3125) {
    return {
      phase: "first-quarter",
      name: "QUARTO CRESCENTE",
      illumination: 0.5,
    };
  }
  if (fraction < 0.4375) {
    return {
      phase: "waxing-gibbous",
      name: "LUA GIBOSA CRESCENTE",
      illumination: 0.75,
    };
  }
  if (fraction < 0.5625) {
    return {
      phase: "full",
      name: "LUA CHEIA",
      illumination: 1,
    };
  }
  if (fraction < 0.6875) {
    return {
      phase: "waning-gibbous",
      name: "LUA GIBOSA MINGUANTE",
      illumination: 0.75,
    };
  }
  if (fraction < 0.8125) {
    return {
      phase: "last-quarter",
      name: "QUARTO MINGUANTE",
      illumination: 0.5,
    };
  }
  return {
    phase: "waning-crescent",
    name: "LUA MINGUANTE",
    illumination: 0.25,
  };
}

function solarTimeForDate(date, isSunrise) {
  const latitude = astronomy.latitude;
  const longitude = astronomy.longitude;
  const day = dayOfYear(date);
  const longitudeHour = longitude / 15;
  const approximateTime =
    day + ((isSunrise ? 6 : 18) - longitudeHour) / 24;
  const meanAnomaly = 0.9856 * approximateTime - 3.289;
  let trueLongitude =
    meanAnomaly +
    1.916 * sinDegrees(meanAnomaly) +
    0.020 * sinDegrees(2 * meanAnomaly) +
    282.634;
  trueLongitude = normalizeDegrees(trueLongitude);

  let rightAscension = radiansToDegrees(
    Math.atan(0.91764 * Math.tan(degreesToRadians(trueLongitude)))
  );
  rightAscension = normalizeDegrees(rightAscension);
  rightAscension +=
    Math.floor(trueLongitude / 90) * 90 -
    Math.floor(rightAscension / 90) * 90;
  rightAscension /= 15;

  const sinDeclination = 0.39782 * sinDegrees(trueLongitude);
  const cosDeclination = Math.cos(Math.asin(sinDeclination));
  const zenith = 90.833;
  const cosHourAngle =
    (Math.cos(degreesToRadians(zenith)) -
      sinDeclination * sinDegrees(latitude)) /
    (cosDeclination * Math.cos(degreesToRadians(latitude)));

  if (cosHourAngle > 1 || cosHourAngle < -1) return null;

  let hourAngle = radiansToDegrees(Math.acos(cosHourAngle));
  if (isSunrise) hourAngle = 360 - hourAngle;
  hourAngle /= 15;

  const localMeanTime =
    hourAngle + rightAscension - 0.06571 * approximateTime - 6.622;
  const universalTime = normalizeHours(localMeanTime - longitudeHour);
  return new Date(
    Date.UTC(date.getFullYear(), date.getMonth(), date.getDate()) +
      universalTime * 60 * 60 * 1000
  );
}

function dayOfYear(date) {
  const currentUTC = Date.UTC(
    date.getFullYear(),
    date.getMonth(),
    date.getDate()
  );
  const yearStartUTC = Date.UTC(date.getFullYear(), 0, 0);
  return Math.floor((currentUTC - yearStartUTC) / 86400000);
}

function degreesToRadians(value) {
  return (value * Math.PI) / 180;
}

function radiansToDegrees(value) {
  return (value * 180) / Math.PI;
}

function sinDegrees(value) {
  return Math.sin(degreesToRadians(value));
}

function normalizeDegrees(value) {
  return ((value % 360) + 360) % 360;
}

function normalizeHours(value) {
  return ((value % 24) + 24) % 24;
}

function drawEventHourHighlights(ctx, items) {
  const events = prioritizedEvents(items);

  // Desenha a prioridade menor primeiro. Assim, quando houver sobreposição,
  // o evento prioritário permanece visível por cima: dia inteiro primeiro;
  // entre os demais, prevalece o que começar antes.
  for (const event of [...events].reverse()) {
    const horizontalPadding = 25;
    const startX = Math.max(
      0,
      timeToX(event.start) - horizontalPadding
    );
    const endX = Math.min(
      timelineWidth(),
      timeToX(event.end) + horizontalPadding
    );
    const width = endX - startX;
    if (width <= 0) continue;

    // Mesmo formato do badge do dia da semana: retângulo de cantos retos,
    // na mesma posição e com a mesma altura.
    ctx.setFillColor(new Color(event.color, 0.90));
    ctx.fillRect(new Rect(startX, 3, Math.max(2, width), 34));
  }
}

function prioritizedEvents(items) {
  return items
    .filter(
      (item) =>
        item.kind === "event" &&
        !item.isAllDay &&
        item.end > windowStart &&
        item.start < windowEnd
    )
    .sort(
      (a, b) =>
        a.start.getTime() - b.start.getTime() ||
        a.end.getTime() - b.end.getTime()
    );
}

function eventAtTime(date, items) {
  const labelX = timeToX(date);
  const horizontalPadding = 25;
  return prioritizedEvents(items).find((event) => {
    const eventStartX = timeToX(event.start) - horizontalPadding;
    const eventEndX = timeToX(event.end) + horizontalPadding;
    return labelX >= eventStartX && labelX <= eventEndX;
  });
}

function hourTicks() {
  const ticks = [];
  const showEveryHour = windowHours <= 24;
  let tick = floorToHour(windowStart);

  if (!showEveryHour && tick.getHours() % 2 !== 0) {
    tick.setHours(tick.getHours() + 1);
  }

  const finalTick = ceilToHour(windowEnd);
  const compactEventHours = compactEventHourMarkers();

  while (tick <= finalTick) {
    const hour = tick.getHours();
    const isEvenHour = hour % 2 === 0;
    const isCompactAnchor = [0, 6, 12, 18].includes(hour);
    const isEventHour =
      isEvenHour && compactEventHours.has(tick.getTime());

    if (
      showEveryHour ||
      (isEvenHour &&
        (!isCompactMode() || isCompactAnchor || isEventHour))
    ) {
      ticks.push(new Date(tick));
    }

    tick = new Date(tick.getTime() + 60 * 60 * 1000);
  }

  return ticks;
}

function compactEventHourMarkers() {
  const markers = new Set();
  markers.add(floorToHour(windowStart).getTime());

  for (const item of loadResult.items ?? []) {
    if (
      item.kind !== "event" ||
      item.isAllDay ||
      !item.start ||
      !item.end
    ) {
      continue;
    }

    const boundaries = [item.start, item.end];
    for (const boundary of boundaries) {
      const marker = floorToHour(boundary);
      if (
        marker.getTime() >= windowStart.getTime() - 60 * 60 * 1000 &&
        marker.getTime() <= windowEnd.getTime()
      ) {
        markers.add(marker.getTime());
      }
    }
  }

  return markers;
}

function hourGridLineColor(tick) {
  return tick.getHours() === 0
    ? dayBoundaryLineColor(tick, loadResult.holidayDates)
    : new Color("#3A3A3C", 1.0);
}

function daylightHourColor(tick) {
  const hour = tick.getHours() + tick.getMinutes() / 60;
  const strength = daylightStrengthAtHour(hour);
  const edgeStrength = 0.28;
  const peakProgress = Math.max(
    0,
    Math.min(1, (strength - edgeStrength) / (1 - edgeStrength))
  );
  return new Color(
    interpolateHexColor(
      SETTINGS.daylightEdgeColor,
      SETTINGS.daylightPeakColor,
      peakProgress
    ),
    1.0
  );
}

function isSecondaryNightLegendHour(hour) {
  return [2, 4, 20, 22].includes(hour);
}

function secondaryNightLegendColor() {
  return new Color(SETTINGS.secondaryTextColor, 1.0);
}

function legendLabelWidth() {
  // No modo de 36–168 horas, a moldura precisa comportar "DOM" inteiro.
  if (isCompactMode()) return 58;
  if (isExtendedDetailedMode()) return 50;
  return 58;
}

function legendFrameHeight() {
  if (isCompactMode()) return 34;
  if (isExtendedDetailedMode()) return 32;
  return 38;
}

function legendTextHeight() {
  if (isCompactMode()) return 29;
  if (isExtendedDetailedMode()) return 28;
  return 31;
}

function topLegendCenterY() {
  // Preserva o eixo vertical anterior enquanto a moldura cresce igualmente
  // para cima e para baixo.
  if (isCompactMode()) return 18;
  if (isExtendedDetailedMode()) return 17;
  return 20;
}

function centeredLegendTextRect(centerX, centerY) {
  const width = legendLabelWidth();
  const height = legendTextHeight();
  return new Rect(
    centerX - width / 2,
    centerY - height / 2,
    width,
    height
  );
}

// Os badges de mudança de dia são mais largos que os rótulos numéricos.
// Isso garante as três letras completas inclusive na janela de 36 horas.
function dayLegendLabelWidth() {
  return 64;
}

function centeredDayLegendTextRect(centerX, centerY) {
  const width = dayLegendLabelWidth();
  const height = legendTextHeight();
  return new Rect(
    centerX - width / 2,
    centerY - height / 2,
    width,
    height
  );
}

function legendBadgeRect(centerX, centerY) {
  const width = legendLabelWidth();
  const height = legendFrameHeight();
  return new Rect(
    centerX - width / 2,
    centerY - height / 2,
    width,
    height
  );
}

function dayLegendBadgeRect(centerX, centerY) {
  const width = dayLegendLabelWidth();
  const height = legendFrameHeight();
  return new Rect(
    centerX - width / 2,
    centerY - height / 2,
    width,
    height
  );
}

function hourLabelMetrics(ticks) {
  const extended = isExtendedDetailedMode();
  const frameHeight = legendFrameHeight();
  const lineWidth = extended ? 1 : 2;
  const gapWidth = extended ? 3 : 6;
  const tickXs = ticks.map((tick) => timeToX(tick));
  const tickSpacing = tickXs.length > 1
    ? Math.min(
        ...tickXs
          .slice(1)
          .map((x, index) => Math.abs(x - tickXs[index]))
      )
    : legendLabelWidth();
  // A moldura não encolhe abaixo do necessário para "12h", "23º" ou "DOM".
  const frameWidth = legendLabelWidth();

  return {
    frameHeight,
    frameWidth,
    lineWidth,
    gapWidth,
    tickXs,
  };
}

function drawHourLabelFrames(ctx, ticks) {
  const metrics = hourLabelMetrics(ticks);
  const frameHeight = metrics.frameHeight;
  const frameWidth = metrics.frameWidth;
  const lineWidth = metrics.lineWidth;
  const gapWidth = metrics.gapWidth;
  const visibleTickXs = metrics.tickXs;

  // Somente o pequeno intervalo entre duas horas fica vazado. O interior
  // de cada retângulo preserva o destaque colorido do evento, quando houver.
  for (let index = 0; index < ticks.length - 1; index++) {
    const gapCenterX =
      (visibleTickXs[index] + visibleTickXs[index + 1]) / 2;
    const gapDate = new Date(
      (ticks[index].getTime() + ticks[index + 1].getTime()) / 2
    );
    ctx.setFillColor(new Color(timelineBackgroundColorForDate(gapDate)));
    ctx.fillRect(
      new Rect(
        gapCenterX - gapWidth / 2,
        3,
        gapWidth,
        frameHeight
      )
    );
  }

  for (const tick of ticks) {
    // O badge de meia-noite permanece exatamente como antes.
    if (tick.getHours() === 0) continue;

    const centerX = timeToX(tick);
    const leftX = centerX - frameWidth / 2;
    const rightX = centerX + frameWidth / 2 - lineWidth;
    const topY = 3;
    const bottomY = topY + frameHeight - lineWidth;

    ctx.setFillColor(hourGridLineColor(tick));
    ctx.fillRect(new Rect(leftX, topY, lineWidth, frameHeight));
    ctx.fillRect(new Rect(rightX, topY, lineWidth, frameHeight));
    ctx.fillRect(new Rect(leftX, topY, frameWidth, lineWidth));
    ctx.fillRect(new Rect(leftX, bottomY, frameWidth, lineWidth));
  }
}

function drawEventStartLines(ctx, items) {
  const events = prioritizedEvents(items);
  const lineWidth = 2;
  const curveBottom = thermalBandBottomY();

  // Cada linha nasce atrás da curva térmica e sobe somente até o chart
  // correspondente. Como esta camada é desenhada antes da curva e dos
  // charts, a origem inferior fica naturalmente encoberta.
  for (const event of [...events].reverse()) {
    const x = timeToX(event.start);
    if (x < 0 || x > timelineWidth()) continue;

    const bar = timelineBarVerticalRect(event);
    if (!bar) continue;

    const lineTop = Math.min(curveBottom, bar.bottom);
    const lineHeight = Math.max(1, curveBottom - lineTop);

    ctx.setFillColor(new Color(event.color, 1.0));
    ctx.fillRect(
      new Rect(
        x - lineWidth / 2,
        lineTop,
        lineWidth,
        lineHeight
      )
    );
  }
}


function drawHourAxis(ctx, items) {
  const ticks = hourTicks();
  const gridTop = solarLineY();
  const gridBottom = thermalBandBottomY();

  for (const tick of ticks) {
    const x = timeToX(tick);
    const hour = tick.getHours();
    const isMidnight = hour === 0;
    const isNoon = hour === 12;

    ctx.setStrokeColor(hourGridLineColor(tick));
    ctx.setLineWidth(isMidnight ? 8 : isNoon ? 2 : 1);
    ctx.strokeRect(
      new Rect(
        x,
        gridTop,
        1,
        Math.max(1, gridBottom - gridTop)
      )
    );
  }

  // As linhas de início permanecem coloridas e atrás dos charts.
  drawEventStartLines(ctx, items);
}

function drawTimelineItem(ctx, item, y, rowHeight) {
  const centerY = y + rowHeight / 2;
  const color = new Color(item.color);
  const barHeight = timelineBarHeight(item);
  const barY = centerY - barHeight / 2;

  if (item.isOverflow) {
    const markerWidth = 62;
    const markerX = Math.max(
      0,
      Math.min(timelineWidth() - markerWidth, timeToX(item.start))
    );

    fillRoundedRect(
      ctx,
      new Rect(markerX, barY, markerWidth, barHeight),
      5,
      color
    );

    ctx.setTextAlignedCenter();
    ctx.setFont(
      Font.blackRoundedSystemFont(isCompactMode() ? 20 : 23)
    );
    ctx.setTextColor(Color.white());
    ctx.drawTextInRect(
      item.title,
      new Rect(markerX, barY + 3, markerWidth, barHeight - 3)
    );
    return;
  }

  const originalX = timeToX(item.start);
  const x =
    item.kind === "reminder"
      ? Math.max(0, originalX)
      : originalX;
  const exactWidth = Math.max(1, timeToX(item.end) - x);
  const minimumWidth =
    item.kind === "event"
      ? isCompactMode()
        ? SETTINGS.compactMinimumChartWidth
        : SETTINGS.minimumChartWidth
      : 1;
  const width = Math.max(exactWidth, minimumWidth);

  const barRect = new Rect(x, barY, width, barHeight);
  drawTimelineBar(ctx, barRect, color, item);

  const priorityPrefix = reminderPriorityPrefix(item);
  const title = priorityPrefix + item.title.toLocaleUpperCase("pt-BR");
  const visibleLeft = Math.max(0, x);
  const visibleRight = Math.min(timelineWidth(), x + width);
  const statusText = timelineItemStatus(item);
  const metadataText = eventMetadataText(item);
  const titleFontSize = isCompactMode()
    ? 19
    : windowHours > 24
      ? 23
      : 26;
  const statusFontSize = isCompactMode() ? 12 : 15;
  const metadataFontSize = isCompactMode() ? 11 : 15;
  const visibleBarWidth = Math.max(0, visibleRight - visibleLeft);
  const statusMinimumWidth =
    item.conflictCount > 0 &&
    !item.isCurrentEvent &&
    !item.isNextEvent
      ? 46
      : isCompactMode()
        ? 108
        : 160;
  const statusWidth =
    statusText && visibleBarWidth >= statusMinimumWidth
      ? Math.min(
          visibleBarWidth * (item.conflictCount > 0 ? 0.40 : 0.45),
          estimatedTextWidth(statusText, statusFontSize) + 18
        )
      : 0;
  const metadataWidth =
    metadataText && !isCompactMode() && visibleBarWidth - statusWidth >= 98
      ? Math.min(
          visibleBarWidth * 0.30,
          estimatedTextWidth(metadataText, metadataFontSize) + 16
        )
      : 0;
  const visibleTitle = title;
  if (!visibleTitle && statusWidth === 0) return;

  const titleTextY =
    barY + Math.max(0, (barHeight - titleFontSize) / 2 - 2);
  const textPoint = new Point(visibleLeft + 7, titleTextY);

  if (visibleTitle) {
    ctx.setTextAlignedLeft();
    ctx.setFont(Font.blackRoundedSystemFont(titleFontSize));
    ctx.setTextColor(new Color("#000000", 0.85));
    ctx.drawText(
      visibleTitle,
      new Point(textPoint.x + 2, textPoint.y + 2)
    );
    ctx.setTextColor(Color.white());
    ctx.drawText(visibleTitle, textPoint);

    if (priorityPrefix && visibleTitle.startsWith(priorityPrefix.trim())) {
      ctx.setTextColor(new Color("#FF453A"));
      ctx.drawText(priorityPrefix.trim(), textPoint);
    }
  }

  if (statusWidth > 0) {
    ctx.setTextAlignedCenter();
    ctx.setFont(Font.blackRoundedSystemFont(statusFontSize));
    ctx.setTextColor(Color.white());
    ctx.drawTextInRect(
      statusText,
      new Rect(
        visibleRight - statusWidth,
        barY + 6,
        statusWidth,
        barHeight - 6
      )
    );
  }

  if (metadataWidth > 0) {
    ctx.setTextAlignedCenter();
    ctx.setFont(Font.blackRoundedSystemFont(metadataFontSize));
    ctx.setTextColor(new Color("#FF453A"));
    ctx.drawTextInRect(
      metadataText,
      new Rect(
        visibleRight - statusWidth - metadataWidth,
        barY + 6,
        metadataWidth,
        barHeight - 6
      )
    );
  }
}

function drawTimelineBar(ctx, rect, color, item) {
  let accent = null;
  if (item.isOverdue) accent = new Color(SETTINGS.overdueReminderColor);
  else if (item.isCurrentEvent) accent = new Color(SETTINGS.currentEventColor);
  else if (item.isNextEvent) accent = new Color(SETTINGS.nextEventColor);
  else if (item.conflictCount > 0) accent = new Color(SETTINGS.conflictColor);
  else if (item.kind === "reminder" && item.priority > 0) {
    accent = new Color(SETTINGS.priorityReminderColor);
  }

  if (!accent || rect.width < 8 || rect.height < 8) {
    fillRoundedRect(ctx, rect, 6, color);
    return;
  }

  const borderWidth = item.isCurrentEvent ? 4 : 3;
  fillRoundedRect(ctx, rect, 6, accent);
  fillRoundedRect(
    ctx,
    new Rect(
      rect.x + borderWidth,
      rect.y + borderWidth,
      rect.width - borderWidth * 2,
      rect.height - borderWidth * 2
    ),
    4,
    color
  );
}

function reminderPriorityPrefix(item) {
  if (item.kind !== "reminder") return "";
  if (item.isOverdue || (item.priority > 0 && item.priority <= 4)) return "!! ";
  if (item.priority > 0) return "! ";
  return "";
}

function timelineItemStatus(item) {
  const pieces = [];
  if (item.isCurrentEvent) pieces.push(currentEventCountdown(item.end));
  else if (item.isNextEvent) pieces.push(nextEventCountdown(item.start));
  if (item.conflictCount > 0) pieces.push(`×${item.conflictCount + 1}`);
  return pieces.join("  ");
}

function eventMetadataText(item) {
  if (item.kind !== "event" || !SETTINGS.showEventMetadataIcons) return "";
  const icons = [];
  if (item.location) icons.push("⌖");
  if (item.hasVideoLink) icons.push("▶");
  if (item.attendeeCount > 0) icons.push("◉");
  if (
    item.availability === "tentative" ||
    item.participationStatus === "tentative" ||
    item.participationStatus === "pending"
  ) {
    icons.push("?");
  }
  return icons.join("  ");
}

function currentEventCountdown(end) {
  const minutes = Math.max(
    0,
    Math.ceil((end.getTime() - now.getTime()) / 60000)
  );
  if (minutes < 60) return `AGORA · ${minutes} MIN`;
  const hours = Math.floor(minutes / 60);
  const remainder = minutes % 60;
  return remainder
    ? `AGORA · ${hours}H${remainder}`
    : `AGORA · ${hours}H`;
}

function nextEventCountdown(start) {
  const minutes = Math.max(
    0,
    Math.ceil((start.getTime() - now.getTime()) / 60000)
  );
  if (minutes < 60) return `EM ${minutes} MIN`;
  if (minutes < 24 * 60) {
    const hours = Math.floor(minutes / 60);
    const remainder = minutes % 60;
    return remainder ? `EM ${hours}H${remainder}` : `EM ${hours}H`;
  }
  const days = Math.floor(minutes / (24 * 60));
  const hours = Math.floor((minutes % (24 * 60)) / 60);
  return hours ? `EM ${days}D ${hours}H` : `EM ${days}D`;
}

function truncateTitle(title, maximumWidth, fontSize) {
  if (maximumWidth <= 0) return "";
  if (estimatedTextWidth(title, fontSize) <= maximumWidth) return title;

  const ellipsis = "…";
  if (estimatedTextWidth(ellipsis, fontSize) > maximumWidth) return "";

  let result = "";
  for (const character of title) {
    const candidate = result + character + ellipsis;
    if (estimatedTextWidth(candidate, fontSize) > maximumWidth) break;
    result += character;
  }
  return result.trimEnd() + ellipsis;
}

function estimatedTextWidth(text, fontSize) {
  let units = 0;
  for (const character of text) {
    if (/[MW@%&]/.test(character)) units += 0.86;
    else if (/[I1.,:;!'|]/.test(character)) units += 0.34;
    else if (/\s/.test(character)) units += 0.33;
    else units += 0.62;
  }
  return units * fontSize;
}

function drawPermissionState(ctx) {
  const box = new Rect(
    40,
    90,
    timelineWidth() - 80,
    185
  );
  fillRoundedRect(ctx, box, 24, new Color("#1D1D20"));

  ctx.setTextAlignedCenter();
  ctx.setTextColor(new Color(SETTINGS.primaryTextColor));
  ctx.setFont(Font.boldRoundedSystemFont(29));
