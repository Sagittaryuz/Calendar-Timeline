// Variables used by Scriptable.
// These must be at the very top of the file. Do not edit.
// icon-color: red; icon-glyph: calendar-alt;
//
// AGENDA TIMELINE 4x2
// Calendário + Lembretes do iPhone em uma timeline diária.

const THEME_MODE = "black"; // "black" | "dark"

const SETTINGS = {
  locale: "pt_BR",
  maxItems: 5,
  defaultWindowHours: 24,
  maximumWindowHours: 24,
  refreshSeconds: 60,
  backgroundColor: "#0A0A0B",
  timelineBackgroundColor: "#000000",
  saturdayTimelineBackgroundColor: "#071A2E",
  sundayTimelineBackgroundColor: "#2A0A0D",
  primaryTextColor: "#FFFFFF",
  secondaryTextColor: "#A9A9B0",
  fallbackEventColor: "#0A84FF",
  fallbackReminderColor: "#FF9F0A",
  overflowColor: "#636366",
  // Escreva aqui nomes exatos de agendas/listas que não devem aparecer.
  excludedCalendars: [],
};

const CANVAS = {
  width: 1092,
  height: 510,
  headerHeight: 128, // 25% da altura total
  marginX: 34,
  plotLeft: 34,
  plotRight: 1058,
  timelineTop: 139,
  timelineBottom: 451,
  footerTop: 459,
  footerBottom: 510,
  localPlotTop: 48,
};

const now = new Date();
now.setSeconds(0, 0);
const windowHours = parseWindowHours(args.widgetParameter);
const windowStart = new Date(now);
const windowEnd = new Date(
  windowStart.getTime() + windowHours * 60 * 60 * 1000
);
const refreshRequested = (args.queryParameters ?? {}).refresh === "1";
const loadResult = await loadWindow();
const selectedItems = chooseItems(loadResult.items, now, SETTINGS.maxItems);
const widget = makeWidget(selectedItems, loadResult.error);

const runScriptURL = URLScheme.forRunningScript();
widget.url = addURLParameter(runScriptURL, "refresh", "1");
widget.refreshAfterDate = new Date(
  Date.now() + SETTINGS.refreshSeconds * 1000
);

if (config.runsInWidget) {
  Script.setWidget(widget);
} else {
  if (loadResult.error) {
    await showPermissionHelp(loadResult.error);
  }

  if (refreshRequested) {
    // Recalcula o widget antes de abrir o Calendário.
    Script.setWidget(widget);
    Safari.open(calendarURL(now));
  } else {
    await widget.presentMedium();
  }
}

Script.complete();

async function loadWindow() {
  try {
    // No primeiro uso dentro do app, estas consultas exibem os pedidos
    // nativos de acesso ao Calendário e aos Lembretes.
    const reminderQueryEnd = addDays(startOfDay(windowEnd), 1);
    const [events, reminders, todayEventsRaw, todayRemindersRaw] =
      await Promise.all([
        CalendarEvent.between(windowStart, windowEnd),
        Reminder.incompleteDueBetween(startOfToday(), reminderQueryEnd),
        CalendarEvent.today(),
        Reminder.incompleteDueToday(),
      ]);

    const excluded = new Set(
      SETTINGS.excludedCalendars.map((name) => name.toLocaleLowerCase())
    );

    const includeCalendar = (calendar) => {
      const calendarName = calendar?.title ?? "";
      return !excluded.has(calendarName.toLocaleLowerCase());
    };

    const todayEvents = todayEventsRaw.filter((event) =>
      includeCalendar(event.calendar)
    );
    const todayReminders = todayRemindersRaw.filter((reminder) =>
      includeCalendar(reminder.calendar)
    );

    const eventItems = events
      .filter((event) => {
        return includeCalendar(event.calendar);
      })
      .map((event) => ({
        kind: "event",
        title: cleanTitle(event.title, "Evento"),
        calendarTitle: event.calendar?.title ?? "Calendário",
        start: event.startDate,
        end: event.endDate,
        isAllDay: Boolean(event.isAllDay),
        color: safeCalendarColor(
          event.calendar,
          SETTINGS.fallbackEventColor
        ),
      }));

    const reminderItems = reminders
      .filter((reminder) => {
        const due = reminder.dueDate;
        if (!due || !includeCalendar(reminder.calendar)) return false;
        const dayStart = startOfDay(due);
        const dayEnd = addDays(dayStart, 1);
        return dayEnd > windowStart && dayStart < windowEnd;
      })
      .map((reminder) => {
        const due = reminder.dueDate ?? startOfToday();
        const hasTime = Boolean(reminder.dueDateIncludesTime);
        const reminderDayStart = startOfDay(due);
        return {
          kind: "reminder",
          title: cleanTitle(reminder.title, "Lembrete"),
          calendarTitle: reminder.calendar?.title ?? "Lembretes",
          start: hasTime ? due : reminderDayStart,
          end: addDays(reminderDayStart, 1),
          isAllDay: !hasTime,
          color: safeCalendarColor(
            reminder.calendar,
            SETTINGS.fallbackReminderColor
          ),
        };
      });

    const holidayDates = new Set(
      [...events, ...todayEvents]
        .filter(isHolidayEvent)
        .map((event) => dateKey(event.startDate))
    );

    return {
      items: [...eventItems, ...reminderItems],
      todayEventCount: todayEvents.length,
      todayReminderCount: todayReminders.length,
      holidayDates,
      error: null,
    };
  } catch (error) {
    return {
      items: [],
      todayEventCount: 0,
      todayReminderCount: 0,
      holidayDates: new Set(),
      error: String(error),
    };
  }
}

function chooseItems(items, referenceDate, limit) {
  const relevant = [...items].filter(
    (item) => item.isAllDay || item.end >= referenceDate
  );

  const byTime = (a, b) =>
    a.start.getTime() - b.start.getTime() ||
    a.end.getTime() - b.end.getTime();
  const events = relevant
    .filter((item) => item.kind === "event")
    .sort(byTime);
  const reminders = relevant
    .filter((item) => item.kind === "reminder")
    .sort(byTime);

  // Cada linha pode receber quantos itens forem necessários, desde que seus
  // intervalos não se sobreponham. Eventos procuram de cima para baixo;
  // lembretes procuram de baixo para cima.
  const rows = Array.from({ length: limit }, () => []);
  const placed = [];
  const hidden = [];

  const placeItem = (item, rowOrder) => {
    const availableRow = rowOrder.find((row) =>
      rows[row].every((existing) => !itemsOverlap(item, existing))
    );

    if (availableRow === undefined) {
      hidden.push(item);
      return;
    }

    const positioned = { ...item, gridRow: availableRow };
    rows[availableRow].push(positioned);
    placed.push(positioned);
  };

  const topDownRows = Array.from({ length: limit }, (_, index) => index);
  const bottomUpRows = [...topDownRows].reverse();

  events.forEach((item) => placeItem(item, topDownRows));
  reminders.forEach((item) => placeItem(item, bottomUpRows));

  // Excedentes realmente coincidentes são agrupados em um único +N.
  // O indicador permanece na quinta linha, como limite visual do widget.
  const overflowMarkers = groupOverflowItems(hidden).map((group) => ({
    kind: "overflow",
    title: `+${group.count}`,
    start: group.start,
    end: group.end,
    gridRow: limit - 1,
    isOverflow: true,
    color: SETTINGS.overflowColor,
  }));

  return [...placed, ...overflowMarkers];
}

function itemsOverlap(first, second) {
  const firstStart = first.start.getTime();
  const secondStart = second.start.getTime();
  const firstEnd = effectiveItemEnd(first);
  const secondEnd = effectiveItemEnd(second);

  // Um item que começa exatamente quando o outro termina pode reutilizar
  // a mesma linha.
  return firstStart < secondEnd && secondStart < firstEnd;
}

function effectiveItemEnd(item) {
  const start = item.start.getTime();
  const end = item.end.getTime();
  return Math.max(end, start + 60 * 1000);
}

function groupOverflowItems(items) {
  const sorted = [...items].sort(
    (a, b) => a.start.getTime() - b.start.getTime()
  );
  const groups = [];

  for (const item of sorted) {
    const start = item.start.getTime();
    const end = effectiveItemEnd(item);
    const current = groups[groups.length - 1];

    if (current && start < current.end.getTime()) {
      current.end = new Date(
        Math.max(current.end.getTime(), end)
      );
      current.count++;
    } else {
      groups.push({
        start: new Date(start),
        end: new Date(end),
        count: 1,
      });
    }
  }

  return groups;
}

function makeWidget(items, loadError) {
  const widget = new ListWidget();
  widget.setPadding(0, 0, 0, 0);
  widget.backgroundColor = new Color(SETTINGS.backgroundColor);
  widget.backgroundImage = renderWidget(items, loadError);
  return widget;
}

function renderWidget(items, loadError) {
  const ctx = new DrawContext();
  ctx.size = new Size(CANVAS.width, CANVAS.height);
  ctx.opaque = true;
  ctx.respectScreenScale = false;

  // O fundo é desenhado na própria imagem. Isso evita que o Scriptable
  // substitua os textos e charts ao combinar backgroundGradient/backgroundImage.
  drawIOSDarkGradient(ctx);

  // A timeline muda sutilmente conforme o dia atual.
  ctx.setFillColor(new Color(timelineBackgroundColorForDate(now)));
  ctx.fillRect(
    new Rect(
      CANVAS.plotLeft,
      CANVAS.timelineTop,
      timelineWidth(),
      timelineHeight()
    )
  );

  drawDatePanel(ctx, loadResult.holidayDates);
  const timelineImage = renderTimelinePanel(items, loadError);
  ctx.drawImageInRect(
    timelineImage,
    new Rect(
      CANVAS.plotLeft,
      CANVAS.timelineTop,
      timelineWidth(),
      timelineHeight()
    )
  );
  drawFooter(
    ctx,
    loadResult.todayEventCount,
    loadResult.todayReminderCount
  );

  return ctx.getImage();
}

function timelineBackgroundColorForDate(date) {
  if (date.getDay() === 6) {
    return SETTINGS.saturdayTimelineBackgroundColor;
  }
  if (date.getDay() === 0) {
    return SETTINGS.sundayTimelineBackgroundColor;
  }
  return SETTINGS.timelineBackgroundColor;
}

function drawIOSDarkGradient(ctx) {
  const locations =
    THEME_MODE === "black"
      ? [0.0, 0.2, 1.0]
      : [0.0, 0.5, 1.0];
  const colors =
    THEME_MODE === "black"
      ? ["#1C1C1C", "#161616", "#000000"]
      : ["#383838", "#212121", "#181818"];

  for (let y = 0; y < CANVAS.height; y++) {
    const position = y / Math.max(1, CANVAS.height - 1);
    let segment = 0;

    while (
      segment < locations.length - 2 &&
      position > locations[segment + 1]
    ) {
      segment++;
    }

    const start = locations[segment];
    const end = locations[segment + 1];
    const progress = Math.max(
      0,
      Math.min(1, (position - start) / Math.max(0.0001, end - start))
    );

    ctx.setFillColor(
      new Color(interpolateHexColor(colors[segment], colors[segment + 1], progress))
    );
    ctx.fillRect(new Rect(0, y, CANVAS.width, 1));
  }
}

function interpolateHexColor(startHex, endHex, progress) {
  const start = hexToRGB(startHex);
  const end = hexToRGB(endHex);
  const channel = (from, to) =>
    Math.round(from + (to - from) * progress)
      .toString(16)
      .padStart(2, "0");

  return (
    "#" +
    channel(start.r, end.r) +
    channel(start.g, end.g) +
    channel(start.b, end.b)
  );
}

function hexToRGB(hex) {
  const value = hex.replace("#", "");
  return {
    r: parseInt(value.slice(0, 2), 16),
    g: parseInt(value.slice(2, 4), 16),
    b: parseInt(value.slice(4, 6), 16),
  };
}

function drawDatePanel(ctx, holidayDates) {
  const weekday = formatDate(now, "EEEE").toLocaleLowerCase("pt-BR");
  const dateText = formatDate(now, ", d 'de' MMMM").toLocaleLowerCase("pt-BR");
  const fullDate = `${weekday}${dateText}`;
  const maximumFontSize = 60;
  const fontSize = Math.min(
    maximumFontSize,
    (CANVAS.width - CANVAS.marginX * 2) / (fullDate.length * 0.66)
  );
  const characterWidth = fontSize * 0.61;
  const totalWidth = fullDate.length * characterWidth;
  const weekdayWidth = weekday.length * characterWidth;
  const startX = (CANVAS.width - totalWidth) / 2;
  const weekdayColor = titleWeekdayColor(now, holidayDates);

  ctx.setStrokeColor(new Color("#242428"));
  ctx.setLineWidth(3);
  ctx.strokeRect(
    new Rect(
      CANVAS.marginX,
      CANVAS.headerHeight - 3,
      CANVAS.width - CANVAS.marginX * 2,
      1
    )
  );

  ctx.setTextAlignedCenter();
  ctx.setFont(Font.blackMonospacedSystemFont(fontSize));

  ctx.setTextAlignedLeft();
  ctx.setTextColor(weekdayColor);
  ctx.drawText(weekday, new Point(startX, 34));

  ctx.setTextColor(new Color(SETTINGS.primaryTextColor));
  ctx.drawText(dateText, new Point(startX + weekdayWidth, 34));
}

function drawFooter(ctx, eventCount, reminderCount) {
  const centerX = CANVAS.width / 2;
  const footerY = CANVAS.footerTop;

  ctx.setStrokeColor(new Color("#242428"));
  ctx.setLineWidth(2);
  ctx.strokeRect(
    new Rect(CANVAS.marginX, footerY, CANVAS.width - CANVAS.marginX * 2, 1)
  );

  ctx.setFont(Font.blackRoundedSystemFont(25));
  ctx.setTextAlignedCenter();

  ctx.setTextColor(new Color("#FF453A"));
  ctx.drawTextInRect(
    `EVENTOS: ${eventCount}`,
    new Rect(CANVAS.marginX, footerY + 13, centerX - CANVAS.marginX - 28, 31)
  );

  ctx.setTextColor(new Color("#8E8E93"));
  ctx.drawTextInRect(
    "•",
    new Rect(centerX - 18, footerY + 10, 36, 34)
  );

  ctx.setTextColor(new Color("#0A84FF"));
  ctx.drawTextInRect(
    `LEMBRETES: ${reminderCount}`,
    new Rect(
      centerX + 28,
      footerY + 13,
      CANVAS.width - CANVAS.marginX - centerX - 28,
      31
    )
  );
}

function renderTimelinePanel(items, loadError) {
  const ctx = new DrawContext();
  ctx.size = new Size(timelineWidth(), timelineHeight());
  ctx.opaque = false;
  ctx.respectScreenScale = false;

  drawHourAxis(ctx);

  if (loadError) {
    drawPermissionState(ctx);
    return ctx.getImage();
  }

  if (items.length === 0) {
    return ctx.getImage();
  }

  const usableHeight = localPlotBottom() - CANVAS.localPlotTop;
  const rowHeight = usableHeight / SETTINGS.maxItems;

  for (let row = 0; row < SETTINGS.maxItems; row++) {
    const y = CANVAS.localPlotTop + row * rowHeight;
    const rowItems = items
      .filter((candidate) => candidate.gridRow === row)
      .sort(
        (a, b) =>
          Number(a.isOverflow) - Number(b.isOverflow) ||
          a.start.getTime() - b.start.getTime()
      );

    rowItems.forEach((item) =>
      drawTimelineItem(ctx, item, y, rowHeight)
    );
  }

  return ctx.getImage();
}

function drawHourAxis(ctx) {
  let tick = floorToHour(windowStart);
  const finalTick = ceilToHour(windowEnd);

  while (tick <= finalTick) {
    const x = timeToX(tick);
    const hour = tick.getHours();
    const isMidnight = hour === 0;
    const isNoon = hour === 12;

    ctx.setStrokeColor(
      isMidnight 
        ? new Color("#FFFFFF", 1.0)
        : new Color("#3A3A3C", 1.0)
    );
    ctx.setLineWidth(isMidnight ? 4 : isNoon ? 2 : 1);
    ctx.strokeRect(
      new Rect(
        x,
        CANVAS.localPlotTop - 7,
        1,
        localPlotBottom() - CANVAS.localPlotTop + 7
      )
    );

    if (isMidnight) {
      const weekday = shortWeekday(tick);
      const style = dayBadgeStyle(tick, loadResult.holidayDates);
      const badge = new Rect(x - 25, 3, 50, 34);
      ctx.setFillColor(style.background);
      ctx.fillRect(badge);
      ctx.setFont(Font.blackRoundedSystemFont(21));
      ctx.setTextColor(style.text);
      ctx.setTextAlignedCenter();
      ctx.drawTextInRect(weekday, new Rect(x - 25, 8, 50, 25));
    } else {
      const label = String(hour).padStart(2, "0");
      ctx.setFont(
        isNoon
          ? Font.blackMonospacedSystemFont(21)
          : Font.regularMonospacedSystemFont(21)
      );
      ctx.setTextColor(
        isNoon
          ? Color.white()
          : new Color(SETTINGS.secondaryTextColor)
      );
      ctx.setTextAlignedCenter();
      ctx.drawTextInRect(label, new Rect(x - 22, 7, 44, 27));
    }

    tick = new Date(tick.getTime() + 60 * 60 * 1000);
  }
}

function drawTimelineItem(ctx, item, y, rowHeight) {
  const centerY = y + rowHeight / 2;
  const color = new Color(item.color);
  const barHeight = item.isOverflow ? 38 : 42;
  const barY = centerY - barHeight / 2;

  if (item.isOverflow) {
    const markerWidth = 58;
    const markerX = Math.max(
      0,
      Math.min(timelineWidth() - markerWidth, timeToX(item.start))
    );

    fillRoundedRect(
      ctx,
      new Rect(markerX, barY, markerWidth, barHeight),
      6,
      color
    );

    ctx.setTextAlignedCenter();
    ctx.setFont(Font.blackRoundedSystemFont(22));
    ctx.setTextColor(Color.white());
    ctx.drawTextInRect(
      item.title,
      new Rect(markerX, barY + 6, markerWidth, 27)
    );
    return;
  }

  const originalX = timeToX(item.start);
  const x =
    item.kind === "reminder"
      ? Math.max(0, originalX)
      : originalX;
  const width = Math.max(1, timeToX(item.end) - x);

  fillRoundedRect(
    ctx,
    new Rect(x, barY, width, barHeight),
    6,
    color
  );

  const title = item.title.toLocaleUpperCase("pt-BR");
  const textPoint = new Point(Math.max(0, x) + 7, barY + 7);

  // O título nunca é truncado pelo tamanho da barra. Ele só é recortado
  // pelo limite direito; na esquerda ele permanece sempre totalmente visível.
  ctx.setTextAlignedLeft();
  ctx.setFont(Font.blackRoundedSystemFont(22));
  ctx.setTextColor(new Color("#000000", 0.85));
  ctx.drawText(title, new Point(textPoint.x + 2, textPoint.y + 2));
  ctx.setTextColor(Color.white());
  ctx.drawText(title, textPoint);
}

function drawPermissionState(ctx) {
  const box = new Rect(
    40,
    90,
    timelineWidth() - 80,
    185
  );
  fillRoundedRect(ctx, box, 24, new Color("#1D1D20"));

  ctx.setTextAlignedCenter();
  ctx.setTextColor(new Color(SETTINGS.primaryTextColor));
  ctx.setFont(Font.boldRoundedSystemFont(29));
  ctx.drawTextInRect(
    "ACESSO NECESSÁRIO",
    new Rect(box.x + 20, box.y + 36, box.width - 40, 42)
  );

  ctx.setFont(Font.regularRoundedSystemFont(21));
  ctx.setTextColor(new Color(SETTINGS.secondaryTextColor));
  ctx.drawTextInRect(
    "Toque no widget e permita Calendário e Lembretes.",
    new Rect(box.x + 45, box.y + 91, box.width - 90, 58)
  );
}

async function showPermissionHelp(errorMessage) {
  const alert = new Alert();
  alert.title = "Permissões necessárias";
  alert.message =
    "Permita ao Scriptable acessar Calendários e Lembretes. Se o iPhone não mostrar a pergunta, abra Ajustes › Apps › Scriptable e habilite os dois acessos.\n\nDetalhe: " +
    errorMessage;
  alert.addAction("Entendi");
  await alert.presentAlert();
}

function parseWindowHours(parameter) {
  const raw = String(parameter ?? "").trim();
  if (!raw) return SETTINGS.defaultWindowHours;
  if (!/^\d+$/.test(raw)) return SETTINGS.defaultWindowHours;

  const value = Number(raw);
  if (
    !Number.isInteger(value) ||
    value < 1 ||
    value > SETTINGS.maximumWindowHours
  ) {
    return SETTINGS.defaultWindowHours;
  }
  return value;
}

function calendarURL(date) {
  const appleReferenceDate = Date.UTC(2001, 0, 1, 0, 0, 0);
  const secondsSinceReference = Math.floor(
    (date.getTime() - appleReferenceDate) / 1000
  );
  return `calshow:${secondsSinceReference}`;
}

function addURLParameter(url, name, value) {
  const separator = url.includes("?") ? "&" : "?";
  return (
    `${url}${separator}` +
    `${encodeURIComponent(name)}=${encodeURIComponent(value)}`
  );
}

function isHolidayEvent(event) {
  if (!event.isAllDay) return false;
  const searchableText = normalizeSearchText(
    `${event.calendar?.title ?? ""} ${event.title ?? ""}`
  );
  return (
    searchableText.includes("feriad") ||
    searchableText.includes("holiday")
  );
}

function normalizeSearchText(value) {
  return String(value)
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLocaleLowerCase("pt-BR");
}

function dateKey(date) {
  const year = date.getFullYear();
  const month = String(date.getMonth() + 1).padStart(2, "0");
  const day = String(date.getDate()).padStart(2, "0");
  return `${year}-${month}-${day}`;
}

function dayBadgeStyle(date, holidayDates) {
  if (holidayDates.has(dateKey(date))) {
    return {
      background: new Color("#FFCC00"),
      text: Color.black(),
    };
  }
  if (date.getDay() === 6) {
    return {
      background: new Color("#0A84FF"),
      text: Color.white(),
    };
  }
  if (date.getDay() === 0) {
    return {
      background: new Color("#FF453A"),
      text: Color.white(),
    };
  }
  return {
    background: Color.white(),
    text: Color.black(),
  };
}

function titleWeekdayColor(date, holidayDates) {
  if (holidayDates.has(dateKey(date))) return new Color("#FFCC00");
  if (date.getDay() === 6) return new Color("#0A84FF");
  if (date.getDay() === 0) return new Color("#FF453A");
  return Color.white();
}

function shortWeekday(date) {
  const weekdays = ["DOM", "SEG", "TER", "QUA", "QUI", "SEX", "SAB"];
  return weekdays[date.getDay()];
}

function formatDate(date, format) {
  const formatter = new DateFormatter();
  formatter.locale = SETTINGS.locale;
  formatter.dateFormat = format;
  return formatter.string(date);
}

function startOfToday() {
  const date = new Date();
  date.setHours(0, 0, 0, 0);
  return date;
}

function startOfDay(sourceDate) {
  const date = new Date(sourceDate);
  date.setHours(0, 0, 0, 0);
  return date;
}

function addDays(sourceDate, numberOfDays) {
  const date = new Date(sourceDate);
  date.setDate(date.getDate() + numberOfDays);
  return date;
}

function floorToHour(sourceDate) {
  const date = new Date(sourceDate);
  date.setMinutes(0, 0, 0);
  return date;
}

function ceilToHour(sourceDate) {
  const date = floorToHour(sourceDate);
  if (date < sourceDate) date.setHours(date.getHours() + 1);
  return date;
}

function timeToX(date) {
  const elapsed = date.getTime() - windowStart.getTime();
  const duration = windowEnd.getTime() - windowStart.getTime();
  return (elapsed / duration) * timelineWidth();
}

function timelineWidth() {
  return CANVAS.plotRight - CANVAS.plotLeft;
}

function timelineHeight() {
  return CANVAS.timelineBottom - CANVAS.timelineTop;
}

function localPlotBottom() {
  return timelineHeight();
}

function safeCalendarColor(calendar, fallback) {
  try {
    const hex = calendar?.color?.hex;
    return hex ? `#${hex.replace("#", "")}` : fallback;
  } catch (_) {
    return fallback;
  }
}

function fillRoundedRect(ctx, rect, radius, color) {
  const r = Math.min(radius, rect.width / 2, rect.height / 2);
  ctx.setFillColor(color);
  ctx.fillRect(new Rect(rect.x + r, rect.y, rect.width - 2 * r, rect.height));
  ctx.fillRect(new Rect(rect.x, rect.y + r, rect.width, rect.height - 2 * r));
  ctx.fillEllipse(new Rect(rect.x, rect.y, 2 * r, 2 * r));
  ctx.fillEllipse(new Rect(rect.x + rect.width - 2 * r, rect.y, 2 * r, 2 * r));
  ctx.fillEllipse(
    new Rect(rect.x, rect.y + rect.height - 2 * r, 2 * r, 2 * r)
  );
  ctx.fillEllipse(
    new Rect(
      rect.x + rect.width - 2 * r,
      rect.y + rect.height - 2 * r,
      2 * r,
      2 * r
    )
  );
}

function cleanTitle(value, fallback) {
  const title = String(value ?? "").replace(/\s+/g, " ").trim();
  return title || fallback;
}

