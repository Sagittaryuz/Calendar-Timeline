const VERTICAL_LAYOUT_SCALE =
  (WIDGET_CANVAS_HEIGHT -
    WIDGET_CONTENT_TOP_MARGIN -
    WIDGET_CONTENT_BOTTOM_MARGIN) /
  (LEGACY_CONTENT_BOTTOM_EDGE - LEGACY_CONTENT_TOP);

function scaleVertical(value) {
  return value * VERTICAL_LAYOUT_SCALE;
}

function scaleFontSize(value) {
  return Math.max(1, Math.round(scaleVertical(value)));
}

function mapLegacyContentY(value) {
  return (
    WIDGET_CONTENT_TOP_MARGIN +
    (value - LEGACY_CONTENT_TOP) * VERTICAL_LAYOUT_SCALE
  );
}


// Arco local do mesmo perfil do contorno externo; ângulos em radianos.
// Serve tanto ao preenchimento quanto ao traço, inclusive por espelhamento.
function appendContourArc(path, cx, cy, rx, ry, start, end) {
  const power = 2 / WIDGET_CONTOUR.exponent;
  for (let i = 1; i <= 64; i++) {
    const angle = start + (end - start) * i / 64;
    const cos = Math.cos(angle), sin = Math.sin(angle);
    path.addLine(new Point(
      cx + rx * Math.sign(cos) * Math.abs(cos) ** power,
      cy + ry * Math.sign(sin) * Math.abs(sin) ** power
    ));
  }
}

function widgetContourInsetAtY(y, inset = 0) {
  const rx = WIDGET_CONTOUR.extentX - inset;
  const ry = WIDGET_CONTOUR.extentY - inset;
  if (y < inset || y > CANVAS.height - inset) return CANVAS.width / 2;
  const distance = Math.min(y - inset, CANVAS.height - inset - y);
  if (distance >= ry) return inset;
  const n = WIDGET_CONTOUR.exponent;
  const t = Math.max(0, Math.min(1, 1 - distance / ry));
  return inset + rx * (1 - Math.pow(Math.max(0, 1 - t ** n), 1 / n));
}

// Duas curvas locais de superelipse, com retas entre elas. Não deformar
// uma superelipse sobre o retângulo inteiro: isso arredondaria as laterais.
function widgetLeftContourPoints(inset = WIDGET_CONTOUR.strokeInset) {
  const points = [];
  const rx = WIDGET_CONTOUR.extentX - inset;
  const ry = WIDGET_CONTOUR.extentY - inset;
  const power = 2 / WIDGET_CONTOUR.exponent;
  for (let i = 0; i <= 64; i++) {
    const angle = i / 64 * Math.PI / 2;
    points.push(new Point(
      inset + rx * (1 - Math.sin(angle) ** power),
      inset + ry * (1 - Math.cos(angle) ** power)
    ));
  }
  for (let i = 0; i <= 64; i++) {
    const angle = i / 64 * Math.PI / 2;
    points.push(new Point(
      inset + rx * (1 - Math.cos(angle) ** power),
      CANVAS.height - inset - ry + ry * Math.sin(angle) ** power
    ));
  }
  return points;
}

function titleSafeTextY(
  width,
  height,
  preferredY,
  clearance = WIDGET_CONTOUR.textClearance,
  visibleTopOffset = 0
) {
  // Mesma altura nos quatro cartões. Mede o pior caso nas extremidades.
  const card = titleDayCardRect(0);
  const left = (card.width - width) / 2;
  const visibleOffset = Math.max(0, Number(visibleTopOffset) || 0);
  let y = preferredY;
  while (y + height <= card.y + card.height) {
    const required = Math.max(widgetContourInsetAtY(y + visibleOffset),
      widgetContourInsetAtY(y + height)) + Math.max(0, Number(clearance) || 0);
    if (left >= required) return y;
    y += 0.5;
  }
  return preferredY;
}

function titleHeaderFontSize() {
  const card = titleDayCardRect(0);
  // O conjunto ocupa 8,5 células: três do dia, cinco da data e meia célula
  // entre eles. Mesma fonte e largura para os quatro cartões, inclusive hoje.
  let size = scaleFontSize(38);
  while (size > scaleFontSize(30)) {
    const y = titleSafeTextY(
      8.5 * size * 0.60 + 4,
      size * 1.15,
      6,
      WIDGET_CONTOUR.textClearance,
      size * TITLE_CARD_TEXT_VISIBLE_TOP_RATIO
    );
    const detailBottom = y + size * 1.15 + 5 +
      scaleFontSize(22) / 2 + scaleVertical(30) / 2;
    if (detailBottom <= card.y + card.height - 3) break;
    size--;
  }
  return size;
}

