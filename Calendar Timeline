async function showPermissionHelp(errorMessage) {
  const alert = new Alert();
  alert.title = "Permissões necessárias";
  alert.message =
    "Permita ao Scriptable acessar Calendários e Lembretes. Se o iPhone não mostrar a pergunta, abra Ajustes › Apps › Scriptable e habilite os dois acessos.\n\nDetalhe: " +
    errorMessage;
  alert.addAction("Entendi");
  await alert.presentAlert();
}

function parseWindowHours(parameter) {
  const raw = String(parameter ?? "").trim();
  if (!raw) return SETTINGS.defaultWindowHours;
  if (!/^\d+$/.test(raw)) return SETTINGS.defaultWindowHours;

  const value = Number(raw);
  if (!Number.isInteger(value) || value < 1) {
    return SETTINGS.defaultWindowHours;
  }
  return Math.min(value, SETTINGS.maximumWindowHours);
}

function calendarURL(date) {
  const appleReferenceDate = Date.UTC(2001, 0, 1, 0, 0, 0);
  const secondsSinceReference = Math.floor(
    (date.getTime() - appleReferenceDate) / 1000
  );
  return `calshow:${secondsSinceReference}`;
}

function addURLParameter(url, name, value) {
  const separator = url.includes("?") ? "&" : "?";
  return (
    `${url}${separator}` +
    `${encodeURIComponent(name)}=${encodeURIComponent(value)}`
  );
}

function isHolidayEvent(event) {
  if (!event.isAllDay) return false;
  const searchableText = normalizeSearchText(
    `${event.calendar?.title ?? ""} ${event.title ?? ""}`
  );
  return (
    searchableText.includes("feriad") ||
    searchableText.includes("holiday")
  );
}

function normalizeSearchText(value) {
  return String(value)
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLocaleLowerCase("pt-BR");
}

function dateKey(date) {
  const year = date.getFullYear();
  const month = String(date.getMonth() + 1).padStart(2, "0");
  const day = String(date.getDate()).padStart(2, "0");
  return `${year}-${month}-${day}`;
}

function dayBadgeStyle(date, holidayDates) {
  // O círculo permanece branco em qualquer data. Somente a legenda
  // interna recebe a cor temática do sábado, domingo ou feriado.
  if (holidayDates.has(dateKey(date))) {
    return {
      background: Color.white(),
      text: new Color("#FFCC00", 1.0),
    };
  }
  if (date.getDay() === 6) {
    return {
      background: Color.white(),
      text: new Color("#0A84FF", 1.0),
    };
  }
  if (date.getDay() === 0) {
    return {
      background: Color.white(),
      text: new Color("#FF453A", 1.0),
    };
  }
  return {
    background: Color.white(),
    text: Color.black(),
  };
}

function dayBoundaryLineColor(_, __) {
  // A linha vertical e o aro da Lua de mudança de dia são estruturais:
  // ambos permanecem brancos, independentemente do dia representado.
  return Color.white();
}

function titleWeekdayColor(date, holidayDates) {
  if (holidayDates.has(dateKey(date))) return new Color("#FFCC00");
  if (date.getDay() === 6) return new Color("#0A84FF");
  if (date.getDay() === 0) return new Color("#FF453A");
  return Color.white();
}

function titleDayColor(date, holidayDates) {
  if (holidayDates.has(dateKey(date))) return new Color("#FFCC00");
  if (date.getDay() === 6) return new Color("#0A84FF");
  if (date.getDay() === 0) return new Color("#FF453A");
  return Color.white();
}

function titleWeekday(date) {
  const weekdays = [
    "Domingo",
    "Segunda",
    "Terça",
    "Quarta",
    "Quinta",
    "Sexta",
    "Sábado",
  ];
  return weekdays[date.getDay()];
}

function shortWeekday(date) {
  const weekdays = ["DOM", "SEG", "TER", "QUA", "QUI", "SEX", "SAB"];
  return weekdays[date.getDay()];
}

function formatDate(date, format) {
  const formatter = new DateFormatter();
  formatter.locale = SETTINGS.locale;
  formatter.dateFormat = format;
  return formatter.string(date);
}

function startOfToday() {
  const date = new Date();
  date.setHours(0, 0, 0, 0);
  return date;
}

function startOfDay(sourceDate) {
  const date = new Date(sourceDate);
  date.setHours(0, 0, 0, 0);
  return date;
}

function normalizedReminderDayStart(reminder) {
  const due = reminder?.dueDate;
  if (!due) return null;
  if (Boolean(reminder.dueDateIncludesTime)) return startOfDay(due);

  // O EventKit pode codificar uma data sem horário como meia-noite UTC.
  // Reconstruí-la com os componentes UTC preserva o dia escolhido pelo
  // usuário em fusos negativos, como o horário de Brasília.
  const isUTCDateOnly =
    due.getUTCHours() === 0 &&
    due.getUTCMinutes() === 0 &&
    due.getUTCSeconds() === 0;
  if (isUTCDateOnly) {
    return new Date(
      due.getUTCFullYear(),
      due.getUTCMonth(),
      due.getUTCDate(),
      0,
      0,
      0,
      0
    );
  }
  return startOfDay(due);
}

function dateAtHour(sourceDate, hour) {
  const date = new Date(sourceDate);
  date.setHours(hour, 0, 0, 0);
  return date;
}

function addDays(sourceDate, numberOfDays) {
  const date = new Date(sourceDate);
  date.setDate(date.getDate() + numberOfDays);
  return date;
}

function floorToHour(sourceDate) {
  const date = new Date(sourceDate);
  date.setMinutes(0, 0, 0);
  return date;
}

function ceilToHour(sourceDate) {
  const date = floorToHour(sourceDate);
  if (date < sourceDate) date.setHours(date.getHours() + 1);
  return date;
}

function timeToX(date) {
  const elapsed = date.getTime() - windowStart.getTime();
  const duration = windowEnd.getTime() - windowStart.getTime();
  return (elapsed / duration) * timelineWidth();
}

function timelineLegendCenterX(date) {
  // A legenda numérica e o dia da semana usam exatamente o centro da
  // mesma barra vertical de mudança de dia/horário.
  return timeToX(date);
}

function timelineWidth() {
  return CANVAS.plotRight - CANVAS.plotLeft;
}

function timelineHeight() {
  return CANVAS.timelineBottom - CANVAS.timelineTop;
}

function localPlotBottom() {
  return timelineHeight();
}

function safeCalendarColor(calendar, fallback) {
  try {
    const hex = calendar?.color?.hex;
    return hex ? `#${hex.replace("#", "")}` : fallback;
  } catch (_) {
    return fallback;
  }
}

function drawPendingDayCarryoverBorder(ctx, rect, chartRadius) {
  const gap = Math.max(
    0,
    scaleVertical(
      Number(SETTINGS.pendingDayCarryoverBorderGap) || 0
    )
  );
  const borderWidth = Math.max(
    scaleVertical(1),
    scaleVertical(
      Number(SETTINGS.pendingDayCarryoverBorderWidth) || 1
    )
  );
  const outset = gap + borderWidth / 2;
  const borderRect = new Rect(
    rect.x - outset,
    rect.y - outset,
    rect.width + outset * 2,
    rect.height + outset * 2
  );

  if (borderRect.width <= 1 || borderRect.height <= 1) return;

  drawRoundedRectOutline(
    ctx,
    borderRect,
    Math.max(1, chartRadius + outset),
    new Color(
      SETTINGS.pendingDayCarryoverBorderColor,
      1.0
    ),
    borderWidth
  );
}

function drawRoundedRectOutline(
  ctx,
  rect,
  radius,
  color,
  lineWidth
) {
  const width = Math.max(0, Number(rect.width) || 0);
  const height = Math.max(0, Number(rect.height) || 0);
  const strokeWidth = Math.max(
    0.5,
    Number(lineWidth) || 1
  );
  if (width <= 0 || height <= 0) return;

  const left = rect.x;
  const top = rect.y;
  const right = rect.x + width;
  const bottom = rect.y + height;
  const boundedRadius = Math.max(
    0,
    Math.min(
      Number(radius) || 0,
      width / 2,
      height / 2
    )
  );
  const curveFactor = 0.5522847498;
  const path = new Path();

  if (boundedRadius <= 0) {
    path.move(new Point(left, top));
    path.addLine(new Point(right, top));
    path.addLine(new Point(right, bottom));
    path.addLine(new Point(left, bottom));
    path.closeSubpath();
  } else {
    path.move(new Point(left + boundedRadius, top));
    path.addLine(new Point(right - boundedRadius, top));
    path.addCurve(
      new Point(right, top + boundedRadius),
      new Point(
        right - boundedRadius +
          boundedRadius * curveFactor,
        top
      ),
      new Point(
        right,
        top + boundedRadius -
          boundedRadius * curveFactor
      )
    );
    path.addLine(new Point(right, bottom - boundedRadius));
    path.addCurve(
      new Point(right - boundedRadius, bottom),
      new Point(
        right,
        bottom - boundedRadius +
          boundedRadius * curveFactor
      ),
      new Point(
        right - boundedRadius +
          boundedRadius * curveFactor,
        bottom
      )
    );
    path.addLine(new Point(left + boundedRadius, bottom));
    path.addCurve(
      new Point(left, bottom - boundedRadius),
      new Point(
        left + boundedRadius -
          boundedRadius * curveFactor,
        bottom
      ),
      new Point(
        left,
        bottom - boundedRadius +
          boundedRadius * curveFactor
      )
    );
    path.addLine(new Point(left, top + boundedRadius));
    path.addCurve(
      new Point(left + boundedRadius, top),
      new Point(
        left,
        top + boundedRadius -
          boundedRadius * curveFactor
      ),
      new Point(
        left + boundedRadius -
          boundedRadius * curveFactor,
        top
      )
    );
    path.closeSubpath();
  }

  ctx.addPath(path);
  ctx.setStrokeColor(color);
  ctx.setLineWidth(strokeWidth);
  ctx.strokePath();
}

function fillRoundedRect(ctx, rect, radius, color) {
  const r = Math.min(radius, rect.width / 2, rect.height / 2);
  ctx.setFillColor(color);
  ctx.fillRect(new Rect(rect.x + r, rect.y, rect.width - 2 * r, rect.height));
  ctx.fillRect(new Rect(rect.x, rect.y + r, rect.width, rect.height - 2 * r));
  ctx.fillEllipse(new Rect(rect.x, rect.y, 2 * r, 2 * r));
  ctx.fillEllipse(new Rect(rect.x + rect.width - 2 * r, rect.y, 2 * r, 2 * r));
  ctx.fillEllipse(
    new Rect(rect.x, rect.y + rect.height - 2 * r, 2 * r, 2 * r)
  );
  ctx.fillEllipse(
    new Rect(
      rect.x + rect.width - 2 * r,
      rect.y + rect.height - 2 * r,
      2 * r,
      2 * r
    )
  );
}

function cleanTitle(value, fallback) {
  const title = String(value ?? "").replace(/\s+/g, " ").trim();
  return title || fallback;
}
