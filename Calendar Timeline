async function loadWindow() {
  try {
    const todayStart = startOfDay(now);
    // No primeiro uso dentro do app, estas consultas exibem os pedidos
    // nativos de acesso ao Calendário e aos Lembretes.
    // Lembretes sem horário podem chegar do EventKit como 00:00 UTC. Em
    // fusos negativos, isso aparece localmente na noite do dia anterior.
    // Os cartões mostram quatro dias completos. A consulta de dados precisa
    // alcançar todos eles, mesmo quando a timeline visível tem só 24 horas.
    const titleScheduleStart = startOfDay(windowStart);
    const titleScheduleEnd = addDays(
      titleScheduleStart,
      TITLE_CARD_COUNT
    );
    const scheduleQueryEnd = new Date(
      Math.max(
        windowEnd.getTime(),
        titleScheduleEnd.getTime()
      )
    );
    // A margem de um dia garante que eles entrem na consulta; abaixo a data
    // é normalizada antes de decidir se pertence à janela visível.
    const reminderQueryStart = addDays(titleScheduleStart, -1);
    const reminderQueryEnd = addDays(
      startOfDay(scheduleQueryEnd),
      1
    );
    // A consulta também recua um dia para capturar eventos que começaram
    // ontem e continuam ocupando o dia atual.
    const eventQueryStart = addDays(titleScheduleStart, -1);
    const queryResults = await Promise.allSettled([
      CalendarEvent.between(eventQueryStart, scheduleQueryEnd),
      Reminder.incompleteDueBetween(reminderQueryStart, reminderQueryEnd),
      CalendarEvent.today(),
      Reminder.incompleteDueToday(),
      SETTINGS.showOverdueReminders
        ? Reminder.scheduled()
        : Promise.resolve([]),
    ]);
    const queryArray = (result) =>
      result?.status === "fulfilled" && Array.isArray(result.value)
        ? result.value
        : [];
    const [
      eventsResult,
      remindersResult,
      todayEventsResult,
      todayRemindersResult,
      scheduledRemindersResult,
    ] = queryResults;
    const events = queryArray(eventsResult);
    const reminders = queryArray(remindersResult);
    const todayEventsRaw = queryArray(todayEventsResult);
    const todayRemindersRaw = queryArray(todayRemindersResult);
    const scheduledReminders = queryArray(scheduledRemindersResult);
    const calendarReadFailed =
      eventsResult?.status === "rejected" &&
      todayEventsResult?.status === "rejected";
    const reminderReadFailed =
      remindersResult?.status === "rejected" &&
      todayRemindersResult?.status === "rejected" &&
      (!SETTINGS.showOverdueReminders ||
        scheduledRemindersResult?.status === "rejected");
    const sourceErrors = queryResults
      .filter((result) => result?.status === "rejected")
      .map((result) => String(result.reason));

    const excluded = new Set(
      SETTINGS.excludedCalendars.map((name) => name.toLocaleLowerCase())
    );
    const selected = new Set(SETTINGS.selectedCalendarIdentifiers ?? []);

    const includeCalendar = (calendar) => {
      const calendarName = calendar?.title ?? "";
      const isSelected =
        selected.size === 0 || selected.has(calendar?.identifier);
      return (
        isSelected &&
        !excluded.has(calendarName.toLocaleLowerCase())
      );
    };

    const todayEvents = todayEventsRaw.filter((event) =>
      includeCalendar(event.calendar)
    );

    // O EventKit pode devolver um lembrete recorrente encontrado por
    // incompleteDueToday() mantendo em dueDate a data-base da série. Nesse
    // caso, materializamos uma ocorrência de hoje sem alterar o lembrete
    // original. O horário é preservado; lembretes sem horário usam o dia.
    const reminderOccurrenceView = (reminder, forcedDayStart = null) => {
      const hasTime = Boolean(reminder.dueDateIncludesTime);
      const originalDue = reminder.dueDate;
      let effectiveDue = originalDue;

      if (forcedDayStart) {
        effectiveDue = new Date(forcedDayStart);
        if (hasTime && originalDue) {
          effectiveDue.setHours(
            originalDue.getHours(),
            originalDue.getMinutes(),
            originalDue.getSeconds(),
            0
          );
        }
      }

      return {
        identifier: reminder.identifier,
        title: reminder.title,
        calendar: reminder.calendar,
        priority: reminder.priority,
        dueDate: effectiveDue,
        dueDateIncludesTime: hasTime,
      };
    };

    // A consulta por intervalo cobre a janela completa. A consulta específica
    // de hoje é convertida em ocorrências reais de hoje e funciona como fonte
    // autoritativa para séries recorrentes (inclusive a cada 30 dias).
    const rangeReminderViews = reminders.map((reminder) =>
      reminderOccurrenceView(reminder)
    );
    const todayOccurrenceViews = todayRemindersRaw.map((reminder) =>
      reminderOccurrenceView(reminder, todayStart)
    );

    const reminderOccurrenceKey = (reminder) => {
      const due = reminder.dueDate;
      const dayStart = normalizedReminderDayStart(reminder);
      const sourceIdentifier =
        reminder.identifier ??
        `${reminder.calendar?.identifier ?? reminder.calendar?.title ?? ""}-${reminder.title ?? ""}`;
      const occurrence =
        Boolean(reminder.dueDateIncludesTime) && due
          ? due.getTime()
          : dayStart
            ? dateKey(dayStart)
            : "sem-data";
      return `${sourceIdentifier}::${occurrence}`;
    };

    const displayReminderMap = new Map();
    for (const reminder of [
      ...rangeReminderViews,
      ...todayOccurrenceViews,
    ]) {
      if (
        !normalizedReminderDayStart(reminder) ||
        !includeCalendar(reminder.calendar)
      ) {
        continue;
      }
      displayReminderMap.set(reminderOccurrenceKey(reminder), reminder);
    }

    const displayReminders = [...displayReminderMap.values()];
    const todayReminders = displayReminders.filter((reminder) => {
      const dayStart = normalizedReminderDayStart(reminder);
      return dayStart && dateKey(dayStart) === dateKey(todayStart);
    });

    // CalendarEvent.between() pode não devolver um evento cujo início ficou
    // antes de windowStart. CalendarEvent.today() é a fonte autoritativa
    // para ocorrências que o Calendário considera pertencentes ao dia atual.
    const eventOccurrenceKey = (event) => {
      const sourceIdentifier =
        event.identifier ??
        `${event.calendar?.identifier ?? event.calendar?.title ?? ""}-${event.title ?? "Evento"}`;
      const occurrenceStart = event.startDate
        ? event.startDate.getTime()
        : "sem-inicio";
      return `${sourceIdentifier}::${occurrenceStart}`;
    };

    const displayEventMap = new Map();
    const collectDisplayEvent = (event, occursToday = false) => {
      if (!includeCalendar(event.calendar)) return;

      const eventStart = event.startDate
        ? new Date(event.startDate)
        : null;
      let eventEnd = event.endDate
        ? new Date(event.endDate)
        : null;
      const isAllDay = Boolean(event.isAllDay);

      if (!eventStart || !eventEnd) return;

      // Em eventos de dia inteiro, alguns calendários entregam endDate em
      // 00:00 do último dia exibido. Se CalendarEvent.today() confirmou que
      // a ocorrência pertence a hoje, ela deve permanecer visível até 00:00
      // do dia seguinte, independentemente desse limite bruto.
      if (isAllDay && occursToday) {
        const currentDayEnd = addDays(startOfDay(windowStart), 1);
        if (eventEnd < currentDayEnd) {
          eventEnd = currentDayEnd;
        }
      }

      // Eventos nunca recebem extensão artificial para o dia seguinte.
      // Somente lembretes pendentes passam pela regra de carryover.
      if (
        eventEnd <= windowStart ||
        eventStart >= windowEnd
      ) return;

      displayEventMap.set(eventOccurrenceKey(event), {
        event,
        start: eventStart,
        end: eventEnd,
        isAllDay,
      });
    };

    events.forEach((event) => collectDisplayEvent(event, false));
    // Executada depois para que a versão confirmada por today() prevaleça
    // sobre uma eventual duplicata da consulta por intervalo.
    todayEvents.forEach((event) => collectDisplayEvent(event, true));

    const eventItems = [...displayEventMap.values()].map((view) => {
      const event = view.event;
      const isBirthday = isBirthdayCalendarEvent(event);
      return {
        kind: "event",
        title: isBirthday
          ? formatBirthdayTitleFromEvent(event)
          : cleanTitle(event.title, "Evento"),
        calendarTitle: event.calendar?.title ?? "Calendário",
        start: view.start,
        end: view.end,
        isAllDay: view.isAllDay,
        isBirthday,
        isHoliday: isHolidayEvent(event),
        identifier:
          event.identifier ??
          `${event.title}-${view.start.getTime()}`,
        location: cleanOptionalText(event.location),
        notes: cleanOptionalText(event.notes),
        attendeeCount: Array.isArray(event.attendees)
          ? event.attendees.filter((attendee) => !attendee.isCurrentUser).length
          : 0,
        participationStatus: currentUserParticipationStatus(event.attendees),
        availability: event.availability ?? "busy",
        hasVideoLink: eventHasVideoLink(event),
        color: safeCalendarColor(
          event.calendar,
          SETTINGS.fallbackEventColor
        ),
      };
    });

    // Os contadores do cabeçalho não podem reutilizar eventItems e
    // reminderItems: esses arrays já foram recortados pela janela visível.
    // Aqui contamos as ocorrências reais de cada dia dos quatro cartões.
    const scheduleCountsByDay = {};
    for (let index = 0; index < TITLE_CARD_COUNT; index++) {
      const day = addDays(titleScheduleStart, index);
      scheduleCountsByDay[dateKey(day)] = {
        events: 0,
        reminders: 0,
      };
    }

    const countEventMap = new Map();
    const collectCountEvent = (event, occursToday = false) => {
      if (!includeCalendar(event.calendar)) return;

      const eventStart = event.startDate
        ? new Date(event.startDate)
        : null;
      let eventEnd = event.endDate
        ? new Date(event.endDate)
        : null;
      const isAllDay = Boolean(event.isAllDay);

      if (!eventStart || !eventEnd) return;

      // Eventos de dia inteiro continuam disponíveis para a timeline,
      // mas não entram no quantitativo "E:n" dos cartões.
      if (isAllDay) return;

      // A ocorrência confirmada por CalendarEvent.today() prevalece
      // inclusive quando o fim bruto de um evento de dia inteiro vem
      // antes da meia-noite real.
      if (isAllDay && occursToday) {
        const currentDayEnd = addDays(titleScheduleStart, 1);
        if (eventEnd < currentDayEnd) {
          eventEnd = currentDayEnd;
        }
      }

      if (
        !Number.isFinite(eventStart.getTime()) ||
        !Number.isFinite(eventEnd.getTime()) ||
        eventEnd <= titleScheduleStart ||
        eventStart >= titleScheduleEnd
      ) {
        return;
      }

      countEventMap.set(eventOccurrenceKey(event), {
        start: eventStart,
        end: eventEnd,
      });
    };

    events.forEach((event) => collectCountEvent(event, false));
    // A consulta específica de hoje também corrige recorrências e
    // substitui eventual duplicata da consulta por intervalo.
    todayEvents.forEach((event) => collectCountEvent(event, true));

    for (const event of countEventMap.values()) {
      for (
        let day = new Date(titleScheduleStart);
        day < titleScheduleEnd;
        day = addDays(day, 1)
      ) {
        const dayEnd = addDays(day, 1);
        // Para hoje, eventos já encerrados não são futuros; para os dias
        // seguintes, toda a ocorrência daquele dia entra no quantitativo.
        const countStart =
          dateKey(day) === dateKey(titleScheduleStart)
            ? windowStart
            : day;
        if (event.end > countStart && event.start < dayEnd) {
          scheduleCountsByDay[dateKey(day)].events++;
        }
      }
    }

    for (const reminder of displayReminders) {
      const dayStart = normalizedReminderDayStart(reminder);
      const key = dayStart ? dateKey(dayStart) : null;
      if (key && scheduleCountsByDay[key]) {
        scheduleCountsByDay[key].reminders++;
      }
    }

    const reminderItems = displayReminders
      .filter((reminder) => {
        const dayStart = normalizedReminderDayStart(reminder);
        if (!dayStart || !includeCalendar(reminder.calendar)) return false;
        const dayEnd = addDays(dayStart, 1);
        return dayEnd > windowStart && dayStart < windowEnd;
      })
      .flatMap((reminder) => {
        const due = reminder.dueDate ?? todayStart;
        const hasTime = Boolean(reminder.dueDateIncludesTime);
        const reminderDayStart = normalizedReminderDayStart(reminder);
        const reminderDayEnd = addDays(reminderDayStart, 1);
        const reminderCutoff = reminderDayEnd;
        // Lembretes com horário começam no horário devido; lembretes
        // de dia inteiro começam à meia-noite e ocupam até a meia-noite
        // seguinte.
        const reminderDisplayStart = hasTime
          ? due
          : reminderDayStart;
        const identifier =
          reminder.identifier ?? `${reminder.title}-${due}`;
        const baseItem = {
          kind: "reminder",
          title: cleanTitle(reminder.title, "Lembrete"),
          calendarTitle: reminder.calendar?.title ?? "Lembretes",
          // Mesmo quando a origem é "dia inteiro", o chart possui agora um
          // intervalo horário definido e não deve sobreviver ao próprio fim.
          isAllDay: false,
          sourceIsAllDay: !hasTime,
          identifier,
          priority: Number(reminder.priority) || 0,
          color: safeCalendarColor(
            reminder.calendar,
            SETTINGS.fallbackReminderColor
          ),
        };

        // O lembrete com horário permanece visível desde o horário devido
        // até o fim do dia. O lembrete de dia inteiro ocupa o dia completo.
        // Se continuar pendente, ele reaparece no dia seguinte como atrasado.
        const segments = [];
        if (reminderDisplayStart < reminderCutoff) {
          segments.push({
            ...baseItem,
            start: reminderDisplayStart,
            end: reminderCutoff,
            isOverdue: false,
          });
        }

        return segments;
      });

    const reminderIdentifiers = new Set(
      reminderItems.map((item) => item.identifier)
    );
    const overdueReminderItems = scheduledReminders
      .filter((reminder) => {
        const due = reminder.dueDate;
        const dueDayStart = normalizedReminderDayStart(reminder);
        if (!due || !dueDayStart || dueDayStart >= todayStart) return false;
        if (!includeCalendar(reminder.calendar)) return false;
        const identifier = reminder.identifier ?? `${reminder.title}-${due}`;
        return !reminderIdentifiers.has(identifier);
      })
      .map((reminder) => ({
        kind: "reminder",
        title: cleanTitle(reminder.title, "Lembrete"),
        calendarTitle: reminder.calendar?.title ?? "Lembretes",
        // No dia seguinte, um lembrete ainda pendente reaparece como
        // atrasado no intervalo do dia; a representação de dia inteiro
        // começa visualmente às 06:00.
        start: todayStart,
        end: addDays(todayStart, 1),
        isAllDay: false,
        sourceIsAllDay: !Boolean(reminder.dueDateIncludesTime),
        identifier: reminder.identifier ?? `${reminder.title}-${reminder.dueDate}`,
        priority: Number(reminder.priority) || 0,
        isOverdue: true,
        color: safeCalendarColor(
          reminder.calendar,
          SETTINGS.fallbackReminderColor
        ),
      }));

    const holidayDates = new Set(
      [...events, ...todayEvents]
        .filter(isHolidayEvent)
        .map((event) => dateKey(event.startDate))
    );

    const todayScheduleSummary = calculateScheduleSummary(
      todayEvents,
      todayStart,
      addDays(todayStart, 1)
    );

    return {
      items: [...eventItems, ...reminderItems, ...overdueReminderItems],
      scheduleCountsByDay,
      todayEventCount: todayEvents.length,
      todayReminderCount: todayReminders.length,
      todayBusyMinutes: todayScheduleSummary.busyMinutes,
      todayFreeMinutes: todayScheduleSummary.freeMinutes,
      holidayDates,
      error:
        calendarReadFailed && reminderReadFailed
          ? sourceErrors.join("\n")
          : null,
      partialErrors: sourceErrors,
    };
  } catch (error) {
    return {
      items: [],
      scheduleCountsByDay: {},
      todayEventCount: 0,
      todayReminderCount: 0,
      todayBusyMinutes: 0,
      todayFreeMinutes: 24 * 60,
      holidayDates: new Set(),
      error: String(error),
      partialErrors: [],
    };
  }
}

async function loadAstronomy() {
  const fallback = {
    latitude: SETTINGS.fallbackLatitude,
    longitude: SETTINGS.fallbackLongitude,
  };
  if (!SETTINGS.useCurrentLocation) return fallback;

  const cacheKey = "agenda-timeline-location-v1";
  let cachedLocation = null;

  try {
    if (Keychain.contains(cacheKey)) {
      cachedLocation = JSON.parse(Keychain.get(cacheKey));
      const maximumAge = SETTINGS.locationCacheHours * 60 * 60 * 1000;
      if (
        Number.isFinite(cachedLocation.latitude) &&
        Number.isFinite(cachedLocation.longitude) &&
        Date.now() - cachedLocation.updatedAt < maximumAge
      ) {
        return cachedLocation;
      }
    }
  } catch (_) {
    cachedLocation = null;
  }

  try {
    Location.setAccuracyToThreeKilometers();
    const currentLocation = await Location.current();
    const location = {
      latitude: currentLocation.latitude,
      longitude: currentLocation.longitude,
      updatedAt: Date.now(),
    };
    Keychain.set(cacheKey, JSON.stringify(location));
    return location;
  } catch (_) {
    // Mesmo quando a localização falhar, aguarda seis horas antes de tentar
    // novamente. Isso impede novas consultas a cada refresh de um minuto.
    const offlineLocation = {
      latitude: cachedLocation?.latitude ?? fallback.latitude,
      longitude: cachedLocation?.longitude ?? fallback.longitude,
      updatedAt: Date.now(),
    };
    try {
      Keychain.set(cacheKey, JSON.stringify(offlineLocation));
    } catch (_) {}
    return offlineLocation;
  }
}

function emptyHourlyWeather() {
  return { hours: [], daily: {} };
}

function firstFiniteWeatherNumber(...values) {
  for (const value of values) {
    if (value === null || value === undefined || value === "") continue;
    const number = Number(value);
    if (Number.isFinite(number)) return number;
  }
  return null;
}

function finiteWeatherNumber(value) {
  if (value === null || value === undefined || value === "") {
    return null;
  }
  const number = Number(value);
  return Number.isFinite(number) ? number : null;
}

function hasUsableWeatherPayload(payload) {
  if (!payload || typeof payload !== "object") return false;
  const hasHours = Array.isArray(payload.hours) &&
    payload.hours.some(
      (hour) =>
        finiteWeatherNumber(hour?.timestamp) !== null &&
        finiteWeatherNumber(hour?.temperature) !== null
    );
  const hasDaily = payload.daily &&
    Object.values(payload.daily).some(
      (values) =>
        finiteWeatherNumber(values?.minimum) !== null &&
        finiteWeatherNumber(values?.maximum) !== null &&
        finiteWeatherNumber(values.minimum) <=
          finiteWeatherNumber(values.maximum)
    );
  return Boolean(hasHours || hasDaily);
}

function weatherDataRequiredStart() {
  return floorToHour(windowStart).getTime();
}

function weatherDataRequiredEnd() {
  const titleCardsEnd = addDays(
    startOfDay(windowStart),
    TITLE_CARD_COUNT
  );
  return new Date(
    Math.max(windowEnd.getTime(), titleCardsEnd.getTime())
  );
}

function weatherCacheCoversRequiredWindow(hours) {
  const requiredStart = weatherDataRequiredStart();
  const requiredEnd = weatherDataRequiredEnd().getTime();
  const timestamps = [
    ...new Set(
      (Array.isArray(hours) ? hours : [])
        .filter(
          (hour) =>
            finiteWeatherNumber(hour?.timestamp) !== null &&
            finiteWeatherNumber(hour?.temperature) !== null
        )
        .map((hour) => finiteWeatherNumber(hour?.timestamp))
        .filter((timestamp) => timestamp !== null)
    ),
  ].sort((first, second) => first - second);
  if (timestamps.length === 0) return false;

  if (
    timestamps[0] > requiredStart + WEATHER_EDGE_TOLERANCE_MS ||
    timestamps[timestamps.length - 1] <
      requiredEnd - WEATHER_EDGE_TOLERANCE_MS
  ) {
    return false;
  }

  for (let index = 1; index < timestamps.length; index++) {
    const previous = timestamps[index - 1];
    const current = timestamps[index];
    const overlapsRequiredWindow =
      current >= requiredStart && previous <= requiredEnd;
    if (
      overlapsRequiredWindow &&
      current - previous > WEATHER_MAX_INTERPOLATION_GAP_MS
    ) {
      return false;
    }
  }

  return true;
}

function weatherCacheHasFreshSamples(hours, cacheAge, fallbackFetchedAt) {
  if (!weatherCacheCoversRequiredWindow(hours)) return false;

  const cutoff = Date.now() - Math.max(0, Number(cacheAge) || 0);
  const requiredStart = weatherDataRequiredStart();
  const requiredEnd = weatherDataRequiredEnd().getTime();
  const relevantHours = (Array.isArray(hours) ? hours : []).filter(
    (hour) => {
      const timestamp = finiteWeatherNumber(hour?.timestamp);
      return (
        timestamp !== null &&
        timestamp >= requiredStart - WEATHER_EDGE_TOLERANCE_MS &&
        timestamp <= requiredEnd + WEATHER_EDGE_TOLERANCE_MS
      );
    }
  );

  return relevantHours.every((hour) => {
    const fetchedAt = finiteWeatherNumber(
      hour?.fetchedAt ?? fallbackFetchedAt
    );
    return fetchedAt !== null && fetchedAt >= cutoff;
  });
}

function tagDailyWeather(daily, source, fetchedAt = null) {
  const tagged = {};
  for (const [key, values] of Object.entries(daily ?? {})) {
    tagged[key] = {
      ...values,
      source,
      ...(fetchedAt === null ? {} : { fetchedAt }),
    };
  }
  return tagged;
}

function loadStoredForecaCredentials() {
  const usernameKey = "Calendar-Timeline-Foreca-Username-v1";
  const passwordKey = "Calendar-Timeline-Foreca-Password-v1";

  try {
    if (Keychain.contains(usernameKey) && Keychain.contains(passwordKey)) {
      const user = Keychain.get(usernameKey);
      const password = Keychain.get(passwordKey);
      if (user && password) return { user, password };
    }
  } catch (_) {}

  return null;
}

async function loadHourlyWeather(location) {
  const fm = FileManager.local();
  const cachePaths = [
    fm.joinPath(
      fm.documentsDirectory(),
      "Calendar-Timeline-weather-v3.json"
    ),
    // Migração silenciosa do cache antigo da Foreca.
    fm.joinPath(
      fm.documentsDirectory(),
      "Calendar-Timeline-foreca-weather-v2.json"
    ),
  ];
  let cached = null;

  for (const candidatePath of cachePaths) {
    if (!fm.fileExists(candidatePath)) continue;
    try {
      cached = JSON.parse(fm.readString(candidatePath));
      break;
    } catch (_) {
      cached = null;
    }
  }

  const cacheAge = SETTINGS.weatherCacheMinutes * 60 * 1000;
  const sameLocation =
    cached &&
    finiteWeatherNumber(cached.latitude) !== null &&
    finiteWeatherNumber(cached.longitude) !== null &&
    Math.abs(Number(cached.latitude) - location.latitude) < 0.2 &&
    Math.abs(Number(cached.longitude) - location.longitude) < 0.2;
  const fetchedAt = finiteWeatherNumber(
    cached?.fetchedAt ?? cached?.updatedAt
  );
  const cacheFresh =
    sameLocation &&
    fetchedAt !== null &&
    Date.now() - fetchedAt < cacheAge;

  if (
    cacheFresh &&
    Array.isArray(cached.hours) &&
    weatherCacheHasFreshSamples(cached.hours, cacheAge, fetchedAt)
  ) {
    return buildHourlyWeather(cached.hours, cached.daily);
  }

  const storedCredentials = loadStoredForecaCredentials();
  const lastAttemptAt = Date.now();
  const [openMeteo, foreca] = await Promise.all([
    loadOpenMeteoWeather(location).catch(() => null),
    storedCredentials
      ? loadForecaForecast(location, storedCredentials).catch(() => null)
      : Promise.resolve(null),
  ]);
  const providerFetchedAt = Date.now();

  const cachedHours =
    sameLocation && Array.isArray(cached?.hours)
      ? cached.hours.map((hour) => ({
          ...hour,
          source: hour?.source ?? "cache",
          fetchedAt: hour?.fetchedAt ?? fetchedAt,
        }))
      : [];
  const mergedHours = mergeHourlyWeatherHours(
    cachedHours,
    (openMeteo?.hours ?? []).map((hour) => ({
      ...hour,
      source: "open-meteo",
      fetchedAt: providerFetchedAt,
    })),
    (foreca?.hours ?? []).map((hour) => ({
      ...hour,
      source: "foreca",
      fetchedAt: providerFetchedAt,
    }))
  );
  const mergedDaily = mergeDailyWeatherData(
    sameLocation
      ? tagDailyWeather(cached?.daily, "cache", fetchedAt)
      : null,
    tagDailyWeather(openMeteo?.daily, "open-meteo", providerFetchedAt),
    tagDailyWeather(foreca?.daily, "foreca", providerFetchedAt)
  );

  const hasFreshProviderData = [openMeteo, foreca].some(
    hasUsableWeatherPayload
  );

  if (!hasFreshProviderData) {
    return sameLocation && Array.isArray(cached?.hours)
      ? buildHourlyWeather(cached.hours, cached.daily)
      : emptyHourlyWeather();
  }

  if (
    mergedHours.length === 0 &&
    Object.keys(mergedDaily).length === 0
  ) {
    return emptyHourlyWeather();
  }

  const stored = {
    schemaVersion: 4,
    latitude: location.latitude,
    longitude: location.longitude,
    // fetchedAt só avança quando ao menos um provedor entrega dados
    // aproveitáveis. Uma tentativa sem resposta não rejuvenesce o cache.
    fetchedAt: Date.now(),
    lastAttemptAt,
    hours: mergedHours,
    daily: mergedDaily,
    sources: {
      cache: cachedHours.length > 0,
      openMeteo: hasUsableWeatherPayload(openMeteo),
      foreca: hasUsableWeatherPayload(foreca),
    },
  };
  try {
    fm.writeString(
      fm.joinPath(
        fm.documentsDirectory(),
        "Calendar-Timeline-weather-v3.json"
      ),
      JSON.stringify(stored)
    );
  } catch (_) {}

  return buildHourlyWeather(mergedHours, mergedDaily);
}

async function loadForecaForecast(location, credentials) {
  const token = await loadForecaToken(credentials);
  const timezone =
    Intl.DateTimeFormat().resolvedOptions().timeZone ||
    "America/Sao_Paulo";
  const locationPath = encodeURIComponent(
    `${location.longitude},${location.latitude}`
  );
  const query = [
    "periods=168",
    "tempunit=C",
    `tz=${encodeURIComponent(timezone)}`,
    "dataset=standard",
    "history=1",
    "rounding=0",
  ].join("&");
  const request = new Request(
    `${SETTINGS.forecaBaseURL}/api/v1/forecast/hourly/${locationPath}?${query}`
  );
  request.timeoutInterval = 12;
  request.headers = {
    Authorization: `Bearer ${token}`,
  };
  const response = await request.loadJSON();
  const hours = [];

  for (const forecast of response?.forecast ?? []) {
    const timestamp = new Date(String(forecast.time)).getTime();
    const temperature = finiteWeatherNumber(forecast.temperature);
    if (!Number.isFinite(timestamp) || temperature === null) {
      continue;
    }
    const rainChanceValue = firstFiniteWeatherNumber(
      forecast.precipProb,
      forecast.precipitationProbability,
      forecast.precipProbability,
      forecast.pp
    );
    const rainChance = Math.max(
      0,
      Math.min(100, rainChanceValue ?? 0)
    );
    const explicitRain = firstFiniteWeatherNumber(
      forecast.precip,
      forecast.precipitation,
      forecast.precipAmount,
      forecast.precipAccum,
      forecast.precipitationAmount,
      forecast.precipitationSum,
      forecast.rain,
      forecast.rainAmount,
      forecast.pr
    );
    const rainRate = firstFiniteWeatherNumber(
      forecast.precipRate
    );
    const rawCloudiness = firstFiniteWeatherNumber(
      forecast.cloudiness,
      forecast.cloudCover,
      forecast.c
    );
    hours.push({
      timestamp,
      // Na Foreca, precipProb representa a hora que termina no timestamp.
      rainStartTimestamp: timestamp - 60 * 60 * 1000,
      temperature,
      rainChance,
      rainMM: Math.max(
        0,
        Number.isFinite(explicitRain) ? explicitRain : 0
      ),
      rainRate: Math.max(
        0,
        Number.isFinite(rainRate) ? rainRate : 0
      ),
      symbol: String(forecast.symbol ?? ""),
      cloudiness: Number.isFinite(rawCloudiness)
        ? Math.max(0, Math.min(100, rawCloudiness))
        : null,
    });
  }

  return { hours, daily: {} };
}

async function loadOpenMeteoWeather(location) {
  const timezone =
    Intl.DateTimeFormat().resolvedOptions().timeZone ||
    "America/Sao_Paulo";
  const forecastDays = Math.max(
    1,
    Math.min(
      16,
      Number(SETTINGS.openMeteoForecastDays) || 5
    )
  );
  const query = [
    `latitude=${encodeURIComponent(location.latitude)}`,
    `longitude=${encodeURIComponent(location.longitude)}`,
    "hourly=temperature_2m,precipitation_probability,precipitation,cloud_cover,weather_code,is_day",
    "daily=temperature_2m_min,temperature_2m_max",
    `forecast_days=${forecastDays}`,
    "temperature_unit=celsius",
    "precipitation_unit=mm",
    `timezone=${encodeURIComponent(timezone)}`,
  ].join("&");
  const request = new Request(
    `${SETTINGS.openMeteoBaseURL}?${query}`
  );
  request.timeoutInterval = 12;
  const response = await request.loadJSON();
  const hourly = response?.hourly ?? {};
  const times = Array.isArray(hourly.time) ? hourly.time : [];
  const hours = [];

  for (let index = 0; index < times.length; index++) {
    const timestamp = parseWeatherTimestamp(times[index]);
    const temperature = finiteWeatherNumber(
      hourly.temperature_2m?.[index]
    );
    if (!Number.isFinite(timestamp) || temperature === null) {
      continue;
    }

    const rainChanceValue = finiteWeatherNumber(
      hourly.precipitation_probability?.[index]
    );
    const rainValue = finiteWeatherNumber(
      hourly.precipitation?.[index]
    );
    const rainChance = Math.max(
      0,
      Math.min(100, rainChanceValue ?? 0)
    );
    const rainMM = Math.max(
      0,
      rainValue ?? 0
    );
    const cloudinessValue = finiteWeatherNumber(
      hourly.cloud_cover?.[index]
    );
    const weatherCode = finiteWeatherNumber(
      hourly.weather_code?.[index]
    );
    const isDayValue = finiteWeatherNumber(hourly.is_day?.[index]);
    const isDay = isDayValue === null || isDayValue !== 0;

    hours.push({
      timestamp,
      rainStartTimestamp: timestamp - 60 * 60 * 1000,
      temperature,
      rainChance,
      rainMM,
      rainRate: 0,
      symbol:
        weatherCode === null
          ? ""
          : openMeteoWeatherSymbol(weatherCode, isDay),
      cloudiness: Number.isFinite(cloudinessValue)
        ? Math.max(0, Math.min(100, cloudinessValue))
        : null,
    });
  }

  const daily = {};
  const dailyTimes = Array.isArray(response?.daily?.time)
    ? response.daily.time
    : [];
  for (let index = 0; index < dailyTimes.length; index++) {
    const key = String(dailyTimes[index]).slice(0, 10);
    const minimum = finiteWeatherNumber(
      response.daily.temperature_2m_min?.[index]
    );
    const maximum = finiteWeatherNumber(
      response.daily.temperature_2m_max?.[index]
    );
    if (
      !/^\d{4}-\d{2}-\d{2}$/.test(key) ||
      minimum === null ||
      maximum === null ||
      minimum > maximum
    ) {
      continue;
    }
    daily[key] = { minimum, maximum };
  }

  return { hours, daily };
}

function parseWeatherTimestamp(value) {
  if (typeof value === "number" || /^\d+(\.\d+)?$/.test(String(value))) {
    const numeric = Number(value);
    if (!Number.isFinite(numeric)) return NaN;
    return numeric < 1e12 ? numeric * 1000 : numeric;
  }
  return new Date(String(value)).getTime();
}

function openMeteoWeatherSymbol(code, isDay) {
  if (!Number.isFinite(Number(code))) return "";
  const prefix = isDay ? "d" : "n";
  let group = 1;
  if ([1, 2].includes(code)) group = 2;
  else if (code === 3) group = 3;
  else if ([45, 48].includes(code)) group = 9;
  else if ([51, 53, 55, 56, 57].includes(code)) group = 4;
  else if ([61, 63, 65, 66, 67, 80, 81, 82].includes(code)) group = 5;
  else if ([71, 73, 75, 77, 85, 86].includes(code)) group = 7;
  else if ([95, 96, 99].includes(code)) group = 6;
  return `${prefix}${group}`;
}

function mergeDailyWeatherData(...dailySets) {
  const merged = {};
  for (const daily of dailySets) {
    for (const [key, values] of Object.entries(daily ?? {})) {
      const minimum = finiteWeatherNumber(values?.minimum);
      const maximum = finiteWeatherNumber(values?.maximum);
      if (
        minimum === null ||
        maximum === null ||
        minimum > maximum
      ) {
        continue;
      }
      merged[key] = {
        minimum,
        maximum,
        source: values?.source ?? "unknown",
      };
    }
  }
  return merged;
}

function mergeHourlyWeatherHours(...hourSets) {
  const byTimestamp = new Map();

  // A ordem de prioridade é: cache antigo, Open-Meteo e, por último,
  // Foreca quando houver credenciais armazenadas.
  for (const hours of hourSets) {
    for (const hour of hours ?? []) {
      const timestamp = finiteWeatherNumber(hour?.timestamp);
      const temperature = finiteWeatherNumber(hour?.temperature);
      if (timestamp !== null && temperature !== null) {
        byTimestamp.set(timestamp, {
          ...hour,
          timestamp,
          temperature,
          source: hour?.source ?? "unknown",
        });
      }
    }
  }

  // Mantém o dia anterior para preservar extremos que ainda possam aparecer
  // na janela móvel e limita o cache ao período necessário para os quatro
  // cartões e para a janela máxima de 96 horas.
  const retentionStart = addDays(startOfDay(windowStart), -1).getTime();
  const retentionEnd = new Date(
    weatherDataRequiredEnd().getTime() + 2 * 24 * 60 * 60 * 1000
  ).getTime();

  return [...byTimestamp.values()]
    .filter((hour) => {
      const timestamp = Number(hour.timestamp);
      return (
        timestamp >= retentionStart &&
        timestamp < retentionEnd
      );
    })
    .sort(
      (first, second) =>
        Number(first.timestamp) - Number(second.timestamp)
    );
}

async function showForecaConnectionError(error) {
  const alert = new Alert();
  alert.title = "Não foi possível conectar à Foreca";
  alert.message =
    "Confira o usuário e a senha da Weather API ou a conexão com a internet. A última previsão armazenada continuará sendo usada quando estiver disponível.\n\n" +
    String(error);
  alert.addAction("Manter credenciais");
  alert.addDestructiveAction("Apagar e digitar novamente");
  const selected = await alert.presentAlert();
  if (selected === 1) clearForecaCredentials();
}

function clearForecaCredentials() {
  for (const key of [
    "Calendar-Timeline-Foreca-Username-v1",
    "Calendar-Timeline-Foreca-Password-v1",
    "Calendar-Timeline-Foreca-Token-v1",
  ]) {
    try {
      if (Keychain.contains(key)) Keychain.remove(key);
    } catch (_) {}
  }
}

async function loadForecaCredentials() {
  const usernameKey = "Calendar-Timeline-Foreca-Username-v1";
  const passwordKey = "Calendar-Timeline-Foreca-Password-v1";

  try {
    if (Keychain.contains(usernameKey) && Keychain.contains(passwordKey)) {
      return {
        user: Keychain.get(usernameKey),
        password: Keychain.get(passwordKey),
      };
    }
  } catch (_) {}

  // A pergunta aparece somente ao executar o script dentro do Scriptable.
  if (config.runsInWidget) return null;

  const alert = new Alert();
  alert.title = "Conectar à Foreca";
  alert.message =
    "Digite o usuário e a senha da Weather API. Eles serão guardados somente no Keychain deste iPhone e não serão enviados ao GitHub.";
  alert.addTextField("Usuário Foreca", "");
  alert.addSecureTextField("Senha Foreca", "");
  alert.addAction("Salvar e conectar");
  alert.addCancelAction("Cancelar");
  const selected = await alert.presentAlert();
  if (selected !== 0) return null;

  const user = alert.textFieldValue(0).trim();
  const password = alert.textFieldValue(1);
  if (!user || !password) return null;

  Keychain.set(usernameKey, user);
  Keychain.set(passwordKey, password);
  Keychain.set("Calendar-Timeline-Foreca-Token-v1", "");
  return { user, password };
}

async function loadForecaToken(credentials) {
  const tokenKey = "Calendar-Timeline-Foreca-Token-v1";

  try {
    if (Keychain.contains(tokenKey)) {
      const cached = JSON.parse(Keychain.get(tokenKey));
      if (
        cached.accessToken &&
        Number(cached.expiresAt) > Date.now() + 5 * 60 * 1000
      ) {
        return cached.accessToken;
      }
    }
  } catch (_) {}

  const request = new Request(
    `${SETTINGS.forecaBaseURL}/authorize/token?expire_hours=${SETTINGS.forecaTokenHours}`
  );
  request.method = "POST";
  request.timeoutInterval = 12;
  request.headers = { "Content-Type": "application/json" };
  request.body = JSON.stringify(credentials);
  const response = await request.loadJSON();
  const accessToken = response?.access_token;
  if (!accessToken) {
    throw new Error("A Foreca não forneceu um token de acesso.");
  }

  const expiresIn = Math.max(300, Number(response.expires_in) || 3600);
  try {
    Keychain.set(
      tokenKey,
      JSON.stringify({
        accessToken,
        expiresAt: Date.now() + expiresIn * 1000,
      })
    );
  } catch (_) {}
  return accessToken;
}

function buildHourlyWeather(hours, dailyOverrides = {}) {
  const normalized = (Array.isArray(hours) ? hours : [])
    .map((hour) => {
      const cloudinessSource = hour?.cloudiness;
      const cloudiness =
        cloudinessSource === null ||
        cloudinessSource === undefined ||
        cloudinessSource === "" ||
        !Number.isFinite(Number(cloudinessSource))
          ? null
          : Math.max(0, Math.min(100, Number(cloudinessSource)));

      const timestamp = finiteWeatherNumber(hour?.timestamp);
      const temperature = finiteWeatherNumber(hour?.temperature);
      const rainStartTimestamp = finiteWeatherNumber(
        hour?.rainStartTimestamp
      );
      const rainChanceValue = finiteWeatherNumber(hour?.rainChance);
      const rainMMValue = finiteWeatherNumber(hour?.rainMM);
      const rainRateValue = finiteWeatherNumber(hour?.rainRate);

      return {
        timestamp,
        rainStartTimestamp:
          rainStartTimestamp ??
          (timestamp === null ? null : timestamp - WEATHER_HOUR_MS),
        temperature,
        rainChance: Math.max(
          0,
          Math.min(100, rainChanceValue ?? 0)
        ),
        rainMM: Math.max(0, rainMMValue ?? 0),
        rainRate: Math.max(0, rainRateValue ?? 0),
        symbol: String(hour.symbol ?? ""),
        cloudiness,
        source: String(hour.source ?? "unknown"),
      };
    })
    .filter(
      (hour) =>
        hour.timestamp !== null &&
        hour.temperature !== null
    );
  const daily = {};

  // Resumos diários válidos são a fonte preferencial para o cartão, mesmo
  // quando a série horária do mesmo dia está apenas parcialmente disponível.
  for (const [key, values] of Object.entries(dailyOverrides ?? {})) {
    const minimum = finiteWeatherNumber(values?.minimum);
    const maximum = finiteWeatherNumber(values?.maximum);
    if (
      minimum !== null &&
      maximum !== null &&
      minimum <= maximum
    ) {
      daily[key] = {
        minimum,
        maximum,
        source: values?.source ?? "daily",
      };
    }
  }

  for (const hour of normalized) {
    const key = dateKey(new Date(hour.timestamp));
    if (!daily[key]) {
      daily[key] = {
        minimum: hour.temperature,
        maximum: hour.temperature,
      };
    } else {
      daily[key].minimum = Math.min(
        daily[key].minimum,
        hour.temperature
      );
      daily[key].maximum = Math.max(
        daily[key].maximum,
        hour.temperature
      );
    }
  }

  const dailyRainTotals = {};
  for (const hour of normalized) {
    const key = dateKey(new Date(hour.timestamp));
    dailyRainTotals[key] =
      (dailyRainTotals[key] || 0) + Math.max(0, hour.rainMM);
  }

  const enrichedHours = normalized.map((hour) => ({
    ...hour,
    dailyRainMM:
      dailyRainTotals[dateKey(new Date(hour.timestamp))] || 0,
  }));

  return { hours: enrichedHours, daily };
}

async function loadNightTextures() {
  const variants = [
    ["evening", "night-sky-18-00.base64.txt"],
    ["morning", "night-sky-00-06.base64.txt"],
  ];
  const entries = await Promise.all(
    variants.map(async ([variant, fileName]) => [
