function calculateScheduleSummary(events, rangeStart, rangeEnd) {
  const intervals = events
    .filter((event) => {
      const isAllDay = Boolean(event.isAllDay);
      const availability = event.availability ?? "busy";
      return !isAllDay && availability !== "free";
    })
    .map((event) => ({
      start: new Date(
        Math.max(
          rangeStart.getTime(),
          (event.start ?? event.startDate).getTime()
        )
      ),
      end: new Date(
        Math.min(
          rangeEnd.getTime(),
          (event.end ?? event.endDate).getTime()
        )
      ),
    }))
    .filter((interval) => interval.end > interval.start)
    .sort((a, b) => a.start.getTime() - b.start.getTime());

  const merged = [];
  for (const interval of intervals) {
    const last = merged[merged.length - 1];
    if (last && interval.start <= last.end) {
      if (interval.end > last.end) last.end = interval.end;
    } else {
      merged.push({ ...interval });
    }
  }

  const busyMinutes = Math.round(
    merged.reduce(
      (total, interval) => total + interval.end - interval.start,
      0
    ) / 60000
  );
  const totalMinutes = Math.max(
    0,
    Math.round((rangeEnd - rangeStart) / 60000)
  );
  return {
    intervals: merged,
    busyMinutes,
    freeMinutes: Math.max(0, totalMinutes - busyMinutes),
  };
}

function prepareTimelineItems(items, referenceDate) {
  const prepared = items.map((item) => ({ ...item }));
  const events = prepared.filter(
    (item) => item.kind === "event" && !item.isAllDay
  );

  for (const event of events) {
    event.isCurrentEvent =
      event.start <= referenceDate && event.end > referenceDate;
    event.conflictCount = events.filter(
      (candidate) => candidate !== event && itemsOverlap(event, candidate)
    ).length;
  }

  // Um evento em andamento já é classificado como "AGORA"; o próximo
  // compromisso precisa começar depois do instante atual.
  const nextEvent = events
    .filter((event) => event.start > referenceDate)
    .sort(
      (a, b) =>
        a.start.getTime() - b.start.getTime() ||
        a.end.getTime() - b.end.getTime()
    )[0];
  if (nextEvent) nextEvent.isNextEvent = true;
  return prepared;
}


function chooseItems(items, referenceDate, limit) {
  const relevant = [...items].filter(
    (item) => item.isAllDay || item.end >= referenceDate
  );

  const byTime = (a, b) =>
    a.start.getTime() - b.start.getTime() ||
    a.end.getTime() - b.end.getTime();

  // A concatenação é reiniciada em cada dia. Assim, um item de amanhã
  // nunca desloca a posição vertical de um item de hoje.
  const byDay = new Map();
  for (const item of relevant) {
    const key = dateKey(item.start);
    if (!byDay.has(key)) byDay.set(key, []);
    byDay.get(key).push(item);
  }

  const placed = [];
  const hidden = [];

  for (const dayItems of byDay.values()) {
    const rows = Array.from({ length: limit }, () => []);
    const isAllDayEvent = (item) =>
      item.kind === "event" && item.isAllDay;

    const placeItem = (item, rowOrder) => {
      const availableRow = rowOrder.find((row) =>
        rows[row].every((existing) => !itemsOverlap(item, existing))
      );

      if (availableRow === undefined) {
        hidden.push(item);
        return;
      }

      const positioned = { ...item, gridRow: availableRow };
      rows[availableRow].push(positioned);
      placed.push(positioned);
    };

    // Eventos e lembretes com horário aparecem primeiro, em ordem
    // cronológica, ocupando as linhas de cima para baixo.
    const regularItems = [...dayItems]
      .filter((item) => !isAllDayEvent(item))
      .sort(byTime);

    regularItems.forEach((item, index) => {
      const preferredRow = Math.min(index, limit - 1);
      const upperRows = [];
      for (let row = preferredRow - 1; row >= 0; row--) {
        upperRows.push(row);
      }
      const lowerRows = [];
      for (let row = preferredRow + 1; row < limit; row++) {
        lowerRows.push(row);
      }

      placeItem(item, [preferredRow, ...upperRows, ...lowerRows]);
    });

    // Eventos de dia inteiro continuam sendo os últimos na ordem de
    // exibição, mas ocupam as linhas disponíveis de baixo para cima:
    // quinta, quarta, terceira, segunda e primeira.
    const allDayEvents = [...dayItems]
      .filter(isAllDayEvent)
      .sort(byTime);
    const bottomUpRows = Array.from(
      { length: limit },
      (_, index) => limit - 1 - index
    );

    allDayEvents.forEach((item) => {
      placeItem(item, bottomUpRows);
    });
  }

  // Excedentes são agrupados somente com itens ocultos do mesmo dia.
  const overflowByDay = new Map();
  for (const item of hidden) {
    const key = dateKey(item.start);
    if (!overflowByDay.has(key)) overflowByDay.set(key, []);
    overflowByDay.get(key).push(item);
  }

  const overflowMarkers = [];
  for (const hiddenItems of overflowByDay.values()) {
    for (const group of groupOverflowItems(hiddenItems)) {
      overflowMarkers.push({
        kind: "overflow",
        title: "+" + group.count,
        start: group.start,
        end: group.end,
        gridRow: limit - 1,
        isOverflow: true,
        color: SETTINGS.overflowColor,
      });
    }
  }

  return [...placed, ...overflowMarkers];
}

function isCompactMode() {
  return windowHours > SETTINGS.compactModeFromHours;
}

function isExtendedDetailedMode() {
  return windowHours > 24 && !isCompactMode();
}

function itemImportance(item) {
  if (item.isCurrentEvent) return 110;
  if (item.isNextEvent) return 100;
  if (item.isOverdue) return 95;
  if (item.kind === "reminder" && item.priority > 0 && item.priority <= 4) {
    return 85;
  }
  if (item.conflictCount > 0) return 75;
  if (item.kind === "reminder" && item.priority > 0) return 65;
  if (!item.isAllDay) return 40;
  return 20;
}

function itemsOverlap(first, second) {
  const firstStart = first.start.getTime();
  const secondStart = second.start.getTime();
  const firstEnd = effectiveItemEnd(first);
  const secondEnd = effectiveItemEnd(second);

  // Um item que começa exatamente quando o outro termina pode reutilizar
  // a mesma linha.
  return firstStart < secondEnd && secondStart < firstEnd;
}

function effectiveItemEnd(item) {
  const start = item.start.getTime();
  const end = item.end.getTime();
  return Math.max(end, start + 60 * 1000);
}

function groupOverflowItems(items) {
  const sorted = [...items].sort(
    (a, b) => a.start.getTime() - b.start.getTime()
  );
  const groups = [];

  for (const item of sorted) {
    const start = item.start.getTime();
    const end = effectiveItemEnd(item);
    const current = groups[groups.length - 1];

    if (current && start < current.end.getTime()) {
      current.end = new Date(
        Math.max(current.end.getTime(), end)
      );
      current.count++;
    } else {
      groups.push({
        start: new Date(start),
        end: new Date(end),
        count: 1,
      });
    }
  }

  return groups;
}

