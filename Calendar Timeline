function makeAccessoryWidget(items, result, family) {
  const widget = new ListWidget();
  widget.setPadding(4, 6, 4, 6);
  widget.addAccessoryWidgetBackground = true;
  const nextEvent = findNextAccessoryEvent(items);
  const todayLabel = formatDate(now, "EEE d").toLocaleUpperCase("pt-BR");

  if (family === "accessoryInline") {
    const text = widget.addText(
      nextEvent
        ? `CAL · ${accessoryEventStatus(nextEvent)} · ${nextEvent.title}`
        : `CAL · ${result.todayEventCount} EVENTOS · ${result.todayReminderCount} LEMBRETES`
    );
    text.font = Font.boldSystemFont(12);
    text.textColor = Color.white();
    text.lineLimit = 1;
    text.minimumScaleFactor = 0.65;
    return widget;
  }

  if (family === "accessoryCircular") {
    const day = widget.addText(String(now.getDate()));
    day.centerAlignText();
    day.font = Font.blackRoundedSystemFont(28);
    day.textColor = Color.white();
    day.minimumScaleFactor = 0.65;
    const counts = widget.addText(
      `E${result.todayEventCount} · L${result.todayReminderCount}`
    );
    counts.centerAlignText();
    counts.font = Font.boldSystemFont(9);
    counts.textColor = Color.white();
    counts.minimumScaleFactor = 0.55;
    return widget;
  }

  const header = widget.addText(todayLabel);
  header.font = Font.blackRoundedSystemFont(12);
  header.textColor = Color.white();
  header.lineLimit = 1;
  widget.addSpacer(2);

  const title = widget.addText(
    nextEvent ? nextEvent.title.toLocaleUpperCase("pt-BR") : "SEM PRÓXIMO EVENTO"
  );
  title.font = Font.boldRoundedSystemFont(13);
  title.textColor = Color.white();
  title.lineLimit = 1;
  title.minimumScaleFactor = 0.62;

  const detail = widget.addText(
    nextEvent
      ? `${accessoryEventStatus(nextEvent)}  ·  ${result.todayReminderCount} LEMBRETES`
      : `${result.todayEventCount} EVENTOS  ·  ${result.todayReminderCount} LEMBRETES`
  );
  detail.font = Font.mediumSystemFont(10);
  detail.textColor = new Color("#FFFFFF", 0.78);
  detail.lineLimit = 1;
  detail.minimumScaleFactor = 0.6;
  return widget;
}

function findNextAccessoryEvent(items) {
  return [...items]
    .filter(
      (item) =>
        item.kind === "event" &&
        !item.isAllDay &&
        item.end.getTime() > now.getTime()
    )
    .sort((a, b) => a.start.getTime() - b.start.getTime())[0] ?? null;
}

function accessoryEventStatus(event) {
  if (event.start <= now && event.end > now) return "AGORA";
  const minutes = Math.max(
    0,
    Math.round((event.start.getTime() - now.getTime()) / 60000)
  );
  if (minutes < 60) return `EM ${minutes} MIN`;
  if (minutes < 24 * 60) {
    const hours = Math.floor(minutes / 60);
    const remainder = minutes % 60;
    return remainder ? `EM ${hours}H${String(remainder).padStart(2, "0")}` : `EM ${hours}H`;
  }
  return formatDate(event.start, "EEE HH:mm").toLocaleUpperCase("pt-BR");
}

function renderWidget(items, loadError) {
  const ctx = new DrawContext();
  ctx.size = new Size(CANVAS.width, CANVAS.height);
  ctx.opaque = true;
  ctx.respectScreenScale = false;

  // O fundo é desenhado na própria imagem. Isso evita que o Scriptable
  // substitua os textos e charts ao combinar backgroundGradient/backgroundImage.
  drawIOSDarkGradient(ctx);

  // A timeline mantém o mesmo fundo em todos os dias.
  drawTimelineBackground(ctx);

  drawDatePanel(ctx, loadResult.holidayDates);
  const timelineImage = renderTimelinePanel(items, loadError);
  ctx.drawImageInRect(
    timelineImage,
    new Rect(
      CANVAS.plotLeft,
      CANVAS.timelineTop,
      timelineWidth(),
      timelineHeight()
    )
  );
  drawTemperatureFooter(ctx, hourlyWeather);

  return ctx.getImage();
}

