async function loadWindow() {
  try {
    // No primeiro uso dentro do app, estas consultas exibem os pedidos
    // nativos de acesso ao Calendário e aos Lembretes.
    // Lembretes sem horário podem chegar do EventKit como 00:00 UTC. Em
    // fusos negativos, isso aparece localmente na noite do dia anterior.
    // A margem de um dia garante que eles entrem na consulta; abaixo a data
    // é normalizada antes de decidir se pertence à janela visível.
    const reminderQueryStart = addDays(startOfToday(), -1);
    const reminderQueryEnd = addDays(startOfDay(windowEnd), 1);
    const [
      events,
      reminders,
      todayEventsRaw,
      todayRemindersRaw,
      scheduledReminders,
    ] =
      await Promise.all([
        CalendarEvent.between(windowStart, windowEnd),
        Reminder.incompleteDueBetween(reminderQueryStart, reminderQueryEnd),
        CalendarEvent.today(),
        Reminder.incompleteDueToday(),
        SETTINGS.showOverdueReminders
          ? Reminder.scheduled()
          : Promise.resolve([]),
      ]);

    const excluded = new Set(
      SETTINGS.excludedCalendars.map((name) => name.toLocaleLowerCase())
    );
    const selected = new Set(SETTINGS.selectedCalendarIdentifiers ?? []);

    const includeCalendar = (calendar) => {
      const calendarName = calendar?.title ?? "";
      const isSelected =
        selected.size === 0 || selected.has(calendar?.identifier);
      return (
        isSelected &&
        !excluded.has(calendarName.toLocaleLowerCase())
      );
    };

    const todayEvents = todayEventsRaw.filter((event) =>
      includeCalendar(event.calendar)
    );

    // O EventKit pode devolver um lembrete recorrente encontrado por
    // incompleteDueToday() mantendo em dueDate a data-base da série. Nesse
    // caso, materializamos uma ocorrência de hoje sem alterar o lembrete
    // original. O horário é preservado; lembretes sem horário usam o dia.
    const reminderOccurrenceView = (reminder, forcedDayStart = null) => {
      const hasTime = Boolean(reminder.dueDateIncludesTime);
      const originalDue = reminder.dueDate;
      let effectiveDue = originalDue;

      if (forcedDayStart) {
        effectiveDue = new Date(forcedDayStart);
        if (hasTime && originalDue) {
          effectiveDue.setHours(
            originalDue.getHours(),
            originalDue.getMinutes(),
            originalDue.getSeconds(),
            0
          );
        }
      }

      return {
        identifier: reminder.identifier,
        title: reminder.title,
        calendar: reminder.calendar,
        priority: reminder.priority,
        dueDate: effectiveDue,
        dueDateIncludesTime: hasTime,
      };
    };

    // A consulta por intervalo cobre a janela completa. A consulta específica
    // de hoje é convertida em ocorrências reais de hoje e funciona como fonte
    // autoritativa para séries recorrentes (inclusive a cada 30 dias).
    const rangeReminderViews = reminders.map((reminder) =>
      reminderOccurrenceView(reminder)
    );
    const todayOccurrenceViews = todayRemindersRaw.map((reminder) =>
      reminderOccurrenceView(reminder, startOfToday())
    );

    const reminderOccurrenceKey = (reminder) => {
      const due = reminder.dueDate;
      const dayStart = normalizedReminderDayStart(reminder);
      const sourceIdentifier =
        reminder.identifier ??
        `${reminder.calendar?.identifier ?? reminder.calendar?.title ?? ""}-${reminder.title ?? ""}`;
      const occurrence =
        Boolean(reminder.dueDateIncludesTime) && due
          ? due.getTime()
          : dayStart
            ? dateKey(dayStart)
            : "sem-data";
      return `${sourceIdentifier}::${occurrence}`;
    };

    const displayReminderMap = new Map();
    for (const reminder of [
      ...rangeReminderViews,
      ...todayOccurrenceViews,
    ]) {
      if (
        !normalizedReminderDayStart(reminder) ||
        !includeCalendar(reminder.calendar)
      ) {
        continue;
      }
      displayReminderMap.set(reminderOccurrenceKey(reminder), reminder);
    }

    const displayReminders = [...displayReminderMap.values()];
    const todayReminders = displayReminders.filter((reminder) => {
      const dayStart = normalizedReminderDayStart(reminder);
      return dayStart && dateKey(dayStart) === dateKey(now);
    });

    const eventItems = events
      .filter((event) => {
        return includeCalendar(event.calendar);
      })
      .map((event) => ({
        kind: "event",
        title: cleanTitle(event.title, "Evento"),
        calendarTitle: event.calendar?.title ?? "Calendário",
        start: event.startDate,
        end: event.endDate,
        isAllDay: Boolean(event.isAllDay),
        identifier: event.identifier ?? `${event.title}-${event.startDate}`,
        location: cleanOptionalText(event.location),
        notes: cleanOptionalText(event.notes),
        attendeeCount: Array.isArray(event.attendees)
          ? event.attendees.filter((attendee) => !attendee.isCurrentUser).length
          : 0,
        participationStatus: currentUserParticipationStatus(event.attendees),
        availability: event.availability ?? "busy",
        hasVideoLink: eventHasVideoLink(event),
        color: safeCalendarColor(
          event.calendar,
          SETTINGS.fallbackEventColor
        ),
      }));

    const reminderItems = displayReminders
      .filter((reminder) => {
        const dayStart = normalizedReminderDayStart(reminder);
        if (!dayStart || !includeCalendar(reminder.calendar)) return false;
        const dayEnd = addDays(dayStart, 1);
        return dayEnd > windowStart && dayStart < windowEnd;
      })
      .flatMap((reminder) => {
        const due = reminder.dueDate ?? startOfToday();
        const hasTime = Boolean(reminder.dueDateIncludesTime);
        const reminderDayStart = normalizedReminderDayStart(reminder);
        const reminderDayEnd = addDays(reminderDayStart, 1);
        const reminderCutoff = reminderDayEnd;
        const reminderDisplayStart = hasTime
          ? due
          : dateAtHour(reminderDayStart, SETTINGS.daylightStartHour);
        const identifier =
          reminder.identifier ?? `${reminder.title}-${due}`;
        const baseItem = {
          kind: "reminder",
          title: cleanTitle(reminder.title, "Lembrete"),
          calendarTitle: reminder.calendar?.title ?? "Lembretes",
          // Mesmo quando a origem é "dia inteiro", o chart possui agora um
          // intervalo horário definido e não deve sobreviver ao próprio fim.
          isAllDay: false,
          sourceIsAllDay: !hasTime,
          identifier,
          priority: Number(reminder.priority) || 0,
          color: safeCalendarColor(
            reminder.calendar,
            SETTINGS.fallbackReminderColor
          ),
        };

        // O lembrete permanece visível desde o horário de início até
        // 00:00 do próprio dia. Se continuar pendente, ele reaparece no
        // dia seguinte como atrasado durante todo o dia.
        const segments = [];
        if (reminderDisplayStart < reminderCutoff) {
          segments.push({
            ...baseItem,
            start: reminderDisplayStart,
            end: reminderCutoff,
            isOverdue: false,
          });
        }

        return segments;
      });

    const reminderIdentifiers = new Set(
      reminderItems.map((item) => item.identifier)
    );
    const overdueReminderItems = scheduledReminders
      .filter((reminder) => {
        const due = reminder.dueDate;
        const dueDayStart = normalizedReminderDayStart(reminder);
        if (!due || !dueDayStart || dueDayStart >= startOfToday()) return false;
        if (!includeCalendar(reminder.calendar)) return false;
        const identifier = reminder.identifier ?? `${reminder.title}-${due}`;
        return !reminderIdentifiers.has(identifier);
      })
      .map((reminder) => ({
        kind: "reminder",
        title: cleanTitle(reminder.title, "Lembrete"),
        calendarTitle: reminder.calendar?.title ?? "Lembretes",
        // No dia seguinte, um lembrete ainda pendente reaparece como
        // atrasado desde 00:00 até 00:00 do dia seguinte.
        start: startOfToday(),
        end: addDays(startOfToday(), 1),
        isAllDay: false,
        identifier: reminder.identifier ?? `${reminder.title}-${reminder.dueDate}`,
        priority: Number(reminder.priority) || 0,
        isOverdue: true,
        color: safeCalendarColor(
          reminder.calendar,
          SETTINGS.fallbackReminderColor
        ),
      }));

    const holidayDates = new Set(
      [...events, ...todayEvents]
        .filter(isHolidayEvent)
        .map((event) => dateKey(event.startDate))
    );

    const todayScheduleSummary = calculateScheduleSummary(
      todayEvents,
      startOfToday(),
      addDays(startOfToday(), 1)
    );

    return {
      items: [...eventItems, ...reminderItems, ...overdueReminderItems],
      todayEventCount: todayEvents.length,
      todayReminderCount: todayReminders.length,
      todayBusyMinutes: todayScheduleSummary.busyMinutes,
      todayFreeMinutes: todayScheduleSummary.freeMinutes,
      holidayDates,
      error: null,
    };
  } catch (error) {
    return {
      items: [],
      todayEventCount: 0,
      todayReminderCount: 0,
      todayBusyMinutes: 0,
      todayFreeMinutes: 24 * 60,
      holidayDates: new Set(),
      error: String(error),
    };
  }
}

async function loadAstronomy() {
  const fallback = {
    latitude: SETTINGS.fallbackLatitude,
    longitude: SETTINGS.fallbackLongitude,
  };
  if (!SETTINGS.useCurrentLocation) return fallback;

  const cacheKey = "agenda-timeline-location-v1";
  let cachedLocation = null;

  try {
    if (Keychain.contains(cacheKey)) {
      cachedLocation = JSON.parse(Keychain.get(cacheKey));
      const maximumAge = SETTINGS.locationCacheHours * 60 * 60 * 1000;
      if (
        Number.isFinite(cachedLocation.latitude) &&
        Number.isFinite(cachedLocation.longitude) &&
        Date.now() - cachedLocation.updatedAt < maximumAge
      ) {
        return cachedLocation;
      }
    }
  } catch (_) {
    cachedLocation = null;
  }

  try {
    Location.setAccuracyToThreeKilometers();
    const currentLocation = await Location.current();
    const location = {
      latitude: currentLocation.latitude,
      longitude: currentLocation.longitude,
      updatedAt: Date.now(),
    };
    Keychain.set(cacheKey, JSON.stringify(location));
    return location;
  } catch (_) {
    // Mesmo quando a localização falhar, aguarda seis horas antes de tentar
    // novamente. Isso impede novas consultas a cada refresh de um minuto.
    const offlineLocation = {
      latitude: cachedLocation?.latitude ?? fallback.latitude,
      longitude: cachedLocation?.longitude ?? fallback.longitude,
      updatedAt: Date.now(),
    };
    try {
      Keychain.set(cacheKey, JSON.stringify(offlineLocation));
    } catch (_) {}
    return offlineLocation;
  }
}

function emptyHourlyWeather() {
  return { hours: [], daily: {} };
}

async function loadHourlyWeather(location) {
  const fm = FileManager.local();
  const cachePath = fm.joinPath(
    fm.documentsDirectory(),
    "Calendar-Timeline-foreca-weather-v1.json"
  );
  let cached = null;

  if (fm.fileExists(cachePath)) {
    try {
      cached = JSON.parse(fm.readString(cachePath));
    } catch (_) {
      cached = null;
    }
  }

  const cacheAge = SETTINGS.weatherCacheMinutes * 60 * 1000;
  const sameLocation =
    cached &&
    Math.abs(Number(cached.latitude) - location.latitude) < 0.2 &&
    Math.abs(Number(cached.longitude) - location.longitude) < 0.2;

  if (
    sameLocation &&
    Array.isArray(cached.hours) &&
    Date.now() - Number(cached.updatedAt || 0) < cacheAge
  ) {
    return buildHourlyWeather(cached.hours);
  }

  try {
    const credentials = await loadForecaCredentials();
    if (!credentials) {
      return Array.isArray(cached?.hours)
        ? buildHourlyWeather(cached.hours)
        : emptyHourlyWeather();
    }
    const token = await loadForecaToken(credentials);
    const timezone =
      Intl.DateTimeFormat().resolvedOptions().timeZone ||
      "America/Sao_Paulo";
    const locationPath = encodeURIComponent(
      `${location.longitude},${location.latitude}`
    );
    const query = [
      "periods=168",
      "tempunit=C",
      `tz=${encodeURIComponent(timezone)}`,
      "dataset=standard",
      "history=1",
      "rounding=0",
    ].join("&");
    const request = new Request(
      `${SETTINGS.forecaBaseURL}/api/v1/forecast/hourly/${locationPath}?${query}`
    );
    request.timeoutInterval = 12;
    request.headers = {
      Authorization: `Bearer ${token}`,
    };
    const response = await request.loadJSON();
    const hours = [];

    for (const forecast of response?.forecast ?? []) {
      const timestamp = new Date(String(forecast.time)).getTime();
      const temperature = Number(forecast.temperature);
      if (!Number.isFinite(timestamp) || !Number.isFinite(temperature)) {
        continue;
      }
      hours.push({
        timestamp,
        // Na Foreca, precipProb representa a hora que termina no timestamp.
        rainStartTimestamp: timestamp - 60 * 60 * 1000,
        temperature,
        rainChance: Math.max(
          0,
          Math.min(100, Number(forecast.precipProb) || 0)
        ),
      });
    }

    const stored = {
      latitude: location.latitude,
      longitude: location.longitude,
      updatedAt: Date.now(),
      hours,
    };
    try {
      fm.writeString(cachePath, JSON.stringify(stored));
    } catch (_) {}
    return buildHourlyWeather(hours);
  } catch (error) {
    if (!config.runsInWidget) {
      await showForecaConnectionError(error);
    }
    return Array.isArray(cached?.hours)
      ? buildHourlyWeather(cached.hours)
      : emptyHourlyWeather();
  }
}

async function showForecaConnectionError(error) {
  const alert = new Alert();
  alert.title = "Não foi possível conectar à Foreca";
  alert.message =
    "Confira o usuário e a senha da Weather API ou a conexão com a internet. A última previsão armazenada continuará sendo usada quando estiver disponível.\n\n" +
    String(error);
  alert.addAction("Manter credenciais");
  alert.addDestructiveAction("Apagar e digitar novamente");
  const selected = await alert.presentAlert();
  if (selected === 1) clearForecaCredentials();
}

function clearForecaCredentials() {
  for (const key of [
    "Calendar-Timeline-Foreca-Username-v1",
    "Calendar-Timeline-Foreca-Password-v1",
    "Calendar-Timeline-Foreca-Token-v1",
  ]) {
    try {
      if (Keychain.contains(key)) Keychain.remove(key);
    } catch (_) {}
  }
}

async function loadForecaCredentials() {
  const usernameKey = "Calendar-Timeline-Foreca-Username-v1";
  const passwordKey = "Calendar-Timeline-Foreca-Password-v1";

  try {
    if (Keychain.contains(usernameKey) && Keychain.contains(passwordKey)) {
      return {
        user: Keychain.get(usernameKey),
        password: Keychain.get(passwordKey),
      };
    }
  } catch (_) {}

  // A pergunta aparece somente ao executar o script dentro do Scriptable.
  if (config.runsInWidget) return null;

  const alert = new Alert();
  alert.title = "Conectar à Foreca";
  alert.message =
    "Digite o usuário e a senha da Weather API. Eles serão guardados somente no Keychain deste iPhone e não serão enviados ao GitHub.";
  alert.addTextField("Usuário Foreca", "");
  alert.addSecureTextField("Senha Foreca", "");
  alert.addAction("Salvar e conectar");
  alert.addCancelAction("Cancelar");
  const selected = await alert.presentAlert();
  if (selected !== 0) return null;

  const user = alert.textFieldValue(0).trim();
  const password = alert.textFieldValue(1);
  if (!user || !password) return null;

  Keychain.set(usernameKey, user);
  Keychain.set(passwordKey, password);
  Keychain.set("Calendar-Timeline-Foreca-Token-v1", "");
  return { user, password };
}

async function loadForecaToken(credentials) {
  const tokenKey = "Calendar-Timeline-Foreca-Token-v1";

  try {
    if (Keychain.contains(tokenKey)) {
      const cached = JSON.parse(Keychain.get(tokenKey));
      if (
        cached.accessToken &&
        Number(cached.expiresAt) > Date.now() + 5 * 60 * 1000
      ) {
        return cached.accessToken;
      }
    }
  } catch (_) {}

  const request = new Request(
    `${SETTINGS.forecaBaseURL}/authorize/token?expire_hours=${SETTINGS.forecaTokenHours}`
  );
  request.method = "POST";
  request.timeoutInterval = 12;
  request.headers = { "Content-Type": "application/json" };
  request.body = JSON.stringify(credentials);
  const response = await request.loadJSON();
  const accessToken = response?.access_token;
  if (!accessToken) {
    throw new Error("A Foreca não forneceu um token de acesso.");
  }

  const expiresIn = Math.max(300, Number(response.expires_in) || 3600);
  try {
    Keychain.set(
      tokenKey,
      JSON.stringify({
        accessToken,
        expiresAt: Date.now() + expiresIn * 1000,
      })
    );
  } catch (_) {}
  return accessToken;
}

function buildHourlyWeather(hours) {
  const normalized = hours
    .map((hour) => ({
      timestamp: Number(hour.timestamp),
      rainStartTimestamp: Number(hour.rainStartTimestamp),
      temperature: Number(hour.temperature),
      rainChance: Math.max(
        0,
        Math.min(100, Number(hour.rainChance) || 0)
      ),
    }))
    .filter(
      (hour) =>
        Number.isFinite(hour.timestamp) &&
        Number.isFinite(hour.temperature)
    );
  const daily = {};

  for (const hour of normalized) {
    const key = dateKey(new Date(hour.timestamp));
    if (!daily[key]) {
      daily[key] = {
        minimum: hour.temperature,
        maximum: hour.temperature,
      };
    } else {
      daily[key].minimum = Math.min(
        daily[key].minimum,
        hour.temperature
      );
      daily[key].maximum = Math.max(
        daily[key].maximum,
        hour.temperature
      );
    }
  }

  return { hours: normalized, daily };
}

async function loadNightTextures() {
  const variants = [
    ["evening", "night-sky-18-00.base64.txt"],
    ["morning", "night-sky-00-06.base64.txt"],
  ];
  const entries = await Promise.all(
    variants.map(async ([variant, fileName]) => [
      variant,
      await loadNightTexture(variant, fileName),
    ])
  );
  return Object.fromEntries(entries);
}

async function loadNightTexture(variant, fileName) {
  const fm = FileManager.local();
  const version = SETTINGS.nightTextureVersion;
  const cachePath = fm.joinPath(
    fm.documentsDirectory(),
    `Calendar-Timeline-night-${variant}-${version}.jpg`
  );

  if (fm.fileExists(cachePath)) {
    try {
      return fm.readImage(cachePath);
    } catch (_) {}
  }

  try {
    const request = new Request(
      `${SETTINGS.nightTextureBaseURL}/${fileName}?v=${version}`
    );
    request.timeoutInterval = 12;
    const encoded = (await request.loadString()).trim();
    const image = Image.fromData(Data.fromBase64String(encoded));
    try {
      fm.writeImage(cachePath, image);
    } catch (_) {}
    return image;
  } catch (_) {
    return null;
  }
}

async function loadAutomaticHolidays(location) {
  const dates = new Set();
  if (!SETTINGS.automaticHolidays) return dates;

  const years = new Set([
    windowStart.getFullYear(),
    windowEnd.getFullYear(),
  ]);
  const region = await resolveBrazilianRegion(location);

  for (const year of years) {
    brazilianNationalHolidayDates(year).forEach((key) => dates.add(key));
    if (!region) continue;

    const regionalDates = await loadRegionalHolidayDates(year, region);
    regionalDates.forEach((key) => dates.add(key));
  }

  return dates;
}

async function resolveBrazilianRegion(location) {
  const cacheKey = "agenda-timeline-region-v2";
  const maximumAge = SETTINGS.holidayCacheDays * 86400000;

  try {
    if (Keychain.contains(cacheKey)) {
      const cached = JSON.parse(Keychain.get(cacheKey));
      const nearby =
        Math.abs(cached.latitude - location.latitude) < 0.25 &&
        Math.abs(cached.longitude - location.longitude) < 0.25;
      if (nearby && Date.now() - cached.updatedAt < maximumAge) {
        return cached;
      }
    }
  } catch (_) {}

  let city = null;
  let uf = null;
  try {
    const placemarks = await Location.reverseGeocode(
      location.latitude,
      location.longitude,
      SETTINGS.locale
    );
    const placemark = placemarks?.[0] ?? {};
    const address = placemark.postalAddress ?? {};
    city =
      address.city ??
      address.subAdministrativeArea ??
      placemark.locality ??
      placemark.subAdministrativeArea ??
      null;
    uf = stateToUF(
      address.state ?? placemark.administrativeArea ?? placemark.state
    );
  } catch (_) {}

  // Reserva explícita somente quando a posição estiver na região de Jataí.
  if (
    !city &&
    Math.abs(location.latitude - SETTINGS.fallbackLatitude) < 0.8 &&
    Math.abs(location.longitude - SETTINGS.fallbackLongitude) < 0.8
  ) {
    city = "Jataí";
    uf = "GO";
  }
  if (!city || !uf) return null;

  let ibgeCode = null;
  try {
    const request = new Request(
      `https://servicodados.ibge.gov.br/api/v1/localidades/estados/${uf}/municipios`
    );
    request.timeoutInterval = 12;
    const municipalities = await request.loadJSON();
    const target = normalizeSearchText(city);
    const municipality = municipalities.find(
      (item) => normalizeSearchText(item.nome) === target
    );
    ibgeCode = municipality?.id ?? null;
  } catch (_) {}

  // Código IBGE de Jataí, usado apenas como reserva local.
  if (!ibgeCode && uf === "GO" && normalizeSearchText(city) === "jatai") {
    ibgeCode = 5211909;
  }

  const region = {
    city,
    uf,
    ibgeCode,
    latitude: location.latitude,
    longitude: location.longitude,
    updatedAt: Date.now(),
  };
  try {
    Keychain.set(cacheKey, JSON.stringify(region));
  } catch (_) {}
  return region;
}

async function loadRegionalHolidayDates(year, region) {
  const fm = FileManager.local();
  const safeRegion = `${region.uf}-${region.ibgeCode ?? "state"}`;
  const cachePath = fm.joinPath(
    fm.documentsDirectory(),
    `Agenda-Timeline-holidays-${year}-${safeRegion}.json`
  );
  const maximumAge = SETTINGS.holidayCacheDays * 86400000;

  try {
    if (fm.fileExists(cachePath)) {
      const cached = JSON.parse(fm.readString(cachePath));
      if (Date.now() < (cached.expiresAt ?? cached.updatedAt + maximumAge)) {
        return new Set(cached.dates ?? []);
      }
    }
  } catch (_) {}

  const base =
    "https://raw.githubusercontent.com/joaopbini/feriados-brasil/master/dados/feriados";
  const sources = [
    {
      url: `${base}/estadual/json/${year}.json`,
      matches: (holiday) => holiday.uf === region.uf,
    },
  ];
  if (region.ibgeCode) {
    sources.push({
      url: `${base}/municipal/json/${year}.json`,
      matches: (holiday) =>
        String(holiday.codigo_ibge) === String(region.ibgeCode),
    });
  }

  const dates = new Set();
  let successfulSources = 0;
  for (const source of sources) {
    try {
      const request = new Request(`${source.url}?v=${year}`);
      request.timeoutInterval = 18;
      const holidays = await request.loadJSON();
      holidays
        .filter(source.matches)
        .map((holiday) => holidayDateKey(holiday.data))
        .filter(Boolean)
        .forEach((key) => dates.add(key));
      successfulSources++;
    } catch (_) {
      // Mantém os feriados nacionais calculados localmente se a base regional
      // ainda não tiver publicado o ano ou estiver temporariamente indisponível.
    }
  }

  try {
    const complete = successfulSources === sources.length;
    fm.writeString(
      cachePath,
      JSON.stringify({
        updatedAt: Date.now(),
        expiresAt:
          Date.now() + (complete ? maximumAge : 24 * 60 * 60 * 1000),
        dates: [...dates],
      })
    );
  } catch (_) {}
  return dates;
}

function brazilianNationalHolidayDates(year) {
  const fixed = [
    [1, 1],
    [4, 21],
    [5, 1],
    [9, 7],
    [10, 12],
    [11, 2],
    [11, 15],
    [11, 20],
    [12, 25],
  ].map(([month, day]) => localDateKey(year, month, day));
  const goodFriday = addDays(easterSunday(year), -2);
  return new Set([...fixed, dateKey(goodFriday)]);
}

function easterSunday(year) {
  const a = year % 19;
  const b = Math.floor(year / 100);
  const c = year % 100;
  const d = Math.floor(b / 4);
  const e = b % 4;
  const f = Math.floor((b + 8) / 25);
  const g = Math.floor((b - f + 1) / 3);
  const h = (19 * a + b - d - g + 15) % 30;
  const i = Math.floor(c / 4);
  const k = c % 4;
  const l = (32 + 2 * e + 2 * i - h - k) % 7;
  const m = Math.floor((a + 11 * h + 22 * l) / 451);
  const month = Math.floor((h + l - 7 * m + 114) / 31);
  const day = ((h + l - 7 * m + 114) % 31) + 1;
  return new Date(year, month - 1, day);
}

function holidayDateKey(value) {
  const match = String(value ?? "").match(/^(\d{2})\/(\d{2})\/(\d{4})$/);
  return match ? `${match[3]}-${match[2]}-${match[1]}` : null;
}

function localDateKey(year, month, day) {
  return `${year}-${String(month).padStart(2, "0")}-${String(day).padStart(2, "0")}`;
}

function stateToUF(value) {
  const normalized = normalizeSearchText(value ?? "");
  const states = {
    acre: "AC", alagoas: "AL", amapa: "AP", amazonas: "AM",
    bahia: "BA", ceara: "CE", "distrito federal": "DF",
    "espirito santo": "ES", goias: "GO", maranhao: "MA",
    "mato grosso": "MT", "mato grosso do sul": "MS",
    "minas gerais": "MG", para: "PA", paraiba: "PB", parana: "PR",
    pernambuco: "PE", piaui: "PI", "rio de janeiro": "RJ",
    "rio grande do norte": "RN", "rio grande do sul": "RS",
    rondonia: "RO", roraima: "RR", "santa catarina": "SC",
    "sao paulo": "SP", sergipe: "SE", tocantins: "TO",
  };
  if (/^[a-z]{2}$/.test(normalized)) return normalized.toUpperCase();
  return states[normalized] ?? null;
}

function cleanOptionalText(value) {
  return String(value ?? "").replace(/\s+/g, " ").trim();
}

function currentUserParticipationStatus(attendees) {
  if (!Array.isArray(attendees)) return "";
