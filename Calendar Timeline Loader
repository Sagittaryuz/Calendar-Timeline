function calendarCodeChecksum(code) {
  // Detecta corrupção acidental do arquivo; não é assinatura de autenticidade.
  let hash = 2166136261;
  for (let index = 0; index < code.length; index++) {
    hash = Math.imul(hash ^ code.charCodeAt(index), 16777619);
  }
  return (hash >>> 0).toString(16).padStart(8, "0");
}

function compileCalendarCode(code) {
  if (typeof code !== "string" || code.length > 2000000 ||
    !code.includes("// Variables used by Scriptable.") ||
    !/async function loadWindow\s*\(/.test(code) ||
    !/async function renderWidget\s*\(/.test(code) ||
    !/Script\.setWidget\s*\(/.test(code) || !/Script\.complete\s*\(/.test(code)) {
    throw new Error("Resposta não contém o código Calendar Timeline esperado");
  }
  const version = code.match(/const WIDGET_BUILD_VERSION\s*=\s*["'](\d{4}\.\d{2}\.\d{2}\.\d+)["']/)?.[1];
  if (!version) throw new Error("Código sem versão válida");
  // A compilação valida sintaxe sem executar consultas ou desenho.
  return {version, program: new CalendarAsyncFunction("args", "config", "Script", code)};
}

function calendarCodeSnapshot(code, fetchedAt) {
