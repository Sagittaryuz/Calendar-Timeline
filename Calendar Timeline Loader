e * (1.15 - TITLE_CARD_TEXT_VISIBLE_TOP_RATIO));\n  // Finais de semana usam o centro do clima; dias úteis preservam .2.\n  const titleCenterX = date.getDay() === 0 || date.getDay() === 6\n    ? weatherCenterX : titleBounds.center;\n  const titleStartX = titleCenterX - layout.titleWidth / 2;\n  ctx.setTextAlignedLeft();\n  ctx.setFont(Font.blackMonospacedSystemFont(layout.titleFontSize));\n  ctx.setTextColor(weekdayColor);\n  drawTightTitleText(ctx, weekdayLabel, titleStartX, layout.titleY, layout.titleFontSize);\n  ctx.setTextColor(dateColor);\n  // Letras próximas permitem aumentar a fonte sem alterar a largura do quadro.\n  drawTightTitleText(ctx, dayLabel, titleStartX + 1.72 * layout.titleFontSize,\n    layout.titleY, layout.titleFontSize);\n\n  const detailVisibleHeight = detailFontSize * (1.15 - TITLE_CARD_TEXT_VISIBLE_TOP_RATIO);\n  const weatherY = layout.weatherCenterY - detailVisibleHeight / 2 -\n    detailFontSize * TITLE_CARD_TEXT_VISIBLE_TOP_RATIO;\n  ctx.setFont(Font.blackMonospacedSystemFont(detailFontSize));\n  ctx.setTextColor(new Color(SETTINGS.minimumTemperatureColor, 1.0));\n  ctx.drawText(minimum, new Point(weatherX, weatherY));\n  drawTitleWeatherIcon(ctx, titleForecastForDay(date),\n    weatherX + minimumWidth + iconGap + layout.iconSize / 2,\n    layout.weatherCenterY, layout.iconSize);\n  ctx.setTextColor(new Color(SETTINGS.maximumTemperatureColor, 1.0));\n  ctx.drawText(maximum, new Point(weatherX + minimumWidth + iconGap * 2 + layout.iconSize, weatherY));\n}\n\nfunction titleDailyTemperatureForDay(date) {\n  const daily = titleDailyWeatherForDay(date);\n  if (\n    daily &&\n    Number.isFinite(Number(daily.minimum)) &&\n    Number.isFinite(Number(daily.maximum))\n  ) {\n    return daily;\n  }\n\n  return dailyTemperatureExtremes(\n    hourlyWeather?.hours ?? []\n  )[dateKey(date)] ?? null;\n}\n\nfunction titleScheduleCountsForDay(date) {\n  const key = dateKey(startOfDay(date));\n  const counts = loadResult.scheduleCountsByDay?.[key];\n  return {\n    events: Number(counts?.events) || 0,\n    reminders: Number(counts?.reminders) || 0,\n  };\n}\n\nfunction fillTitleCardShape(ctx, rect, radii, color) {\n  const right = rect.x + rect.width, bottom = rect.y + rect.height;\n  const outerRight = right >= CANVAS.width - 4 && right <= CANVAS.width + 0.01 && rect.y <= 6;\n  const inset = outerRight ? Math.max(0, CANVAS.width - right) : 0;\n  const rx = WIDGET_CONTOUR.extentX - inset;\n  const ry = WIDGET_CONTOUR.extentY - inset;\n  const corners = [\"topLeft\", \"topRight\", \"bottomRight\", \"bottomLeft\"]\n    .map(key => radii[key] > 0 ? {x: rx, y: ry} : {x: 0, y: 0});\n  // Ajuste conjunto por lateral: cantos retos continuam retos.\n  const factor = Math.min(1,\n    rect.width / Math.max(1, corners[0].x + corners[1].x),\n    rect.width / Math.max(1, corners[2].x + corners[3].x),\n    rect.height / Math.max(1, corners[0].y + corners[3].y),\n    rect.height / Math.max(1, corners[1].y + corners[2].y));\n  for (const c of corners) { c.x *= factor; c.y *= factor; }\n  const [tl, tr, br, bl] = corners;\n  const path = new Path();\n  path.move(new Point(rect.x + tl.x, rect.y));\n  path.addLine(new Point(right - tr.x, rect.y));\n  if (outerRight) {\n    // Preserva exatamente o canto externo que já foi calibrado no aparelho.\n    for (const p of widgetLeftContourPoints(inset).filter(p => p.y <= WIDGET_CONTOUR.extentY)) {\n      path.addLine(new Point(CANVAS.width - p.x, Math.max(rect.y, p.y)));\n    }\n  } else {\n    appendContourArc(path, right - tr.x, rect.y + tr.y, tr.x, tr.y, -Math.PI/2, 0);\n  }\n  path.addLine(new Point(right, bottom - br.y));\n  appendContourArc(path, right - br.x, bottom - br.y, br.x, br.y, 0, Math.PI/2);\n  path.addLine(new Point(rect.x + bl.x, bottom));\n  appendContourArc(path, rect.x + bl.x, bottom - bl.y, bl.x, bl.y, Math.PI/2, Math.PI);\n  path.addLine(new Point(rect.x, rect.y + tl.y));\n  appendContourArc(path, rect.x + tl.x, rect.y + tl.y, tl.x, tl.y, Math.PI, Math.PI*1.5);\n  path.closeSubpath();\n  ctx.setFillColor(color);\n  ctx.addPath(path);\n  ctx.fillPath();\n}\n\nfunction titleDayMonthLabel(date) {\n  return `${String(date.getDate()).padStart(2, \"0\")}/${String(\n    date.getMonth() + 1\n  ).padStart(2, \"0\")}`;\n}\n\nfunction titleDailyWeatherForDay(date) {\n  return hourlyWeather?.daily?.[dateKey(date)] ?? null;\n}\n\nfunction titleForecastForDay(date) {\n  const dayStart = startOfDay(date).getTime();\n  const dayEnd = addDays(startOfDay(date), 1).getTime();\n  const candidates = (hourlyWeather?.hours ?? []).filter(hour => {\n    const timestamp = finiteWeatherNumber(hour?.timestamp);\n    return timestamp !== null && timestamp >= dayStart && timestamp < dayEnd &&\n      weatherSymbolGroup(hour) !== null;\n  });\n  const target = dateAtHour(date, 12).getTime();\n  if (candidates.length) return candidates.reduce((nearest, candidate) =>\n    Math.abs(candidate.timestamp - target) < Math.abs(nearest.timestamp - target)\n      ? candidate : nearest);\n  // O resumo da API preserva o ícone mesmo se as horas desse dia faltarem.\n  const daily = titleDailyWeatherForDay(date);\n  return weatherSymbolGroup(daily) !== null\n    ? { ...daily, timestamp: target, temperature: daily.maximum }\n    : null;\n}\n\nfunction drawTitleWeatherIcon(\n  ctx,\n  forecast,\n  centerX,\n  centerY,\n  size\n) {\n  if (!forecast) return;\n\n  const hasKnownSymbol = weatherSymbolGroup(forecast) !== null;\n  if (!hasKnownSymbol) {\n    // Temperatura sem condição conhecida não deve sugerir céu limpo.\n    drawCelestialWeatherOverlay(\n      ctx,\n      forecast,\n      centerX,\n      centerY,\n      size\n    );\n    return;\n  }\n\n  // O cartão usa a condição representativa do meio do dia, sem alterar\n  // os ícones horários desenhados na timeline inferior.\n  drawWeatherSun(ctx, centerX, centerY, weatherSunRadius(size));\n  drawCelestialWeatherOverlay(\n    ctx,\n    forecast,\n    centerX,\n    centerY,\n    size\n  );\n}\n\nfunction drawTemperatureFooter(ctx, weather) {\n  // A faixa inferior agora é um gráfico térmico contínuo. Sua largura é\n  // exatamente a da timeline, portanto todos os pontos permanecem alinhados\n  // às divisões horárias e são recortados pelas margens do grid.\n  const footerCtx = new DrawContext();\n  const thermalFooterOverlap = 8;\n  const thermalCurveExpansion = 5;\n  const footerOriginY =\n    CANVAS.timelineBottom - thermalFooterOverlap - thermalCurveExpansion;\n  const footerHeight = CANVAS.footerBottom - footerOriginY;\n  footerCtx.size = new Size(timelineWidth(), footerHeight);\n  footerCtx.opaque = false;\n  footerCtx.respectScreenScale = false;\n\n  const ticks = hourTicks();\n  const sourceHours = [...(weather?.hours ?? [])]\n    .filter(\n      (hour) =>\n        Number.isFinite(Number(hour.timestamp)) &&\n        Number.isFinite(Number(hour.temperature))\n    )\n    .sort((a, b) => Number(a.timestamp) - Number(b.timestamp));\n\n  const visibleValues = sourceHours\n    .filter(\n      (hour) =>\n        Number(hour.timestamp) >= windowStart.getTime() &&\n        Number(hour.timestamp) <= windowEnd.getTime()\n    )\n    .map((hour) => Number(hour.temperature));\n\n  if (visibleValues.length === 0) {\n    drawThermalHourGuides(\n      footerCtx,\n      ticks,\n      34 + thermalCurveExpansion\n    );\n    ctx.drawImageInRect(\n      footerCtx.getImage(),\n      new Rect(\n        CANVAS.plotLeft,\n        footerOriginY,\n        timelineWidth(),\n        footerHeight\n      )\n    );\n    return;\n  }\n\n  const temperatureMinimum = Math.min(...visibleValues);\n  const temperatureMaximum = Math.max(...visibleValues);\n  const baseFooterOriginY =\n    footerOriginY + thermalCurveExpansion;\n  const footerGridBottom =\n    CANVAS.timelineBottom - baseFooterOriginY;\n  const graphLabelTop =\n    footerGridBottom + CANVAS.timelineLegendGap;\n  const baseGraphBottom = Math.max(6, graphLabelTop - 2);\n  const labelTop =\n    graphLabelTop + CANVAS.temperatureLegendVerticalOffset;\n  const graphTop = 0;\n  const graphBottom = baseGraphBottom + thermalCurveExpansion;\n  const contentGraphTop = thermalCurveExpansion;\n  const labelFontSize = isCompactMode()\n    ? 23\n    : isExtendedDetailedMode()\n      ? 22\n      : 27;\n\n  // 1) guias horárias discretas, sem caixas ou preenchimentos individuais;\n  // 2) chuva atrás da área e da curva térmica;\n  // 3) preenchimento térmico;\n  // 4) linha contínua e suave;\n  // 5) valores numéricos abaixo do gráfico.\n  drawThermalRainBars(\n    footerCtx,\n    sourceHours,\n    contentGraphTop,\n    graphBottom\n  );\n\n  // As guias originais do grid ficam visíveis por cima das barras azuis.\n  drawThermalHourGuides(footerCtx, ticks, graphBottom, false);\n\n  const thermalSamples = buildThermalSamples(sourceHours);\n  const curvePoints = thermalSamples\n    .map((sample) => ({\n      x: timeToX(new Date(sample.timestamp)),\n      y: thermalTemperatureY(\n        sample.temperature,\n        temperatureMinimum,\n        temperatureMaximum,\n        graphTop,\n        graphBottom\n      ),\n      temperature: sample.temperature,\n    }))\n    .filter(\n      (point) =>\n        Number.isFinite(point.x) &&\n        Number.isFinite(point.y)\n    );\n\n  const smoothPoints = smoothThermalCurve(curvePoints);\n  drawThermalArea(\n    footerCtx,\n    smoothPoints,\n    graphBottom,\n    temperatureMinimum,\n    temperatureMaximum\n  );\n  drawThermalCurve(\n    footerCtx,\n    smoothPoints,\n    temperatureMinimum,\n    temperatureMaximum\n  );\n\n  // O quadrado inferior é preenchido primeiro; a linha de mudança de dia\n  // fica por cima dele e da curva térmica.\n  const renderedLabelTop = labelTop + thermalCurveExpansion;\n  // Mantém a posição vertical existente e usa o mesmo eixo para todos os\n  // números da legenda inferior.\n  const temperatureLegendCenterY = renderedLabelTop + 13.5;\n  drawThermalDayBadgeFrames(\n    footerCtx,\n    ticks,\n    temperatureLegendCenterY\n  );\n\n  // A linha termina ex