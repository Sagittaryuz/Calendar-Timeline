e) ||\n    !(referenceDate instanceof Date) ||\n    !Number.isFinite(eventStart.getTime()) ||\n    !Number.isFinite(referenceDate.getTime())\n  ) {\n    return \"\";\n  }\n\n  const remainingMilliseconds = eventStart.getTime() - referenceDate.getTime();\n  if (remainingMilliseconds <= 0) return \"\";\n  if (remainingMilliseconds < 60 * 60000) {\n    return formatTenMinuteCountdown(eventStart, referenceDate);\n  }\n\n  // Uma casa decimal mantém a leitura curta: 2h, 2,5h, 1,2h.\n  const hours = Math.round(remainingMilliseconds / 3600000 * 10) / 10;\n  return `${String(hours).replace(\".\", \",\")}h`;\n}\n\nfunction formatDayEndCountdown(eventStart, referenceDate = now) {\n  return formatTenMinuteCountdown(eventStart, referenceDate);\n}\n\nfunction formatTenMinuteCountdown(eventStart, referenceDate = now) {\n  if (\n    !(eventStart instanceof Date) ||\n    !(referenceDate instanceof Date) ||\n    !Number.isFinite(eventStart.getTime()) ||\n    !Number.isFinite(referenceDate.getTime())\n  ) {\n    return \"\";\n  }\n\n  const remainingMilliseconds = Math.max(\n    0,\n    eventStart.getTime() - referenceDate.getTime()\n  );\n\n  if (remainingMilliseconds === 0) return \"0m\";\n\n  // Arredonda para cima em passos de dez minutos. Abaixo de uma hora,\n  // limita o maior rótulo a 50m para não exibir \"1h\" antes da hora.\n  if (remainingMilliseconds < 60 * 60000) {\n    const roundedMinutes = Math.min(\n      50,\n      Math.max(10, Math.ceil(remainingMilliseconds / 600000) * 10)\n    );\n    return `${roundedMinutes}m`;\n  }\n\n  const roundedMinutes = Math.ceil(remainingMilliseconds / 600000) * 10;\n  const wholeHours = Math.floor(roundedMinutes / 60);\n  const minuteRemainder = roundedMinutes % 60;\n  return minuteRemainder === 0\n    ? `${wholeHours}h`\n    : `${wholeHours}h e ${minuteRemainder}m`;\n}\n\nfunction arrivalGuideStart(item) {\n  if (!(item?.start instanceof Date)) return null;\n  if (item.kind === \"reminder\" && item.sourceIsAllDay) {\n    // O lembrete