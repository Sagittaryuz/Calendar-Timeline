f (segment.length >= 2) {\n      drawAmorphousCloudSegment(ctx, segment, stripBottom);\n    }\n    segment = [];\n  };\n\n  for (const sample of samples) {\n    if (\n      sample.cloudiness !== null &&\n      sample.cloudiness >= threshold\n    ) {\n      segment.push(sample);\n    } else {\n      flushSegment();\n    }\n  }\n  flushSegment();\n}\n\nfunction drawAmorphousCloudSegment(ctx, samples, stripBottom) {\n  const centerY = Math.min(stripBottom - 7, stripBottom * 0.67);\n  const topPoints = [];\n  const bottomPoints = [];\n  let totalCloudiness = 0;\n\n  for (let index = 0; index < samples.length; index++) {\n    const sample = samples[index];\n    const normalized = Math.max(\n      0,\n      Math.min(1, (sample.cloudiness - 24) / 76)\n    );\n    const edgeDistance = Math.min(\n      index,\n      samples.length - 1 - index\n    );\n    const edgeTaper =\n      0.48 + 0.52 * Math.min(1, edgeDistance / 2);\n    const wobble =\n      Math.sin(sample.x * 0.105) * (0.8 + normalized * 1.2) +\n      Math.sin(sample.x * 0.043 + 1.7) * 0.8;\n    const centerShift =\n      Math.sin(sample.x * 0.031 + 0.9) * (0.5 + normalized);\n    const halfHeight =\n      (2.2 + normalized * 6.2 + wobble * 0.42) * edgeTaper;\n    const localCenter = centerY + centerShift;\n\n    topPoints.push(\n      new Point(sample.x, localCenter - Math.max(1.4, halfHeight))\n    );\n    bottomPoints.push(\n      new Point(sample.x, localCenter + Math.max(1.4, halfHeight))\n    );\n    totalCloudiness += sample.cloudiness;\n  }\n\n  const averageCloudiness =\n    totalCloudiness / Math.max(1, samples.length);\n  const path = new Path();\n  path.move(topPoints[0]);\n  for (let index = 1; index < topPoints.length; index++) {\n    path.addLine(topPoints[index]);\n  }\n  for (let index = bottomPoints.length - 1; index >= 0; index--) {\n    path.addLine(bottomPoints[index]);\n  }\n  path.closeSubpath();\n\n  ctx.addPath(path);\n  ctx.setFillColor(\n    new Color(\n      \"#FFFFFF\",\n      0.08 + (averageCloudiness / 100) * 0.16\n    )\n  );\n  ctx.fillPath();\n\n  ctx.addPath(path);\n  ctx.setStrokeColor(\n    new Color(\n      \"#FFFFFF\",\n      0.72 + Math.min(1, averageCloudiness / 100) * 0.27\n    )\n  );\n  ctx.setLineWidth(\n    (isCompactMode() ? 1.9 : 2.5) +\n      Math.min(1, averageCloudiness / 100) *\n        (isCompactMode() ? 1.8 : 2.6)\n  );\n  ctx.strokePath();\n\n  // Em maior densidade surgem aberturas irregulares, alternando elipses e\n  // losangos. Em céu pouco nublado, a forma permanece pequena e isolada.\n  let lastMarkerX = -Infinity;\n  for (let index = 1; index < samples.length - 1; index++) {\n    const sample = samples[index];\n    if (\n      sample.cloudiness < 45 ||\n      sample.x - lastMarkerX < (isCompactMode() ? 24 : 31)\n    ) {\n      continue;\n    }\n\n    const strength = Math.max(\n      0,\n      Math.min(1, (sample.cloudiness - 45) / 55)\n    );\n    const markerWidth = 11 + strength * 17;\n    const markerHeight = 5 + strength * 9;\n    const fillAlpha = 0.09 + strength * 0.16;\n\n    if ((index + Math.round(sample.x / 10)) % 2 === 0) {\n      const rect = new Rect(\n        sample.x - markerWidth / 2,\n        centerY - markerHeight / 2,\n        markerWidth,\n        markerHeight\n      );\n      ctx.setFillColor(new Color(\"#FFFFFF\", fillAlpha));\n      ctx.fillEllipse(rect);\n      ctx.setStrokeColor(new Color(\"#FFFFFF\", 0.98));\n      ctx.setLineWidth(isCompactMode() ? 2.2 : 3);\n      ctx.strokeEllipse(rect);\n    } else {\n      const diamond = new Path();\n      diamond.move(new Point(sample.x - markerWidth / 2, centerY));\n      diamond.addLine(\n        new Point(sample.x, centerY - markerHeight / 2)\n      );\n      diamond.addLine(\n        new Point(sample.x + markerWidth / 2, centerY)\n      );\n      diamond.addLine(\n        new Point(sample.x, centerY + markerHeight / 2)\n      );\n      diamond.closeSubpath();\n      ctx.addPath(diamond);\n      ctx.setFillColor(new Color(\"#FFFFFF\", fillAlpha));\n      ctx.fillPath();\n      ctx.addPath(diamond);\n      ctx.setStrokeColor(new Color(\"#FFFFFF\", 0.98));\n      ctx.setLineWidth(isCompactMode() ? 2.2 : 3);\n      ctx.strokePath();\n    }\n\n    lastMarkerX = sample.x;\n  }\n}\n\nfunction drawFixedDaylightGloss(ctx) {\n  const centerY = 44;\n  const upperRadius = 5;\n  const lowerRadius = 22;\n  const coreThickness = 7;\n\n  for (const interval of visibleDaylightIntervals()) {\n    const width = interval.x1 - interval.x0;\n    if (width <= 0) continue;\n\n    // Os halos nas extremidades permanecem suaves. O corpo contínuo do\n    // brilho recebe a intensidade maior no centro do intervalo diurno.\n    for (const [radius, opacity] of [[34, 0.08], [24, 0.13], [15, 0.19]]) {\n      const edgeStrength =\n        0.70 + 0.30 * daylightStrengthAtX(interval.x0, interval.x0, interval.x1);\n      ctx.setFillColor(\n        new Color(\"#FFD62A\", solarOpacity(opacity * edgeStrength))\n      );\n      ctx.fillEllipse(\n        new Rect(interval.x0 - radius, centerY - radius, radius * 2, radius * 2)\n      );\n      ctx.fillEllipse(\n        new Rect(interval.x1 - radius, centerY - radius, radius * 2, radius * 2)\n      );\n    }\n\n    for (const slice of daylightSlices(interval)) {\n      for (let offset = -upperRadius; offset <= lowerRadius; offset += 2) {\n        const normalized =\n          offset < 0\n            ? Math.abs(offset) / upperRadius\n            : offset / lowerRadius;\n        const strength = Math.pow(Math.max(0, 1 - normalized), 2.0);\n        const sideProjection = 22 * strength;\n        fillRoundedRect(\n          ctx,\n          new Rect(\n            slice.x - sideProjection,\n            centerY + offset,\n            slice.width + sideProjection * 2 + 1,\n            2\n          ),\n          1,\n          new Color(\n            \"#FFD62A\",\n            solarOpacity(0.42 * strength * slice.daylightStrength)\n          )\n        );\n      }\n\n      fillRoundedRect(\n        ctx,\n        new Rect(\n          slice.x - 4,\n          centerY - Math.floor(coreThickness / 2),\n          slice.width + 9,\n          coreThickness\n        ),\n        coreThickness / 2,\n        new Color(\n          \"#FFE34D\",\n          solarOpacity(0.72 * slice.daylightStrength)\n        )\n      );\n      fillRoundedRect(\n        ctx,\n        new Rect(slice.x - 2, centerY - 1, slice.width + 5, 3),\n        1.5,\n        new Color(\n          \"#FFF3A0\",\n          solarOpacity(0.38 * slice.daylightStrength)\n        )\n      );\n    }\n  }\n}\n\nfunction solarOpacity(value) {\n  return Math.min(1, value * SETTINGS.solarGlowIntensity);\n}\n\nfunction daylightStrengthAtHour(hour) {\n  const start = SETTINGS.daylightStartHour;\n  const end = SETTINGS.daylightEndHour;\n  if (hour < start || hour > end) return 0;\n\n  const progress = (hour - start) / Math.max(1, end - start);\n  // Gradiente triangular linear: 06/18 ficam suaves e 12 é o pico.\n  return 0.28 + 0.72 * (1 - Math.abs(progress * 2 - 1));\n}\n\nfunction daylightStrengthAtX(x, x0, x1) {\n  if (x1 <= x0) return 0;\n  const progress = Math.max(0, Math.min(1, (x - x0) / (x1 - x0)));\n  return 0.28 + 0.72 * (1 - Math.abs(progress * 2 - 1));\n}\n\nfunction daylightSlices(interval, weather = null) {\n  const width = interval.x1 - interval.x0;\n  if (width <= 0) return [];\n\n  // Fatias estreitas deixam tanto o brilho quanto a atenuação por nuvens\n  // contínuos, sem blocos perceptíveis entre uma hora e outra.\n  const segmentCount = Math.min(\n    260,\n    Math.max(48, Math.ceil(width / 4))\n  );\n  const slices = [];\n\n  for (let index = 0; index < segmentCount; index++) {\n    const x = interval.x0 + (width * index) / segmentCount;\n    const nextX =\n      interval.x0 + (width * (index + 1)) / segmentCount;\n    const centerX = (x + nextX) / 2;\n    const daylightStrength = daylightStrengthAtX(\n      centerX,\n      interval.x0,\n      interval.x1\n    );\n    const solarVisibility = weather\n      ?