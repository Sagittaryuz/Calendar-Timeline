  forecast,\n  centerX,\n  centerY,\n  size\n) {\n  const state = weatherOverlayState(forecast);\n\n  // Sol, Lua, nascer/pôr do sol e eclipses usam a mesma nuvem e o mesmo\n  // alinhamento. A nuvem fica na parte inferior para o astro continuar legível.\n  if (state.cloud) {\n    const cloudScale =\n      (size / 82) * (state.denseCloud ? 1.02 : 0.90);\n    drawStripCloud(\n      ctx,\n      centerX + size * 0.08,\n      centerY + size * 0.19,\n      cloudScale,\n      state.rain || state.storm\n    );\n  }\n\n  if (state.rain) {\n    drawWeatherRainDrops(\n      ctx,\n      centerX,\n      centerY + size * 0.05,\n      size * 0.76\n    );\n  }\n\n  if (state.storm) {\n    drawWeatherLightning(\n      ctx,\n      centerX,\n      centerY + size * 0.02,\n      size * 0.76\n    );\n  }\n\n  if (state.snow) {\n    drawWeatherSnowflake(\n      ctx,\n      centerX,\n      centerY + size * 0.32,\n      size * 0.16,\n      \"#64D2FF\"\n    );\n  }\n\n  if (state.fog) {\n    drawWeatherFog(\n      ctx,\n      centerX,\n      centerY + size * 0.12,\n      size * 0.72\n    );\n  }\n\n  if (state.wind) {\n    drawWeatherWind(\n      ctx,\n      centerX,\n      centerY + size * 0.08,\n      size * 0.72\n    );\n  }\n}\n\nfunction fillEllipseIntersection(\n  ctx,\n  targetRect,\n  occluderRect,\n  color\n) {\n  const targetCenterX = targetRect.x + targetRect.width / 2;\n  const targetCenterY = targetRect.y + targetRect.height / 2;\n  const targetRadiusX = Math.max(0.001, targetRect.width / 2);\n  const targetRadiusY = Math.max(0.001, targetRect.height / 2);\n  const occluderCenterX =\n    occluderRect.x + occluderRect.width / 2;\n  const occluderCenterY =\n    occluderRect.y + occluderRect.height / 2;\n  const occluderRadiusX =\n    Math.max(0.001, occluderRect.width / 2);\n  const occluderRadiusY =\n    Math.max(0.001, occluderRect.height / 2);\n  const startX = Math.floor(\n    Math.max(targetRect.x, occluderRect.x)\n  );\n  const endX = Math.ceil(\n    Math.min(\n      target