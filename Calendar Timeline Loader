function validateCalendarCodeSnapshot(value) {
  try {
    return value?.schemaVersion === 1 && value.sourceURL === CALENDAR_SOURCE_URL &&
      Number.isFinite(value.fetchedAt) && value.fetchedAt > 0 &&
      typeof value.code === "string" && value.checksum === calendarCodeChecksum(value.code) &&
      value.version === compileCalendarCode(value.code).version;
  } catch (_) { return false; }
