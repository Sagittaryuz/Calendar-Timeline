tick),\n      centeredDayLegendTextRect(\n        x,\n        centerY,\n        textWidth,\n        fontSize\n      )\n    );\n  }\n}\n\n\nfunction drawFixedDaylightGlow(ctx, weather) {\n  const lineY = solarLineY();\n  // O brilho chega até a base da faixa térmica, ficando atrás das\n  // temperaturas, do preenchimento e da curva desenhados depois.\n  const glowEndY = thermalBandBottomY();\n\n  for (const interval of visibleDaylightIntervals()) {\n    // A luz solar é uniforme em relação às nuvens. Mantém apenas a\n    // progressão natural do amanhecer ao meio-dia e ao entardecer.\n    const slices = daylightSlices(interval);\n    if (slices.length === 0) continue;\n\n    // A irradiação amarela não sofre mais atenuação pela nebulosidade.\n    for (const slice of slices) {\n      // Uma faixa de um pixel por vez, sem sobreposição, mantém o\n      // gradiente contínuo e elimina as bordas horizontais.\n      for (\n        let y = lineY + scaleVertical(1);\n        y < glowEndY;\n        y += scaleVertical(1)\n      ) {\n        const verticalProgress =\n          (y - lineY) / Math.max(1, glowEndY - lineY);\n        const verticalStrength = Math.pow(\n          Math.max(0, 1 - verticalProgress),\n          1.05\n        );\n        const opacity =\n          0.78 *\n          verticalStrength *\n          slice.daylightStrength *\n          SETTINGS.solarGlowIntensity;\n        ctx.setFillColor(\n          new Color(\"#FFD000\", Math.min(0.92, opacity))\n        );\n        ctx.fillRect(\n          new Rect(slice.x, y, slice.width + 1, 1)\n        );\n      }\n\n      // Linha solar única sobre a borda do grid. Ela fica exatamente em\n      // lineY; o preenchimento abaixo continua sem faixas adicionais.\n      ctx.setFillColor(\n        new Color(\n          \"#FFD000\",\n          Math.min(\n            1,\n            (0.22 + 0.77 * slice.daylightStrength) *\n              SETTINGS.solarGlowIntensity\n          )\n        )\n      );\n      ctx.fillRect(\n     