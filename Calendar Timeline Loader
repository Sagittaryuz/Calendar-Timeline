n  ctx,\n  segmentStart,\n  segmentEnd,\n  texturePart\n) {\n  if (segmentEnd <= windowStart || segmentStart >= windowEnd) return;\n\n  const x0 = timeToX(segmentStart);\n  const x1 = timeToX(segmentEnd);\n  if (x1 <= x0) return;\n\n  const image = nightTextures[texturePart];\n  const backgroundTop = CANVAS.localPlotTop - 6;\n  if (image) {\n    ctx.drawImageInRect(\n      image,\n      new Rect(\n        x0,\n        backgroundTop,\n        x1 - x0,\n        localPlotBottom() - backgroundTop\n      )\n    );\n  } else {\n    // Reserva offline caso a textura ainda não tenha sido baixada.\n    drawNightAtmosphere(ctx, segmentStart, segmentEnd);\n  }\n\n}\n\nfunction drawSkyCycleBackground(ctx) {\n  // Começa no dia anterior para incluir a noite que atravessa a meia-noite.\n  let dayStart = addDays(startOfDay(windowStart), -1);\n  const finalDay = addDays(startOfDay(windowEnd), 1);\n\n  while (dayStart <= finalDay) {\n    const sunrise = dateAtHour(dayStart, SETTINGS.daylightStartHour);\n    const sunset = dateAtHour(dayStart, SETTINGS.daylightEndHour);\n    const nextDay = addDays(dayStart, 1);\n    const nextSunrise = dateAtHour(nextDay, SETTINGS.daylightStartHour);\n\n    if (sunrise && sunset) {\n      drawDaylightGlow(ctx, sunrise, sunset, dayStart);\n    }\n    if (sunset && nextSunrise) {\n      drawNightAtmosphere(ctx, sunset, nextSunrise);\n      drawTwilightGlow(ctx, sunset, false);\n      drawTwilightGlow(ctx, nextSunrise, true);\n    }\n\n    dayStart = nextDay;\n  }\n}\n\nfunction drawNightAtmosphere(ctx, nightStart, nightEnd) {\n  const visibleStart = new Date(\n    Math.max(nightStart.getTime(), windowStart.getTime())\n  );\n  const visibleEnd = new Date(\n    Math.min(nightEnd.getTime(), windowEnd.getTime())\n  );\n  if (visibleEnd <= visibleStart) return;\n\n  const x0 = Math.max(0, timeToX(visibleStart));\n  const x1 = Math.min(timelineWidth(), timeToX(visibleEnd));\n  const width = x1 - x0;\n  const backgroundTop = CANVAS.localPlotTop - 6;\n  const height = localPlotBottom() - backgroundTop;\n  if (width <= 0) return;\n\n  // A atmosfera começa abaixo da legenda das horas.\n  for (let y = 0; y < height; y += 2) {\n    const progress = y / Math.max(1, height - 1);\n    const color =\n      progress <= 0.46\n        ? interpolateHexColor(\n            SETTINGS.nightSkyTopColor,\n            SETTINGS.nightSkyMidColor,\n            progress / 0.46\n          )\n        : interpolateHexColor(\n            SETTINGS.nightSkyMidColor,\n            SETTINGS.nightSkyBottomColor,\n            (progress - 0.46) / 0.54\n          );\n    const opacity = 0.91 - progress * 0.08;\n    ctx.setFillColor(new Color(color, opacity));\n    ctx.fillRect(new Rect(x0, backgroundTop + y, width, 2));\n  }\n\n  // Textura geométrica sutil inspirada nas curvas orbitais da referência.\n  const geometryStep = 68;\n  ctx.setStrokeColor(new Color(SETTINGS.nightGeometryColor, 0.10));\n  ctx.setLineWidth(1);\n  for (let baseX = x0 + 8; baseX < x1; baseX += geometryStep) {\n    const path = new Path();\n    const xA = baseX;\n    const xB = Math.min(x1, baseX + 20);\n    const xC = Math.min(x1, baseX + 7);\n    const xD = Math.min(x1, baseX + 30);\n    path.move(new Point(xA, backgroundTop));\n    path.addLine(new Point(xB, backgroundTop + height * 0.24));\n    path.addLine(new Point(xC, backgroundTop + height * 0.52));\n    path.addLine(new Point(xD, backgroundTop + height * 0.78));\n    path.addLine(\n      new Point(Math.min(x1, baseX + 14), backgroundTop + height)\n    );\n    ctx.addPath(path);\n    ctx.strokePath();\n  }\n\n  for (let curve = 0; curve < 3; curve++) {\n    const path = new Path();\n    const baseY = backgroundTop + 34 + curve * 24;\n    const amplitude = 18 + curve * 7;\n    for (let step = 0; step <= 24; step++) {\n      const progress = step / 24;\n      const x = x0 + width * progress;\n      const y = baseY + Math.pow(progress - 0.5, 2) * amplitude * 4;\n      if (step === 0) path.move(new Point(x, y));\n      else path.addLine(new Point(x, y));\n    }\n    ctx.addPath(path);\n    ctx.strokePath();\n  }\n\n  // Pequenas estrelas de fundo; as estrelas principais permanecem nas luas.\n  const starCount = Math.max(2, Math.floor(width / 72));\n  for (let index = 0; index < starCount; index++) {\n    const relativeX = ((index * 0.61803398875 + 0.17) % 1);\n    const relativeY = ((index * 0.371 + 0.21) % 1);\n    drawFivePointStar(\n      ctx,\n      x0 + width * relativeX,\n      backgroundTop + 12 + (height - 24) * relativeY,\n      1.8 + (index % 3) * 0.45,\n      new Color(SETTINGS.nightStarColor, 0.22)\n    );\n  }\n}\n\nfunction drawTwilightGlow(ctx, moment, isSunrise) {\n  const centerX = timeToX(moment);\n  const hourWidth = timelineWidth() / Math.max(1, windowHours);\n  const radius = Math.max(22, Math.min(88, hourWidth * 1.85));\n  if (centerX + radius < 0 || centerX - radius > timelineWidth()) return;\n\n  // No pôr do sol, o brilho fecha vindo do dia; no nascer, abre em direção\n  // ao novo dia. A intensidade máxima permanece exatamente na transição.\n  const leftRadius = isSunrise ? radius * 0.42 : radius;\n  const rightRadius = isSunrise ? radius : radius * 0.42;\n  const startX = Math.max(0, centerX - leftRadius);\n  const endX = Math.min(timelineWidth(), centerX + rightRadius);\n\n  for (let x = startX; x < endX; x += 2) {\n    const distance = x <= centerX\n      ? (centerX - x) / Math.max(1, leftRadius)\n      : (x - centerX) / Math.max(1, rightRadius);\n    const strength = Math.max(0, 1 - distance);\n    ctx.setFillColor(\n      new Color(SETTINGS.twilightGlowColor, 0.24 * strength * strength)\n    );\n    ctx.fillRect(new Rect(x, 0, 2, timelineHeight()));\n\n    ctx.setFillColor(\n      new Color(SETTINGS.twilightGlowColor, 0.28 * strength * strength)\n    );\n    ctx.fillRect(new Rect(x, 0, 2, CANVAS.localPlotTop + 30));\n  }\n\n  // Coluna solar fina e intensa exatamente no nascer ou pôr do sol.\n  ctx.setFillColor(new Color(SETTINGS.twilightGlowColor, 0.76));\n  ctx.fillRect(new Rect(centerX - 1, 0, 3, timelineHeight()));\n  ctx.setFillColor(new Color(\"#FFF4CC\", 0.82));\n  ctx.fillRect(new Rect(centerX, 0, 1, timelineHeight()));\n\n  ctx.setFillColor(new Color(SETTINGS.twilightGlowColor, 0.18));\n  ctx.fillEllipse(\n    new Rect(centerX - radius * 0.52, -28, radius * 1.04, 150)\n  );\n}\n\nfunction drawDaylightGlow(ctx, sunrise, sunset, dayStart) {\n  const visibleStart = new Date(\n    Math.max(sunrise.getTime(), windowStart.getTime())\n  );\n  const visibleEnd = new Date(\n    Math.min(sunset.getTime(), windowEnd.getTime())\n  );\n  if (visibleEnd <= visibleStart) return;\n\n  const x0 = Math.max(0, timeToX(visibleStart));\n  const x1 = Math.min(timelineWidth(), timeToX(visibleEnd));\n  let noon = dateAtHour(dayStart, 12);\n  if (noon <= sunrise || noon >= sunset) {\n    noon = new Date((sunrise.getTime() + sunset.getTime()) / 2);\n  }\n\n  for (let x = x0; x < x1; x += 2) {\n    const time = new Date(\n      windowStart.getTime() +\n        (x / timelineWidth()) * (windowEnd.getTime() - windowStart.getTime())\n    );\n    const linearStrength = time <= noon\n      ? (time.getTime() - sunrise.getTime()) /\n        Math.max(1, noon.getTime() - sunrise.getTime())\n      : (sunset.getTime() - time.getTime()) /\n        Math.max(1, sunset.getTime() - noon.getTime());\n    const clamped = Math.max(0, Math.min(1, linearStrength));\n    const strength = 0.5 - 0.5 * Math.cos(Math.PI * clamped);\n\n    // Halo dourado que ocupa todo o painel, mais forte próximo ao meio-dia.\n    // As faixas verticais mantêm o efeito leve sobre charts e linhas.\n    ctx.setFillColor(\n      new Color(SETTINGS.daylightSkyColor, 0.10 + 0.17 * strength)\n    );\n    ctx.fillRect(new Rect(x, 0, 2, timelineHeight()));\n\n    ctx.setFillColor(\n      new Color(SETTINGS.daylightGlowColor, 0.10 * strength)\n    );\n    ctx.fillRect(new Rect(x, 0, 2, CANVAS.localPlotTop + 56));\n\n    ctx.setFillColor(\n      new Color(SETTINGS.daylightCoreColor, 0.11 * strength * strength)\n    );\n    ctx.fillRect(\n      new Rect(\n        x,\n        CANVAS.localPlotTop + 26,\n        2,\n        timelineHeight() - CANVAS.localPlotTop - 54\n      )\n    );\n  }\n\n  const noonX = timeToX(noon);\n  const daylightWidth = Math.max(1, timeToX(sunset) - timeToX(sunrise));\n  const haloWidth = Math.min(timelineWidth() * 0.72, daylightWidth * 0.82);\n  ctx.setFillColor(new Color(SETTINGS.daylightCoreColor, 0.10));\n  ctx.fillEllipse(\n    new Rect(\n      noonX - haloWidth / 2,\n      -timelineHeight() * 0.28,\n      haloWidth,\n      timelineHeight() * 1.50\n    )\n  );\n\n  drawDaylightGeometry(ctx, x0, x1);\n}\n\nfunction drawDaylightGeometry(ctx, x0, x1) {\n  const width = x1 - x0;\n  if (width < 12) return;\n\n  ctx.setStrokeColor(new Color(\"#FFE7B0\", 0.075));\n  ctx.setLineWidth(1);\n  for (let curve = 0; curve < 3; curve++) {\n    const path = new Path();\n    const baseY = 42 + curve * 26;\n    const amplitude = 14 + curve * 6;\n    for (let step = 0; step <= 28; step++) {\n      const progress = step / 28;\n      const x = x0 + width * progress;\n      const y = baseY + Math.pow(progress - 0.5, 2) * amplitude * 4;\n      if (step === 0) path.move(new Point(x, y));\n      else path.addLine(new Point(x, y));\n    }\n    ctx.addPath(path);\n    ctx.strokePath();\n  }\n}\n\nfunction drawNightScenes(ctx) {\n  // Começa no dia anterior porque a noite pode ter iniciado antes da janela.\n  let dayStart = addDays(startOfDay(windowStart), -1);\n  const finalDay = addDays(startOfDay(windowEnd), 1);\n\n  while (dayStart <= finalDay) {\n    const nightStart = dateAtHour(dayStart, SETTINGS.nightStartHour);\n    const nextDay = addDays(dayStart, 1);\n    const nightEnd = dateAtHour(nextDay, SETTINGS.nightEndHour);\n\n    if (intervalIsVisible(nightStart, nightEnd)) {\n      // Toda noite é sempre uma única cena entre 18:00 e 06:00. A Lua grande\n      // permanece centralizada à meia-noite mesmo quando somente uma parte\n      // do intervalo está visível; o canvas recorta naturalmente as bordas.\n      drawNightSegment(\n        ctx,\n        nightStart,\n        nightEnd,\n        nightStart,\n        nightEnd,\n        true\n      );\n    }\n\n    dayStart = addDays(dayStart, 1);\n  }\n}\n\nfunction intervalIsVisible(start, end) {\n  return end > windowStart && start < windowEnd;\n}\n\nfunction drawNightSegment(\n  ctx,\n  segmentStart,\n  segmentEnd,\n  nightStart,\n  nightEnd,\n  mergedNight = false\n) {\n  const visibleStart = new Date(\n    Math.max(segmentStart.getTime(), windowStart.getTime())\n  );\n  const visibleEnd = new Date(\n    Math.min(segmentEnd.getTime(), windowEnd.getTime())\n  );\n  if (visibleEnd <= visibleStart) return;\n\n  // Usa os limites completos do segmento para manter a Lua centralizada no\n  // horário real, mesmo quando parte do intervalo estiver fora do widget.\n  const x0 = timeToX(segmentStart);\n  const x1 = timeToX(segmentEnd);\n  const sceneWidth = x1 - x0;\n  if (sceneWidth < 18) return;\n\n  const sceneHeight = timelineHeight();\n  const nightCenterDate = new Date(\n    (nightStart.getTime() + nightEnd.getTime()) / 2\n  );\n  const moon = predominantMoonPhaseForNight(nightCenterDate);\n\n  const maximumMoonSize = mergedNight ? 128 : 96;\n  const proportionalSize = mergedNight\n    ? sceneWidth * 0.30\n    : sceneWidth * 0.44;\n  const moonSize = Math.max(\n    16,\n    Math.min(maximumMoonSize, proportionalSize, sceneWidth - 8)\n  );\n  const dayAxisTopY = topLegendCenterY();\n  const dayAxisBottomY = localPlotBottom();\n  const dayAxisCenterY = (dayAxisTopY + dayAxisBottomY) / 2;\n  const dayAxisX = timeToX(nightCenterDate);\n  const moonX = dayAxisX - moonSize / 2;\n  // A Lua fica centrada no mesmo eixo vertical do dia: horizontalmente\n  // sobre a linha de 00:00 e verticalmente entre o centro do badge e o\n  // limite inferior visível do grid.\n  const moonY = dayAxisCenterY - moonSize / 2 + 7;\n\n  // Estrelas reais de cinco pontas ao redor do ícone.\n  const starScale = Math.max(0.55, moonSize / 96);\n  const stars = [\n    [0.18, 0.17, 6],\n    [0.81, 0.13, 5],\n    [0.24, 0.49, 4.5],\n    [0.78, 0.51, 6],\n  ];\n  for (const [relativeX, relativeY, radius] of stars) {\n    drawFivePointStar(\n      ctx,\n      x0 + sceneWidth * relativeX,\n      CANVAS.localPlotTop + 12 + (sceneHeight - 70) * relativeY,\n      radius * starScale,\n      new Color(\n        SETTINGS.nightStarColor,\n        weatherElementOpacity(0.72)\n      )\n    );\n  }\n\n  drawMoonPhase(\n    ctx,\n    moon,\n    moonX,\n    moonY,\n    moonSize,\n    nightCenterDate\n  );\n\n  // A Lua maior também recebe a condição meteorológica do horário central\n  // da noite, mantendo nuvens, chuva e demais indicativos visíveis.\n  const moonForecast = weatherForecastNearest(\n    hourlyWeather?.hours ?? [],\n    nightCenterDate.getTime()\n  );\n  drawCelestialWeatherOverlay(\n    ctx,\n    moonForecast,\n    dayAxisX,\n    moonY + moonSize / 2,\n    moonSize\n  );\n\n  // Nuvens brancas sobrepostas nas laterais, seguindo a referência visual.\n  const cloudScale = moonSize / 96;\n  const cloudWidth = 74 * cloudScale;\n  const leftCloudX = Math.max(\n    x0,\n    Math.min(x1 - cloudWidth, moonX - 27 * cloudScale)\n  );\n  const rightCloudX = Math.max(\n    x0,\n    Math.min(x1 - cloudWidth, moonX + moonSize - 42 * cloudScale)\n  );\n  drawMoonCloud(\n    ctx,\n    leftCloudX,\n    moonY + 7 * cloudScale,\n    cloudScale * 0.82\n  );\n  drawMoonCloud(\n    ctx,\n    rightCloudX,\n    moonY + moonSize - 34 * cloudScale,\n    cloudScale\n  );\n\n}\n\nfunction fillEllipseWithTimelineDayColors(ctx, rect) {\n  const centerX = rect.x + rect.width / 2;\n  const centerY = rect.y + rect.height / 2;\n  const radiusX = Math.max(0.0001, rect.width / 2);\n  const radiusY = Math.max(0.0001, rect.height / 2);\n  const startX = Math.floor(rect.x);\n  const endX = Math.ceil(rect.x + rect.width);\n  const windowDuration =\n    windowEnd.getTime() - windowStart.getTime();\n\n  // Cada coluna recebe a cor do seu próprio dia. Assim, o recorte da Lua\n  // respeita exatamente as linhas de 00:00, mesmo quando ela atravessa dias.\n  for (let x = startX; x < endX; x++) {\n    const sampleX = x + 0.5;\n    const normalizedX = (sampleX - centerX) / radiusX;\n    if (Math.abs(normalizedX) > 1) continue;\n\n    const halfHeight =\n      radiusY *\n      Math.sqrt(Math.max(0, 1 - normalizedX * normalizedX));\n    const sampleDate = new Date(\n      windowStart.getTime() +\n        (sampleX / timelineWidth()) * windowDuration\n    );\n\n    ctx.setFillColor(\n      new Color(timelineBackgroundColorForDate(sampleDate), 1.0)\n    );\n    ctx.fillRect(\n      new Rect(\n        x,\n        centerY - halfHeight,\n        1,\n        halfHeight * 2\n      )\n    );\n  }\n}\n\nfunction fillMoonLitSurface(\n  ctx,\n  x,\n  y,\n  size,\n  phase,\n  illumination\n) {\n  if (phase === \"new\" || illumination <= 0) return;\n\n  const centerX = x + size / 2;\n  const centerY = y + size / 2;\n  const radius = size / 2;\n  const isWaxing =\n    phase === \"waxing-crescent\" ||\n    phase === \"first-quarter\" ||\n    phase === \"waxing-gibbous\";\n  const isFull = phase === \"full\";\n  const normalizedIllumination = Math.max(\n    0,\n    Math.min(1, illumination)\n  );\n  const terminatorFactor = 1 - 2 * normalizedIllumination;\n\n  ctx.setFillColor(\n    new Color(\n      SETTINGS.nightMoonColor,\n      weatherElementOpacity(0.98)\n    )\n  );\n\n  for (\n    let pixelY = Math.floor(y);\n    pixelY < Math.ceil(y + size);\n    pixelY++\n  ) {\n    const sampleY = pixelY + 0.5;\n    const normalizedY = (sampleY - centerY) / radius;\n    if (Math.abs(normalizedY) > 1) continue;\n\n    const edgeX =\n      radius *\n      Math.sqrt(Math.max(0, 1 - normalizedY * normalizedY));\n    let left;\n    let right;\n\n    if (isFull) {\n      left = centerX - edgeX;\n      right = centerX + edgeX;\n    } else if (isWaxing) {\n      const terminatorX =\n        terminatorFactor * edgeX;\n      left = centerX + terminatorX;\n      right = centerX + edgeX;\n    } else {\n      const terminatorX =\n        -terminatorFactor * edgeX;\n      left = centerX - edgeX;\n      right = centerX + terminatorX;\n    }\n\n    if (right > left) {\n      ctx.fillRect(\n        new Rect(\n          left,\n          pixelY,\n          Math.max(1, right - left),\n          1\n        )\n      );\n    }\n  }\n}\n\nfunction strokeMoonEllipseOutside(\n  ctx,\n  rect,\n  color,\n  lineWidth\n) {\n  // O retângulo recebido contém os 44 px do desenho da Lua.\n  // A borda é deslocada para fora, preservando integralmente\n  // o tamanho visual do disco lunar.\n  const outset = lineWidth / 2;\n  const borderRect = new Rect(\n    rect.x - outset,\n    rect.y - outset,\n    rect.width + lineWidth,\n    rect.height + lineWidth\n  );\n  ctx.setStrokeColor(color);\n  ctx.setLineWidth(lineWidth);\n  ctx.strokeEllipse(borderRect);\n}\n\nfunction drawMoonPhase(\n  ctx,\n  moon,\n  x,\n  y,\n  size,\n  borderDate = null\n) {\n  const moonRect = new Rect(x, y, size, size);\n  const drawOuterBorder = () => {\n    const isDayBoundary =\n      borderDate instanceof Date &&\n      borderDate.getHours() === 0 &&\n      borderDate.getMinutes() === 0;\n    if (!isDayBoundary) return;\n\n    strokeMoonEllipseOutside(\n      ctx,\n      moonRect,\n      dayBoundaryLineColor(\n        borderDate,\n        loadResult.holidayDates\n      ),\n      dayBoundaryLineWidth()\n    );\n  };\n\n  // A base escura permanece visível em todas as fases, inclusive na Lua nova.\n  ctx.setFillColor(\n    new Color(\n      SETTINGS.nightMoonShadowColor,\n      weatherElementOpacity(0.98)\n    )\n  );\n  ctx.fillEllipse(moonRect);\n\n  fillMoonLitSurface(\n    ctx,\n    x,\n    y,\n    size,\n    moon.phase,\n    moon.illumination ?? (\n      moon.phase === \"full\"\n        ? 1\n        : moon.phase === \"new\"\n          ? 0\n          : 0.5\n    )\n  );\n\n  // Textura monocromática discreta em ambos os hemisférios.\n  drawMoonCraters(ctx, x, y, size, 0.34);\n  drawOuterBorder();\n}\n\nfunction drawDayBoundaryMoonBorder(\n  ctx,\n  centerX,\n  centerY,\n  size,\n  borderDate\n) {\n  const isDayBoundary =\n    borderDate instanceof Date &&\n    borderDate.getHours() === 0 &&\n    borderDate.getMinutes() === 0;\n  if (!isDayBoundary) return;\n\n  strokeMoonEllipseOutside(\n    ctx,\n    new Rect(\n      centerX - size / 2,\n      centerY - size / 2,\n      size,\n      size\n    ),\n    dayBoundaryLineColor(\n      borderDate,\n      loadResult.holidayDates\n    ),\n    dayBoundaryLineWidth()\n  );\n}\n\nfunction drawMoonCraters(ctx, x, y, size, opacity) {\n  const craters = [\n    [0.21, 0.25, 0.11],\n    [0.38, 0.18, 0.07],\n    [0.59, 0.22, 0.13],\n    [0.78, 0.31, 0.08],\n    [0.28, 0.43, 0.16],\n    [0.51, 0.42, 0.09],\n    [0.70, 0.48, 0.15],\n    [0.18, 0.65, 0.08],\n    [0.42, 0.67, 0.18],\n    [0.64, 0.69, 0.10],\n    [0.80, 0.76, 0.12],\n    [0.30, 0.84, 0.07],\n  ];\n\n  ctx.setFillColor(\n    new Color(\n      SETTINGS.nightMoonCraterColor,\n      weatherElementOpacity(opacity)\n    )\n  );\n  for (const [relativeX, relativeY, diameter] of craters) {\n    ctx.fillEllipse(\n      new Rect(\n        x + size * relativeX - (size * diameter) / 2,\n        y + size * relativeY - (size * diameter) / 2,\n        size * diameter,\n        size * diameter\n      )\n    );\n  }\n\n  // Pequenos realces dão aparência de relevo sem introduzir cores novas.\n  ctx.setFillColor(\n    new Color(\n      SETTINGS.nightMoonCraterHighlightColor,\n      weatherElementOpacity(opacity * 0.28)\n    )\n  );\n  for (const [relativeX, relativeY, diameter] of craters.slice(1, 9)) {\n    ctx.fillEllipse(\n      new Rect(\n        x + size * relativeX - size * diameter * 0.25,\n        y + size * relativeY - size * diameter * 0.25,\n        size * diameter * 0.50,\n        size * diameter * 0.50\n      )\n    );\n  }\n}\n\nfunction drawMoonCloud(ctx, x, y, scale) {\n  const width = 74 * scale;\n  const height = 35 * scale;\n\n  ctx.setFillColor(new Color(\n    SETTINGS.nightCloudColor,\n    weatherElementOpacity(0.94)\n  ));\n  ctx.fillEllipse(new Rect(x, y + 11 * scale, 43 * scale, 23 * scale));\n  ctx.fillEllipse(\n    new Rect(x + 14 * scale, y, 31 * scale, 31 * scale)\n  );\n  ctx.fillEllipse(\n    new Rect(x + 36 * scale, y + 8 * scale, 38 * scale, 26 * scale)\n  );\n  ctx.fillRect(\n    new Rect(x + 11 * scale, y + 17 * scale, 54 * scale, 17 * scale)\n  );\n\n  // Sombra interna clara para dar volume sem escurecer a nuvem.\n  ctx.setFillColor(new Color(\n    SETTINGS.nightCloudShadeColor,\n    weatherElementOpacity(0.72)\n  ));\n  ctx.fillEllipse(\n    new Rect(\n      x + width * 0.23,\n      y + height * 0.16,\n      width * 0.28,\n      height * 0.62\n    )\n  );\n}\n\nfunction drawFivePointStar(ctx, centerX, centerY, outerRadius, color) {\n  const path = new Path();\n  const innerRadius = outerRadius * 0.42;\n\n  for (let index = 0; index < 10; index++) {\n    const radius = index % 2 === 0 ? outerRadius : innerRadius;\n    const angle = -Math.PI / 2 + (index * Math.PI) / 5;\n    const point = new Point(\n      centerX + Math.cos(angle) * radius,\n      centerY + Math.sin(angle) * radius\n    );\n    if (index === 0) path.move(point);\n    else path.addLine(point);\n  }\n\n  path.closeSubpath();\n  ctx.addPath(path);\n  ctx.setFillColor(color);\n  ctx.fillPath();\n}\n\nfunction moonPhaseForDate(date) {\n  const synodicMonth = 29.530588853;\n  const knownNewMoon = Date.UTC(2000, 0, 6, 18, 14, 0);\n  const elapsedDays =\n    (date.getTime() - knownNewMoon) / 86400000;\n  const fraction =\n    ((elapsedDays / synodicMonth) % 1 + 1) % 1;\n\n  if (fraction < 0.0625 || fraction >= 0.9375) {\n    return {\n      phase: \"new\",\n      name: \"LUA NOVA\",\n      illumination: 0,\n    };\n  }\n  if (fraction < 0.1875) {\n    return {\n      phase: \"waxing-crescent\",\n      name: \"LUA CRESCENTE\",\n      illumination: 0.25,\n    };\n  }\n  if (fraction < 0.3125) {\n    return {\n      phase: \"first-quarter\",\n      name: \"QUARTO CRESCENTE\",\n      illumination: 0.5,\n    };\n  }\n  if (fraction < 0.4375) {\n    return {\n      phase: \"waxing-gibbous\",\n      name: \"LUA GIBOSA CRESCENTE\",\n      illumination: 0.75,\n    };\n  }\n  if (fraction < 0.5625) {\n    return {\n      phase: \"full\",\n      name: \"LUA CHEIA\",\n      illumination: 1,\n    };\n  }\n  if (fraction < 0.6875) {\n    return {\n      phase: \"waning-gibbous\",\n      name: \"LUA GIBOSA MINGUANTE\",\n      illumination: 0.75,\n    };\n  }\n  if (fraction < 0.8125) {\n    return {\n      phase: \"last-quarter\",\n      name: \"QUARTO MINGUANTE\",\n      illumination: 0.5,\n    };\n  }\n  return {\n    phase: \"waning-crescent\",\n    name: \"LUA MINGUANTE\",\n    illumination: 0.25,\n  };\n}\n\nfunction predominantMoonPhaseForNight(date) {\n  const dayStart = startOfDay(date);\n  const nightCenter =\n    date.getHours() < SETTINGS.nightEndHour\n      ? dateAtHour(dayStart, 0)\n      : dateAtHour(addDays(dayStart, 1), 0);\n\n  // A fase é escolhida uma única vez no centro da noite. Assim, todos os\n  // horários noturnos usam o mesmo desenho, enquanto um eclipse continua\n  // tendo prioridade no horário exato em que acontece.\n  return moonPhaseForDate(nightCenter);\n}\n\nfunction solarTimeForDate(date, isSunrise) {\n  const latitude = astronomy.latitude;\n  const longitude = astronomy.longitude;\n  const day = dayOfYear(date);\n  const longitudeHour = longitude / 15;\n  const approximateTime =\n    day + ((isSunrise ? 6 : 18) - longitudeHour) / 24;\n  const meanAnomaly = 0.9856 * approximateTime - 3.289;\n  let trueLongitude =\n    meanAnomaly +\n    1.916 * sinDegrees(meanAnomaly) +\n    0.020 * sinDegrees(2 * meanAnomaly) +\n    282.634;\n  trueLongitude = normalizeDegrees(trueLongitude);\n\n  let rightAscension = radiansToDegrees(\n    Math.atan(0.91764 * Math.tan(degreesToRadians(trueLongitude)))\n  );\n  rightAscension = normalizeDegrees(rightAscension);\n  rightAscension +=\n    Math.floor(trueLongitude / 90) * 90 -\n    Math.floor(rightAscension / 90) * 90;\n  rightAscension /= 15;\n\n  const sinDeclination = 0.39782 * sinDegrees(trueLongitude);\n  const cosDeclination = Math.cos(Math.asin(sinDeclination));\n  const zenith = 90.833;\n  const cosHourAngle =\n    (Math.cos(degreesToRadians(zenith)) -\n      sinDeclination * sinDegrees(latitude)) /\n    (cosDeclination * Math.cos(degreesToRadians(latitude)));\n\n  if (cosHourAngle > 1 || cosHourAngle < -1) return null;\n\n  let hourAngle = radiansToDegrees(Math.acos(cosHourAngle));\n  if (isSunrise) hourAngle = 360 - hourAngle;\n  hourAngle /= 15;\n\n  const localMeanTime =\n    hourAngle + rightAscension - 0.06571 * approximateTime - 6.622;\n  const universalTime = normalizeHours(localMeanTime - longitudeHour);\n  return new Date(\n    Date.UTC(date.getFullYear(), date.getMonth(), date.getDate()) +\n      universalTime * 60 * 60 * 1000\n  );\n}\n\nfunction dayOfYear(date) {\n  const currentUTC = Date.UTC(\n    date.getFullYear(),\n    date.getMonth(),\n    date.getDate()\n  );\n  const yearStartUTC = Date.UTC(date.getFullYear(), 0, 0);\n  return Math.floor((currentUTC - yearStartUTC) / 86400000);\n}\n\nfunction degreesToRadians(value) {\n  return (value * Math.PI) / 180;\n}\n\nfunction radiansToDegrees(value) {\n  return (value * 180) / Math.PI;\n}\n\nfunction sinDegrees(value) {\n  return Math.sin(degreesToRadians(value));\n}\n\nfunction normalizeDegrees(value) {\n  return ((value % 360) + 360) % 360;\n}\n\nfunction normalizeHours(value) {\n  return ((value % 24) + 24) % 24;\n}\n\nfunction drawEventHourHighlights(ctx, items) {\n  const events = prioritizedEvents(items);\n\n  // Desenha a prioridade menor primeiro. Assim, quando houver sobreposição,\n  // o evento prioritário permanece visível por cima: dia inteiro primeiro;\n  // entre os demais, prevalece o que começar antes.\n  for (const event of [...events].reverse()) {\n    const horizontalPadding = 25;\n    const startX = Math.max(\n      0,\n      timeToX(event.start) - horizontalPadding\n    );\n    const endX = Math.min(\n      timelineWidth(),\n      timeToX(event.end) + horizontalPadding\n    );\n    const width = endX - startX;\n    if (width <= 0) continue;\n\n    // Mesmo formato do badge do dia da semana: retângulo de cantos retos,\n    // na mesma posição e com a mesma altura.\n    ctx.setFillColor(new Color(event.color, 0.90));\n    ctx.fillRect(new Rect(startX, 3, Math.max(2, width), 34));\n  }\n}\n\nfunction prioritizedEvents(items) {\n  return items\n    .filter(\n      (item) =>\n        item.kind === \"event\" &&\n        !isBirthdayItem(item) &&\n        !item.isAllDay &&\n        item.end > windowStart &&\n        item.start < windowEnd\n    )\n    .sort(\n      (a, b) =>\n        a.start.getTime() - b.start.getTime() ||\n        a.end.getTime() - b.end.getTime()\n    );\n}\n\nfunction eventAtTime(date, items) {\n  const labelX = timeToX(date);\n  const horizontalPadding = 25;\n  return prioritizedEvents(items).find((event) => {\n    const eventStartX = timeToX(event.start) - horizontalPadding;\n    const eventEndX = timeToX(event.end) + horizontalPadding;\n    return labelX >= eventStartX && labelX <= eventEndX;\n  });\n}\n\nfunction hourTicks() {\n  const ticks = [];\n  const stepHours = weatherDisplayIntervalHours();\n  let tick = firstTickAtDisplayInterval(windowStart, stepHours);\n  const finalTick = ceilToHour(windowEnd);\n\n  while (tick <= finalTick) {\n    ticks.push(new Date(tick));\n    tick = new Date(\n      tick.getTime() + stepHours * 60 * 60 * 1000\n    );\n  }\n\n  return ticks;\n}\n\nfunction compactEventHourMarkers() {\n  const markers = new Set();\n  markers.add(floorToHour(windowStart).getTime());\n\n  for (const item of loadResult.items ?? []) {\n    if (\n      item.kind !== \"event\" ||\n      item.isAllDay ||\n      !item.start ||\n      !item.end\n    ) {\n      continue;\n    }\n\n    const boundaries = [item.start, item.end];\n    for (const boundary of boundaries) {\n      const marker = floorToHour(boundary);\n      if (\n        marker.getTime() >= windowStart.getTime() - 60 * 60 * 1000 &&\n        marker.getTime() <= windowEnd.getTime()\n      ) {\n        markers.add(marker.getTime());\n      }\n    }\n  }\n\n  return markers;\n}\n\nfunction dayBoundaryLineWidth() {\n  // O valor inteiro evita diferenças de rasterização entre fillRect,\n  // strokePath e strokeEllipse depois da compressão vertical do layout.\n  return DAY_BOUNDARY_LINE_WIDTH;\n}\n\nfunction hourGridLineColor(tick) {\n  return tick.getHours() === 0\n    ? dayBoundaryLineColor(tick, loadResult.holidayDates)\n    : new Color(\"#3A3A3C\", 1.0);\n}\n\nfunction daylightHourColor(tick) {\n  const hour = tick.getHours() + tick.getMinutes() / 60;\n  const strength = daylightStrengthAtHour(hour);\n  const edgeStrength = 0.28;\n  const peakProgress = Math.max(\n    0,\n    Math.min(1, (strength - edgeStrength) / (1 - edgeStrength))\n  );\n  return new Color(\n    interpolateHexColor(\n      SETTINGS.daylightEdgeColor,\n      SETTINGS.daylightPeakColor,\n      peakProgress\n    ),\n    1.0\n  );\n}\n\nfunction isSecondaryNightLegendHour(hour) {\n  // Nas janelas acima de 24 horas, os rótulos noturnos visíveis recebem\n  // o mesmo cinza para manter a leitura em uma régua de 12 em 12 horas.\n  if (!usesEvenHourCadence()) {\n    return (\n      hour >= SETTINGS.nightStartHour ||\n      hour <= SETTINGS.nightEndHour\n    );\n  }\n\n  return [2, 4, 20, 22].includes(hour);\n}\n\nfunction secondaryNightLegendColor() {\n  return new Color(SETTINGS.secondaryTextColor, 1.0);\n}\n\nfunction legendLabelWidth() {\n  // A moldura mantém a mesma dimensão em todas as janelas.\n  if (isCompactMode()) return 58;\n  if (isExtendedDetailedMode()) return 50;\n  return 58;\n}\n\nfunction legendFrameHeight() {\n  if (isCompactMode()) return scaleVertical(34);\n  if (isExtendedDetailedMode()) return scaleVertical(32);\n  return scaleVertical(38);\n}\n\nfunction legendTextHeight() {\n  if (isCompactMode()) return scaleVertical(29);\n  if (isExtendedDetailedMode()) return scaleVertical(28);\n  return scaleVertical(31);\n}\n\nfunction topLegendCenterY() {\n  // Preserva o eixo vertical anterior, agora proporcional ao painel.\n  if (isCompactMode()) return scaleVertical(18);\n  if (isExtendedDetailedMode()) return scaleVertical(17);\n  return scaleVertical(20);\n}\n\nfunction centeredLegendTextRect(centerX, centerY) {\n  const width = legendLabelWidth();\n  const height = legendTextHeight();\n  return new Rect(\n    centerX - width / 2,\n    centerY - height / 2,\n    width,\n    height\n  );\n}\n\nfunction bottomLegendTextBottomY(centerY, height = legendTextHeight()) {\n  return centerY + height / 2;\n}\n\nfunction bottomAlignedLegendTextRect(\n  centerX,\n  bottomY,\n  width,\n  height = legendTextHeight()\n) {\n  return new Rect(\n    centerX - width / 2,\n    bottomY - height,\n    width,\n    height\n  );\n}\n\n// Os badges de mudança de dia são mais largos que os rótulos numéricos.\n// Isso garante as três letras completas inclusive na janela de 36 horas.\nfunction dayLegendLabelWidth() {\n  return 64;\n}\n\nfunction legendBadgeRect(centerX, centerY) {\n  const width = legendLabelWidth();\n  const height = legendFrameHeight();\n  return new Rect(\n    centerX - width / 2,\n    centerY - height / 2,\n    width,\n    height\n  );\n}\n\nfunction dayLegendBadgeRect(centerX, centerY) {\n  const width = dayLegendLabelWidth();\n  const height = legendFrameHeight();\n  return new Rect(\n    centerX - width / 2,\n    centerY - height / 2,\n    width,\n    height\n  );\n}\n\nfunction dayLegendCircleRect(centerX, centerY) {\n  const diameter = DAY_CHANGE_CIRCLE_DIAMETER;\n  return new Rect(\n    centerX - diameter / 2,\n    centerY - diameter / 2,\n    diameter,\n    diameter\n  );\n}\n\nfunction centeredDayLegendTextRect(centerX, centerY, width, fontSize) {\n  // A caixa usa a mesma referência do círculo, mas compensa metade\n  // da descida visual causada pela redução da altura da caixa.\n  const height = fontSize;\n  const verticalCorrection =\n    (legendTextHeight() - height) / 4;\n  return new Rect(\n    centerX - width / 2,\n    centerY - height / 2 - verticalCorrection,\n    width,\n    height\n  );\n}\n\nfunction hourLegendCornerRadius() {\n  const referenceCard = titleDayCardRect(0);\n  return Math.min(\n    TITLE_CARD_OUTER_CORNER_RADIUS,\n    referenceCard.width / 2,\n    referenceCard.height / 2\n  );\n}\n\nfunction hourLegendFrameBottomY() {\n  // O limite da moldura permanece fixo enquanto a legenda sobe.\n  return CANVAS.height - WIDGET_CONTOUR.strokeInset - CANVAS.timelineTop;\n}\n\nfunction roundedFrameInsetAtY(y, topY, bottomY, radius) {\n  let inset = 0;\n  const topCenterY = topY + radius;\n  const bottomCenterY = bottomY - radius;\n\n  if (y < topCenterY) {\n    const distance = Math.max(\n      0,\n      Math.min(radius, topCenterY - y)\n    );\n    inset = Math.max(\n      inset,\n      radius -\n        Math.sqrt(\n          Math.max(0, radius * radius - distance * distance)\n        )\n    );\n  }\n\n  if (y > bottomCenterY) {\n    const distance = Math.max(\n      0,\n      Math.min(radius, y - bottomCenterY)\n    );\n    inset = Math.max(\n      inset,\n      radius -\n        Math.sqrt(\n          Math.max(0, radius * radius - distance * distance)\n        )\n    );\n  }\n\n  return inset;\n}\n\nfunction hourLegendVisibleBounds(rect) {\n  const sampleYs = [\n    rect.y,\n    rect.y + rect.height / 2,\n    rect.y + rect.height,\n  ];\n  const inset = Math.max(\n    ...sampleYs.map((sampleY) =>\n      hourLegendVisibleBoundsAtY(sampleY).inset\n    )\n  );\n\n  return {\n    left: inset,\n    right: timelineWidth() - inset,\n  };\n}\n\nfunction hourLegendVisibleBoundsAtY(y) {\n  const inset = widgetContourInsetAtY(\n    CANVAS.timelineTop + y, WIDGET_CONTOUR.strokeInset\n  );\n  return { left: inset, right: timelineWidth() - inset, inset };\n}\n\nfunction hourLegendRectIsFullyVisible(rect) {\n  const sampleYs = [\n    rect.y + 0.5,\n    rect.y + rect.height / 2,\n    rect.y + rect.height - 0.5,\n  ];\n  return sampleYs.every((sampleY) => {\n    const bounds = hourLegendVisibleBoundsAtY(sampleY);\n    return bounds.left <= rect.x &&\n      bounds.right >= rect.x + rect.width;\n  });\n}\n\nfunction drawHourLegendLabelClipped(\n  ctx,\n  label,\n  rect,\n  font,\n  textColor,\n  outputOffsetY = 0\n) {\n  if (hourLegendRectIsFullyVisible(rect)) {\n    ctx.setTextAlignedCenter();\n    ctx.setFont(font);\n    ctx.setTextColor(textColor);\n    ctx.drawTextInRect(label, new Rect(rect.x, rect.y - outputOffsetY, rect.width, rect.height));\n    return;\n  }\n\n  // Renderiza a legenda inteira em uma camada transparente e a recorta\n  // em faixas que seguem a curva na altura correspondente. Assim o\n  // caractere mantém sua posição e pode aparecer parcialmente, em vez de\n  // desaparecer por completo ou receber uma máscara retangular.\n  const sourceWidth = Math.max(1, Math.ceil(rect.width));\n  const sourceHeight = Math.max(1, Math.ceil(rect.height));\n  const textLayer = new DrawContext();\n  textLayer.size = new Size(sourceWidth, sourceHeight);\n  textLayer.opaque = false;\n  textLayer.respectScreenScale = false;\n  textLayer.setTextAlignedCenter();\n  textLayer.setFont(font);\n  textLayer.setTextColor(textColor);\n  textLayer.drawTextInRect(\n    label,\n    new Rect(0, 0, sourceWidth, sourceHeight)\n  );\n\n  const bands = [];\n  const firstPixelY = Math.floor(rect.y);\n  const lastPixelY = Math.ceil(rect.y + rect.height);\n  for (let pixelY = firstPixelY; pixelY < lastPixelY; pixelY++) {\n    const bounds = hourLegendVisibleBoundsAtY(pixelY + 0.5);\n    const visibleLeft = Math.max(rect.x, bounds.left);\n    const visibleRight = Math.min(\n      rect.x + rect.width,\n      bounds.right\n    );\n    if (visibleRight <= visibleLeft) continue;\n\n    const band = {\n      y: pixelY,\n      left: visibleLeft,\n      right: visibleRight,\n    };\n    const previous = bands[bands.length - 1];\n    if (\n      previous &&\n      previous.y + previous.height === pixelY &&\n      Math.abs(previous.left - band.left) < 0.01 &&\n      Math.abs(previous.right - band.right) < 0.01\n    ) {\n      previous.height++;\n    } else {\n      bands.push({ ...band, height: 1 });\n    }\n  }\n\n  const textImage = textLayer.getImage();\n  for (const band of bands) {\n    const image = cropTransparentCanvasImage(\n      textImage,\n      band.left - rect.x,\n      band.y - rect.y,\n      band.right - band.left,\n      band.height\n    );\n    ctx.drawImageAtPoint(\n      image,\n      new Point(band.left, band.y - outputOffsetY)\n    );\n  }\n}\n\nfunction hourLabelMetrics(ticks) {\n  const extended = isExtendedDetailedMode();\n  const frameHeight = legendFrameHeight();\n  const lineWidth = extended ? 1 : 2;\n  const gapWidth = extended ? 3 : 6;\n  const tickXs = ticks.map((tick) => timeToX(tick));\n  const tickSpacing = tickXs.length > 1\n    ? Math.min(\n        ...tickXs\n          .slice(1)\n          .map((x, index) => Math.abs(x - tickXs[index]))\n      )\n    : legendLabelWidth();\n  // A moldura não encolhe abaixo do necessário para \"12h\", \"23º\" ou \"DOM\".\n  const frameWidth = legendLabelWidth();\n\n  return {\n    frameHeight,\n    frameWidth,\n    lineWidth,\n    gapWidth,\n    tickXs,\n  };\n}\n\nfunction drawHourLabelFrames(ctx, ticks) {\n  const metrics = hourLabelMetrics(ticks);\n  const frameHeight = metrics.frameHeight;\n  const frameWidth = metrics.frameWidth;\n  const lineWidth = metrics.lineWidth;\n  const gapWidth = metrics.gapWidth;\n  const visibleTickXs = metrics.tickXs;\n\n  // Somente o pequeno intervalo entre duas horas fica vazado. O interior\n  // de cada retângulo preserva o destaque colorido do evento, quando houver.\n  for (let index = 0; index < ticks.length - 1; index++) {\n    const gapCenterX =\n      (visibleTick